<html>
<head>
    <script type="text/javascript" src="scripts/common-0.0.1.js"></script>
    <script type="text/javascript">
      var configSets = {{{configSets}}};
      var configAssignments = {{{configAssignments}}};
      var aiAdmin = {{{aiAdmin}}};   // { full, available } - endpoints, settings and the audit log come over the websocket
        
      function eventLogTab (tabOption, contentId) {
          var parent = tabOption.parentElement;
          var children = parent.querySelectorAll("button");
          for (const i in Object.values(children)) {
                children[i].className = '';
          }
          tabOption.className = 'eventLogTabActive';
          var which = tabOption.innerHTML;
          var x = Q('eventLogAdmin').querySelectorAll(".eventLogPage");
          
          if (x.length)
          for (const i in Object.values(x)) {
                x[i].style.display = 'none';
          }
          QS(contentId).display = '';
      }
      function addNewConfigSet() {
        loadConfigSet({
          id: '_new',
          name: 'New Config',
          liveLogs: 'Application,System',
          liveNum: 100,
          liveEntryTypes: [1,2,3],
          liveCategories: [],
          liveCategoriesMode: 'exclude',
          liveSources: '',
          liveSourcesMode: 'exclude',
          historyEnabled: true,
          historyLogs: 'Application,System',
          historyEntryTypes: [1,2,3],
          historyCategories: [],
          historyCategoriesMode: 'exclude',
          historySources: '',
          historySourcesMode: 'exclude',
          retentionDays: 30
        });
        let cfdd = document.querySelector('#elconfigSet');
        let newopt = `<option value="_new">New Config</option>`;
        cfdd.insertAdjacentHTML('beforeend', newopt);
        cfdd.value = '_new';
        return false;
      }
      
      function loadConfigSet(set) {
        var options = {};
        if (set == null) {
          if (configSets.length > 0) {
            configSets.forEach((s) => {
              if (s.default == true) options = s;
            });
          } else {
             options = {
              id: '',
              name: 'Default',
              liveLogs: 'Application,System',
              liveNum: 100,
              liveEntryTypes: [1,2,3],
              liveCategories: [],
              liveCategoriesMode: 'exclude',
              liveSources: '',
              liveSourcesMode: 'exclude',
              historyEnabled: true,
              historyLogs: 'Application,System',
              historyEntryTypes: [1,2,3],
              historyCategories: [],
              historyCategoriesMode: 'exclude',
              historySources: '',
              historySourcesMode: 'exclude',
              retentionDays: 30
            };
          }
        } else { // get options from config
          if (typeof set == 'object') var options = set;
        }
        renderAlertRules([]);
        elAiCfgSetValue('');
        for (var [k, v] of Object.entries(options)) {
          switch(k) {
            case 'alerts':
              renderAlertRules(Array.isArray(v) ? v : []);
            break;
            case 'aiEndpointId':
              elAiCfgSetValue(typeof v == 'string' ? v : '');
            break;
            case 'historyEnabled':
              if (v === true) {
                Q('el'+k).checked = true;
              } else {
                Q('el'+k).checked = false;
              }
            break;
            case 'liveLogs':
            case 'historyLogs':
            case 'liveSources':
            case 'historySources':
            case 'liveCategoriesMode':
            case 'historyCategoriesMode':
            case 'liveSourcesMode':
            case 'historySourcesMode':
            case 'liveNum':
            case 'retentionDays':
            case 'name':
              Q('el'+k).value = v;
            break;
            case 'id':
            case '_id':
              if (options.default == true)  Q('elid').value = '';
              else Q('elid').value = v;
            break;
            case 'liveEntryTypes':
            case 'historyEntryTypes':
              v = v.map(el => Number(el));
              Q('el'+k).querySelectorAll('option').forEach(function(opt){
                opt.selected = v.includes(Number(opt.value));
              });
            break;
            case 'liveCategories':
            case 'historyCategories':
              if (typeof v == 'string') v = v.split(',');
              v = (v || []).map(el => String(el).trim().toLowerCase());
              Q('el'+k).querySelectorAll('option').forEach(function(opt){
                opt.selected = v.includes(opt.value.toLowerCase());
              });
            break;
          }
        }
        
      }
      
      // ---- alert rules (stored in the config set as `alerts`) ----
      var elAlertLevels = [[0, 'LogAlways'], [1, 'Critical'], [2, 'Error'], [3, 'Warning'], [4, 'Info'], [5, 'Verbose']];
      function renderAlertRules(list) {
        var box = document.getElementById('elalertRules');
        if (box == null) return;
        box.innerHTML = '';
        (list || []).forEach(function(r) { addAlertRule(r); });
      }
      function addAlertRule(r) {
        r = (r && typeof r == 'object') ? r : {};
        var box = document.getElementById('elalertRules');
        var d = document.createElement('div');
        d.className = 'elAlertRule';
        d.setAttribute('data-id', (typeof r.id == 'string' && r.id != '') ? r.id : ('a' + Math.random().toString(36).slice(2, 10)));
        d.innerHTML =
          '<div><label><input type="checkbox" class="elaEnabled"> Enabled</label> &nbsp; Name <input type="text" class="elaName" style="width:260px"> ' +
          '<button class="elaRemove">Remove</button></div>' +
          '<table class="elAlertTbl">' +
          '<tr><td>Entry Types</td><td><select multiple class="elaLevels elMSel"></select> <small>none selected = any level</small></td></tr>' +
          '<tr><td>Logs</td><td><input type="text" class="elaLogs elLongTxt"> <small>comma delimited, <code>*</code> wildcards. Empty = any</small></td></tr>' +
          '<tr><td>Sources</td><td><input type="text" class="elaSources elLongTxt"> <small>comma delimited, <code>*</code> wildcards. Empty = any</small></td></tr>' +
          '<tr><td>Event IDs</td><td><input type="text" class="elaIds elLongTxt"> <small>e.g. <code>1112, 100-199</code>. Empty = any</small></td></tr>' +
          '<tr><td>Message contains</td><td><input type="text" class="elaText elLongTxt"> <small>case-insensitive text. Empty = any</small></td></tr>' +
          '<tr><td>Fire when</td><td><input type="number" min="1" class="elaThreshold" style="width:60px"> matching events occur within <input type="number" min="1" class="elaWindow" style="width:60px"> minutes</td></tr>' +
          '<tr><td>Cooldown</td><td><input type="number" min="0" class="elaCooldown" style="width:60px"> minutes before the same rule can alert again for the same device</td></tr>' +
          '</table>';
        var sel = d.querySelector('.elaLevels');
        var lv = (Array.isArray(r.levels) ? r.levels : []).map(Number);
        elAlertLevels.forEach(function(l) {
          var o = document.createElement('option'); o.value = l[0]; o.textContent = l[1]; o.selected = lv.indexOf(l[0]) != -1; sel.appendChild(o);
        });
        d.querySelector('.elaEnabled').checked = (r.enabled !== false);
        d.querySelector('.elaName').value = r.name || '';
        d.querySelector('.elaLogs').value = r.logs || '';
        d.querySelector('.elaSources').value = r.sources || '';
        d.querySelector('.elaIds').value = r.ids || '';
        d.querySelector('.elaText').value = r.text || '';
        d.querySelector('.elaThreshold').value = (Number(r.threshold) >= 1) ? Number(r.threshold) : 1;
        d.querySelector('.elaWindow').value = (Number(r.windowMin) >= 1) ? Number(r.windowMin) : 10;
        d.querySelector('.elaCooldown').value = (r.cooldownMin != null && Number(r.cooldownMin) >= 0) ? Number(r.cooldownMin) : 5;
        d.querySelector('.elaRemove').onclick = function() { box.removeChild(d); return false; };
        box.appendChild(d);
        return false;
      }
      function readAlertRules() {
        var out = [];
        document.querySelectorAll('#elalertRules .elAlertRule').forEach(function(d) {
          var cd = Number(d.querySelector('.elaCooldown').value);
          out.push({
            id: d.getAttribute('data-id'),
            enabled: d.querySelector('.elaEnabled').checked,
            name: d.querySelector('.elaName').value.trim() || 'Unnamed rule',
            levels: Array.from(d.querySelectorAll('.elaLevels option:checked')).map(function(o) { return Number(o.value); }),
            logs: d.querySelector('.elaLogs').value.trim(),
            sources: d.querySelector('.elaSources').value.trim(),
            ids: d.querySelector('.elaIds').value.trim(),
            text: d.querySelector('.elaText').value.trim(),
            threshold: Math.max(1, Math.floor(Number(d.querySelector('.elaThreshold').value)) || 1),
            windowMin: Math.max(1, Number(d.querySelector('.elaWindow').value) || 10),
            cooldownMin: (isNaN(cd) || cd < 0) ? 5 : cd
          });
        });
        return out;
      }

      var elSaveTimer = null;
      // Status line next to a button: kind '' | 'pending' | 'ok' | 'warn' | 'err'. While pending, the button
      // (optional btnId) is disabled; an 'ok' text clears itself after 15 s.
      function setStatus(elId, kind, text, btnId) {
        var el = document.getElementById(elId);
        if (el == null) return;
        el.className = 'elSaveStatus' + (kind ? ' ' + kind : '');
        el.textContent = text || '';
        if (btnId) { var btn = document.getElementById(btnId); if (btn != null) btn.disabled = (kind == 'pending'); }
        clearTimeout(el._t);
        if (kind == 'ok') el._t = setTimeout(function() { if (el.classList.contains('ok')) { el.textContent = ''; el.className = 'elSaveStatus'; } }, 15000);
      }
      function setSaveStatus(kind, text) { setStatus('elSaveStatus', kind, text, 'elSaveBtn'); }
      function saveConfig() {
        var configId = Q('elid').value;

        var x = {
          name: Q('elname').value,
          liveLogs: Q('elliveLogs').value,
          liveNum: Q('elliveNum').value,
          liveEntryTypes: Array.from(document.querySelectorAll('#elliveEntryTypes option:checked')).map(el => el.value),
          liveCategories: Array.from(document.querySelectorAll('#elliveCategories option:checked')).map(el => el.value),
          liveCategoriesMode: Q('elliveCategoriesMode').value,
          liveSources: Q('elliveSources').value,
          liveSourcesMode: Q('elliveSourcesMode').value,
          historyEnabled: (Q('elhistoryEnabled').checked) ? true : false,
          historyLogs: Q('elhistoryLogs').value,
          historyEntryTypes: Array.from(document.querySelectorAll('#elhistoryEntryTypes option:checked')).map(el => el.value),
          historyCategories: Array.from(document.querySelectorAll('#elhistoryCategories option:checked')).map(el => el.value),
          historyCategoriesMode: Q('elhistoryCategoriesMode').value,
          historySources: Q('elhistorySources').value,
          historySourcesMode: Q('elhistorySourcesMode').value,
          retentionDays: Math.max(1, Number(Q('elretentionDays').value) || 30),
          alerts: readAlertRules()
        };
        // only full administrators manage the Assistant; for everyone else the field is left out, so the stored value stays
        if (aiAdmin && aiAdmin.full && aiAdmin.available && Q('elaiEndpointId') != null) x.aiEndpointId = Q('elaiEndpointId').value;
        
        // the server answers with adminUpdateConfigSets (saved) or adminSaveFailed; the status text follows that answer
        parent.meshserver.send({ action: 'plugin', plugin: 'eventlog', pluginaction: 'adminSaveConfig', id: (configId == '') ? '_default' : configId, opts: x });
        setSaveStatus('pending', 'Saving\u2026');
        clearTimeout(elSaveTimer);
        elSaveTimer = setTimeout(function() { setSaveStatus('warn', 'No answer from the server \u2014 the save is not confirmed. Check the connection and try again.'); }, 10000);
        updateConfigSetName(configId, x.name);
        
      }
      
      function changeConfig(el) {
          if (el.value == '') loadConfigSet();
          else {
            configSets.forEach((s) => {
              if (s._id == el.value) loadConfigSet(s);
            });
          }
          let cs = document.querySelectorAll('#elconfigSet option');
          for (const i in Object.entries(cs)){
            if (cs[i].value == '_new') cs[i].parentNode.removeChild(cs[i]);
          }
      }
      
      function deleteConfig() {
        var configId = Q('elid').value;
        if (configId == '') {
          parent.setDialogMode(2, 'Cannot Delete Default', 1, null, 'The default set can only be changed, not deleted.');
          return false;
        } else if (configId == '_new') {
          let cs = document.querySelectorAll('#elconfigSet option');
          for (const i in Object.entries(cs)){
            if (cs[i].value == '_new') cs[i].parentNode.removeChild(cs[i]);
          }
          Q('elconfigSet').value = '';
          loadConfigSet();
        } else {
          parent.meshserver.send({ action: 'plugin', plugin: 'eventlog', pluginaction: 'adminDeleteConfig', id: configId });
        }
        return false;
      }
      
      function updateConfigSetName(id, name) {
        let cs = document.querySelectorAll('#elconfigSet option');
        for (const i in Object.entries(cs)){
          if (cs[i].value == id) cs[i].text = name;
        }
      }
      
      // One assignment row, built from DOM nodes: device and group names are user-entered text and must never be parsed as HTML.
      function assignRow(id, name, groupName, configName) {
        var tr = document.createElement('tr'); tr.className = 'eldataRow';
        var td1 = document.createElement('td'), lbl = document.createElement('label'), cb = document.createElement('input');
        cb.type = 'checkbox'; cb.name = 'assign[]'; cb.value = id;
        lbl.appendChild(cb); lbl.appendChild(document.createTextNode(' ' + (name == null ? '' : name)));
        td1.appendChild(lbl); tr.appendChild(td1);
        [groupName, configName].forEach(function (t) { var td = document.createElement('td'); td.textContent = (t == null || t === '') ? '\u00a0' : t; tr.appendChild(td); });
        return tr;
      }

      function updateAssignRows() {
        let dRows = document.querySelectorAll('.eldataRow');
        dRows.forEach((r) => {
            r.parentNode.removeChild(r);
        });
        var defaultConfigName = null;
        configSets.forEach((s) => {
          if (s.default === true) defaultConfigName = s.name;
        });
        var meshRowIns = document.querySelector('#elNodes');
        var nodeRowIns = document.querySelector('#assignTbl');
        for (var m in parent.meshes) { 
            var item = {
                mtype: parent.meshes[m].mtype,
                _id: parent.meshes[m]._id,
                name: parent.meshes[m].name,
                currentConfigName: 'None'
            };
            
            if (item.mtype == 2) {
                configAssignments.forEach((a) => {
                    if (a.asset == item._id) {
                      configSets.forEach((s) => {
                          if (s._id == a.configId) item.currentConfigName = s.name;
                          else if (a.configId == 'default') item.currentConfigName = defaultConfigName;
                      })
                    }
                });
                meshRowIns.parentNode.insertBefore(assignRow(item._id, item.name, '', item.currentConfigName), meshRowIns);
            }
        }
        
        parent.nodes.forEach(function(i) {
            var item = {...i, ...{
                currentConfigName: 'None'
            }};
            if (item.mtype == 2) {
                configAssignments.forEach((a) => {
                    if (a.asset == item._id) {
                      configSets.forEach((s, i) => {
                          if (s._id == a.configId) item.currentConfigName = s.name;
                          else if (a.configId == 'default') item.currentConfigName = defaultConfigName;
                      })
                    }
                });
                item.meshName = parent.meshes[item['meshid']].name;
                nodeRowIns.appendChild(assignRow(item._id, item.name, item.meshName, item.currentConfigName));
            }
        });
      }
      
      function assignSet(clear) {
          if (clear == '_clear') {
            var setId = '_clear';
          } else {
            var setId = Q('elassignSet').value;
          }
          var cboxes = document.getElementsByName("assign[]");
          var sel = [];
          
          cboxes.forEach((n) => {
              if (n.checked) sel.push(n.value);
          });
          parent.meshserver.send({ 'action': 'plugin', 'plugin': 'eventlog', 'pluginaction': 'adminAssignConfig', 'configId': setId, 'selection': sel });
      }
      
      function checkForDefault() {
        if (configSets.length == 0) {
          saveConfig();
        }
      }
      
      function updateConfigSetsSelects(sel) {
        var e1 = Q('elassignSet');
        var e2 = Q('elconfigSet');
        var e1opts = e1.querySelectorAll('option');
        var e2opts = e2.querySelectorAll('option');
        
        e1opts.forEach((o, i) => {
          if (o.value != '') {
            e1opts[i].parentNode.removeChild(e1opts[i]);
          }
        });
        e2opts.forEach((o, i) => {
          if (o.value != '') {
            e2opts[i].parentNode.removeChild(e2opts[i]);
          }
        });
        configSets.forEach(function(i) {
          if (!i.default) {
            e1.appendChild(new Option(i.name, i._id));   // Option() sets text, not HTML
            e2.appendChild(new Option(i.name, i._id));
          }
        });
        if (sel != null && sel != 'undefined') e2.value = sel;
      }
      
      parent.pluginHandler['eventlog'].adminUpdateConfigSets = function(args, msg) {
          configSets = msg.sets;
          updateConfigSetsSelects(msg.selected);
          if (msg.saved) {
              // a new set now has its real id: without this, pressing Save again would create another copy
              if (Q('elid').value == '_new' && msg.selected) Q('elid').value = msg.selected;
              clearTimeout(elSaveTimer);
              setSaveStatus('ok', '\u2713 Saved \u201c' + (msg.name || 'configuration') + '\u201d at ' + new Date().toLocaleTimeString() + '. Endpoints pick up the change within a minute.');
              if (elAiIsOn() && elAi.loaded) elAiRefresh();   // the Assistant tab's "Used by" column
          }
      }
      parent.pluginHandler['eventlog'].adminSaveFailed = function(args, msg) {
          clearTimeout(elSaveTimer);
          setSaveStatus('err', '\u2717 Not saved: ' + (msg.error || 'unknown error'));
      }
      
      parent.pluginHandler['eventlog'].adminConfigDeleted = function(args, msg) {
          configSets.forEach((s, i) => {
            if (s._id != msg.id) return;
            delete configSets[i];
          });
          let cs = document.querySelectorAll('#elconfigSet option');
          for (const i in Object.entries(cs)){
            if (cs[i].value == msg.id) cs[i].parentNode.removeChild(cs[i]);
          }
          loadConfigSet();
          updateConfigSetsSelects();
          if (elAiIsOn() && elAi.loaded) elAiRefresh();
      }
      
      parent.pluginHandler['eventlog'].setsAssigned = function(args, msg) {
          configAssignments = msg.data;
          updateAssignRows();
      }
    </script>
    <script type="text/javascript">
      // ================= Assistant (full administrators only) =================
      // Everything from the server is rendered with DOM APIs (textContent / new Option): names, addresses,
      // model ids and errors are never parsed as HTML.
      var elAi = {
        seq: 0, reqs: {}, loaded: false,
        endpoints: [], settings: null, usedBy: {}, keySource: null,
        settingsDirty: false,
        edit: null,           // endpoint form state { id, hasKey, keyHint, removeKey, caps }
        models: [],           // last Fetch models result [{id, ctx, tools}]
        audit: { skip: 0, limit: 50, total: 0, since: null, until: null },
        cfgValue: ''          // aiEndpointId of the config set in the editor
      };
      var EL_AI_PRESETS = {
        ollama: 'http://localhost:11434/v1', vllm: 'http://localhost:8000/v1', lmstudio: 'http://localhost:1234/v1',
        llamacpp: 'http://localhost:8080/v1', localai: 'http://localhost:8080/v1'
      };
      // "Server type" (one select) <-> the stored (format, preset) pair
      var EL_AI_TYPES = {
        ollama: { label: 'Ollama', format: 'openai-chat', preset: 'ollama' },
        vllm: { label: 'vLLM', format: 'openai-chat', preset: 'vllm' },
        lmstudio: { label: 'LM Studio', format: 'openai-chat', preset: 'lmstudio' },
        llamacpp: { label: 'llama.cpp', format: 'openai-chat', preset: 'llamacpp' },
        localai: { label: 'LocalAI', format: 'openai-chat', preset: 'localai' },
        custom: { label: 'Other OpenAI-compatible server', format: 'openai-chat', preset: 'custom' },
        responses: { label: 'OpenAI Responses API', format: 'openai-responses', preset: 'custom' },
        anthropic: { label: 'Anthropic Messages API', format: 'anthropic', preset: 'custom' }
      };
      function elAiTypeOf(format, preset) {
        if (format == 'openai-responses') return 'responses';
        if (format == 'anthropic') return 'anthropic';
        if (format != null && format != 'openai-chat') return null;
        return (EL_AI_PRESETS[preset] && EL_AI_TYPES[preset]) ? preset : 'custom';
      }
      function elAiTypeLabel(ep) { var t = elAiTypeOf(ep.format, ep.preset); return t ? EL_AI_TYPES[t].label : String(ep.format || ''); }
      // the (format, preset) the form sends; an endpoint of another API format keeps its stored preset (for example
      // Ollama behind the Anthropic API) while its server type is not changed
      function elAiFormKind() {
        var t = EL_AI_TYPES[Q('elAiType').value] || EL_AI_TYPES.custom, e = elAi.edit || {};
        var preset = (t.format != 'openai-chat' && e.origType === Q('elAiType').value && e.origPreset) ? e.origPreset : t.preset;
        return { format: t.format, preset: preset };
      }
      var EL_AI_REDACT = [
        ['users', 'User names'], ['hosts', 'Computer names'], ['domains', 'Domain names'], ['ips', 'IP addresses'],
        ['macs', 'MAC addresses'], ['emails', 'Email addresses'], ['sids', 'Windows SIDs'], ['paths', 'Paths that contain user names'],
        ['secrets', 'Secrets in messages (tokens, keys, passwords)'], ['serials', 'Serial numbers']
      ];
      var EL_AI_CATS = [
        ['deviceSummary', 'Device summary and hardware'], ['network', 'Network interfaces'], ['storedEvents', 'Stored event history'],
        ['meshEvents', 'MeshCentral device events'], ['notes', 'Device notes'], ['software', 'Installed software (asks the agent live; needs the Software right)']
      ];
      var EL_AI_STEPS = { resolve: 'Resolve address', connect: 'Connect', auth: 'API key accepted', model: 'Model available', tools: 'Tool calls', context: 'Context size' };

      function elAiIsOn() { return !!(aiAdmin && aiAdmin.full && aiAdmin.available); }
      function elAiFmtNum(n) { n = Number(n); return isFinite(n) ? n.toLocaleString() : ''; }
      function elAiFmtTime(t) { if (t == null || t === '') return ''; var d = new Date(t); return isNaN(d.getTime()) ? '' : d.toLocaleString(); }
      function elAiNetLabel(n) { return (n == 'loopback') ? 'This server' : (n == 'private') ? 'Local network' : (n == 'public') ? 'Cloud' : 'Unknown'; }

      // ---- requests: every reply carries the reqId it answers; replies to anything else are stale and ignored ----
      var EL_AI_LATEST_ONLY = { get: 1, audit: 1, test: 1, models: 1 };
      function elAiSend(kind, action, payload, timeoutMs, onTimeout) {
        var reqId = 'r' + (++elAi.seq) + '_' + Math.random().toString(36).slice(2, 8);
        if (EL_AI_LATEST_ONLY[kind]) Object.keys(elAi.reqs).forEach(function(k) { if (elAi.reqs[k].kind == kind) { clearTimeout(elAi.reqs[k].t); delete elAi.reqs[k]; } });
        var r = { kind: kind, t: null };
        elAi.reqs[reqId] = r;
        if (timeoutMs) r.t = setTimeout(function() {
          if (elAi.reqs[reqId] !== r) return;
          if (EL_AI_LATEST_ONLY[kind]) delete elAi.reqs[reqId];   // a late save confirmation is still welcome; a late test result is not
          try { onTimeout(); } catch (e) { }
        }, timeoutMs);
        var m = { action: 'plugin', plugin: 'eventlog', pluginaction: action, reqId: reqId };
        for (var k in payload) if (Object.prototype.hasOwnProperty.call(payload, k)) m[k] = payload[k];
        try { parent.meshserver.send(m); }
        catch (e) { clearTimeout(r.t); delete elAi.reqs[reqId]; try { onTimeout(); } catch (e2) { } return null; }
        return reqId;
      }
      function elAiTake(msg) {
        if (msg == null || typeof msg.reqId != 'string') return null;
        var r = elAi.reqs[msg.reqId];
        if (r == null) return null;
        clearTimeout(r.t); delete elAi.reqs[msg.reqId];
        return r.kind;
      }
      function elAiNoAnswer(elId, btnId, what) {
        return function() { setStatus(elId, 'warn', 'No answer from the server \u2014 ' + what + ' Check the connection and try again.', btnId); };
      }

      // ---- inline field errors ----
      function elAiClearErrors(box) {
        if (box == null) return;
        box.querySelectorAll('[aria-invalid="true"]').forEach(function(i) {
          i.removeAttribute('aria-invalid');
          var orig = i.getAttribute('data-desc');
          if (orig != null) { if (orig) i.setAttribute('aria-describedby', orig); else i.removeAttribute('aria-describedby'); i.removeAttribute('data-desc'); }
        });
        box.querySelectorAll('.elAiErr').forEach(function(e) { e.parentNode.removeChild(e); });
      }
      function elAiFieldError(input, text) {
        var id = input.id + 'Err';
        if (document.getElementById(id) != null) return;
