<html>
<head>
    <script type="text/javascript" src="scripts/common-0.0.1.js"></script>
    <script type="text/javascript">
      var configSets = {{{configSets}}};
      var configAssignments = {{{configAssignments}}};
        
      function eventLogTab (tabOption, contentId) {
          var parent = tabOption.parentElement;
          var children = parent.querySelectorAll("button");
          for (const i in Object.values(children)) {
                children[i].className = '';
          }
          tabOption.className = 'eventLogTabActive';
          var which = tabOption.innerHTML;
          var x = Q('eventLogAdmin').querySelectorAll(".eventLogPage");
          
          if (x.length)
          for (const i in Object.values(x)) {
                x[i].style.display = 'none';
          }
          QS(contentId).display = '';
      }
      function addNewConfigSet() {
        loadConfigSet({
          id: '_new',
          name: 'New Config',
          liveLogs: 'Application,System',
          liveNum: 100,
          liveEntryTypes: [2,3],
          liveCategories: [],
          liveCategoriesMode: 'exclude',
          liveSources: '',
          liveSourcesMode: 'exclude',
          historyEnabled: true,
          historyLogs: 'Application,System',
          historyEntryTypes: [2,3],
          historyCategories: [],
          historyCategoriesMode: 'exclude',
          historySources: '',
          historySourcesMode: 'exclude',
          retentionDays: 30
        });
        let cfdd = document.querySelector('#elconfigSet');
        let newopt = `<option value="_new">New Config</option>`;
        cfdd.insertAdjacentHTML('beforeend', newopt);
        cfdd.value = '_new';
        return false;
      }
      
      function loadConfigSet(set) {
        var options = {};
        if (set == null) {
          if (configSets.length > 0) {
            configSets.forEach((s) => {
              if (s.default == true) options = s;
            });
          } else {
             options = {
              id: '',
              name: 'Default',
              liveLogs: 'Application,System',
              liveNum: 100,
              liveEntryTypes: [2,3],
              liveCategories: [],
              liveCategoriesMode: 'exclude',
              liveSources: '',
              liveSourcesMode: 'exclude',
              historyEnabled: true,
              historyLogs: 'Application,System',
              historyEntryTypes: [2,3],
              historyCategories: [],
              historyCategoriesMode: 'exclude',
              historySources: '',
              historySourcesMode: 'exclude',
              retentionDays: 30
            };
          }
        } else { // get options from config
          if (typeof set == 'object') var options = set;
        }
        renderAlertRules([]);
        for (var [k, v] of Object.entries(options)) {
          switch(k) {
            case 'alerts':
              renderAlertRules(Array.isArray(v) ? v : []);
            break;
            case 'historyEnabled':
              if (v === true) {
                Q('el'+k).checked = true;
              } else {
                Q('el'+k).checked = false;
              }
            break;
            case 'liveLogs':
            case 'historyLogs':
            case 'liveSources':
            case 'historySources':
            case 'liveCategoriesMode':
            case 'historyCategoriesMode':
            case 'liveSourcesMode':
            case 'historySourcesMode':
            case 'liveNum':
            case 'retentionDays':
            case 'name':
              Q('el'+k).value = v;
            break;
            case 'id':
            case '_id':
              if (options.default == true)  Q('elid').value = '';
              else Q('elid').value = v;
            break;
            case 'liveEntryTypes':
            case 'historyEntryTypes':
              v = v.map(el => Number(el));
              Q('el'+k).querySelectorAll('option').forEach(function(opt){
                opt.selected = v.includes(Number(opt.value));
              });
            break;
            case 'liveCategories':
            case 'historyCategories':
              if (typeof v == 'string') v = v.split(',');
              v = (v || []).map(el => String(el).trim().toLowerCase());
              Q('el'+k).querySelectorAll('option').forEach(function(opt){
                opt.selected = v.includes(opt.value.toLowerCase());
              });
            break;
          }
        }
        
      }
      
      // ---- alert rules (stored in the config set as `alerts`) ----
      var elAlertLevels = [[0, 'LogAlways'], [1, 'Critical'], [2, 'Error'], [3, 'Warning'], [4, 'Info'], [5, 'Verbose']];
      function renderAlertRules(list) {
        var box = document.getElementById('elalertRules');
        if (box == null) return;
        box.innerHTML = '';
        (list || []).forEach(function(r) { addAlertRule(r); });
      }
      function addAlertRule(r) {
        r = (r && typeof r == 'object') ? r : {};
        var box = document.getElementById('elalertRules');
        var d = document.createElement('div');
        d.className = 'elAlertRule';
        d.setAttribute('data-id', (typeof r.id == 'string' && r.id != '') ? r.id : ('a' + Math.random().toString(36).slice(2, 10)));
        d.innerHTML =
          '<div><label><input type="checkbox" class="elaEnabled"> Enabled</label> &nbsp; Name <input type="text" class="elaName" style="width:260px"> ' +
          '<button class="elaRemove">Remove</button></div>' +
          '<table class="elAlertTbl">' +
          '<tr><td>Entry Types</td><td><select multiple class="elaLevels elMSel"></select> <small>none selected = any level</small></td></tr>' +
          '<tr><td>Logs</td><td><input type="text" class="elaLogs elLongTxt"> <small>comma delimited, <code>*</code> wildcards. Empty = any</small></td></tr>' +
          '<tr><td>Sources</td><td><input type="text" class="elaSources elLongTxt"> <small>comma delimited, <code>*</code> wildcards. Empty = any</small></td></tr>' +
          '<tr><td>Event IDs</td><td><input type="text" class="elaIds elLongTxt"> <small>e.g. <code>1112, 100-199</code>. Empty = any</small></td></tr>' +
          '<tr><td>Message contains</td><td><input type="text" class="elaText elLongTxt"> <small>case-insensitive text. Empty = any</small></td></tr>' +
          '<tr><td>Fire when</td><td><input type="number" min="1" class="elaThreshold" style="width:60px"> matching events occur within <input type="number" min="1" class="elaWindow" style="width:60px"> minutes</td></tr>' +
          '<tr><td>Cooldown</td><td><input type="number" min="0" class="elaCooldown" style="width:60px"> minutes before the same rule can alert again for the same device</td></tr>' +
          '</table>';
        var sel = d.querySelector('.elaLevels');
        var lv = (Array.isArray(r.levels) ? r.levels : []).map(Number);
        elAlertLevels.forEach(function(l) {
          var o = document.createElement('option'); o.value = l[0]; o.textContent = l[1]; o.selected = lv.indexOf(l[0]) != -1; sel.appendChild(o);
        });
        d.querySelector('.elaEnabled').checked = (r.enabled !== false);
        d.querySelector('.elaName').value = r.name || '';
        d.querySelector('.elaLogs').value = r.logs || '';
        d.querySelector('.elaSources').value = r.sources || '';
        d.querySelector('.elaIds').value = r.ids || '';
        d.querySelector('.elaText').value = r.text || '';
        d.querySelector('.elaThreshold').value = (Number(r.threshold) >= 1) ? Number(r.threshold) : 1;
        d.querySelector('.elaWindow').value = (Number(r.windowMin) >= 1) ? Number(r.windowMin) : 10;
        d.querySelector('.elaCooldown').value = (r.cooldownMin != null && Number(r.cooldownMin) >= 0) ? Number(r.cooldownMin) : 5;
        d.querySelector('.elaRemove').onclick = function() { box.removeChild(d); return false; };
        box.appendChild(d);
        return false;
      }
      function readAlertRules() {
        var out = [];
        document.querySelectorAll('#elalertRules .elAlertRule').forEach(function(d) {
          var cd = Number(d.querySelector('.elaCooldown').value);
          out.push({
            id: d.getAttribute('data-id'),
            enabled: d.querySelector('.elaEnabled').checked,
            name: d.querySelector('.elaName').value.trim() || 'Unnamed rule',
            levels: Array.from(d.querySelectorAll('.elaLevels option:checked')).map(function(o) { return Number(o.value); }),
            logs: d.querySelector('.elaLogs').value.trim(),
            sources: d.querySelector('.elaSources').value.trim(),
            ids: d.querySelector('.elaIds').value.trim(),
            text: d.querySelector('.elaText').value.trim(),
            threshold: Math.max(1, Math.floor(Number(d.querySelector('.elaThreshold').value)) || 1),
            windowMin: Math.max(1, Number(d.querySelector('.elaWindow').value) || 10),
            cooldownMin: (isNaN(cd) || cd < 0) ? 5 : cd
          });
        });
        return out;
      }

      var elSaveTimer = null;
      function setSaveStatus(kind, text) {
        var el = document.getElementById('elSaveStatus');
        if (el == null) return;
        el.className = 'elSaveStatus ' + kind;
        el.textContent = text;
        var btn = document.getElementById('elSaveBtn');
        if (btn != null) btn.disabled = (kind == 'pending');
        if (kind == 'ok') { clearTimeout(el._t); el._t = setTimeout(function() { if (el.className.indexOf('ok') != -1) { el.textContent = ''; el.className = 'elSaveStatus'; } }, 15000); }
      }
      function saveConfig() {
        var configId = Q('elid').value;

        var x = {
          name: Q('elname').value,
          liveLogs: Q('elliveLogs').value,
          liveNum: Q('elliveNum').value,
          liveEntryTypes: Array.from(document.querySelectorAll('#elliveEntryTypes option:checked')).map(el => el.value),
          liveCategories: Array.from(document.querySelectorAll('#elliveCategories option:checked')).map(el => el.value),
          liveCategoriesMode: Q('elliveCategoriesMode').value,
          liveSources: Q('elliveSources').value,
          liveSourcesMode: Q('elliveSourcesMode').value,
          historyEnabled: (Q('elhistoryEnabled').checked) ? true : false,
          historyLogs: Q('elhistoryLogs').value,
          historyEntryTypes: Array.from(document.querySelectorAll('#elhistoryEntryTypes option:checked')).map(el => el.value),
          historyCategories: Array.from(document.querySelectorAll('#elhistoryCategories option:checked')).map(el => el.value),
          historyCategoriesMode: Q('elhistoryCategoriesMode').value,
          historySources: Q('elhistorySources').value,
          historySourcesMode: Q('elhistorySourcesMode').value,
          retentionDays: Math.max(1, Number(Q('elretentionDays').value) || 30),
          alerts: readAlertRules()
        };
        
        // the server answers with adminUpdateConfigSets (saved) or adminSaveFailed; the status text follows that answer
        parent.meshserver.send({ action: 'plugin', plugin: 'eventlog', pluginaction: 'adminSaveConfig', id: (configId == '') ? '_default' : configId, opts: x });
        setSaveStatus('pending', 'Saving\u2026');
        clearTimeout(elSaveTimer);
        elSaveTimer = setTimeout(function() { setSaveStatus('warn', 'No answer from the server \u2014 the save is not confirmed. Check the connection and try again.'); }, 10000);
        updateConfigSetName(configId, x.name);
        
      }
      
      function changeConfig(el) {
          if (el.value == '') loadConfigSet();
          else {
            configSets.forEach((s) => {
              if (s._id == el.value) loadConfigSet(s);
            });
          }
          let cs = document.querySelectorAll('#elconfigSet option');
          for (const i in Object.entries(cs)){
            if (cs[i].value == '_new') cs[i].parentNode.removeChild(cs[i]);
          }
      }
      
      function deleteConfig() {
        var configId = Q('elid').value;
        if (configId == '') {
          parent.setDialogMode(2, 'Cannot Delete Default', 1, null, 'The default set can only be changed, not deleted.');
          return false;
        } else if (configId == '_new') {
          let cs = document.querySelectorAll('#elconfigSet option');
          for (const i in Object.entries(cs)){
            if (cs[i].value == '_new') cs[i].parentNode.removeChild(cs[i]);
          }
          Q('elconfigSet').value = '';
          loadConfigSet();
        } else {
          parent.meshserver.send({ action: 'plugin', plugin: 'eventlog', pluginaction: 'adminDeleteConfig', id: configId });
        }
        return false;
      }
      
      function updateConfigSetName(id, name) {
        let cs = document.querySelectorAll('#elconfigSet option');
        for (const i in Object.entries(cs)){
          if (cs[i].value == id) cs[i].text = name;
        }
      }
      
      function updateAssignRows() {
        let dRows = document.querySelectorAll('.eldataRow');
        dRows.forEach((r) => {
            r.parentNode.removeChild(r);
        });
        var defaultConfigName = null;
        configSets.forEach((s) => {
          if (s.default === true) defaultConfigName = s.name;
        });
        var meshRowIns = document.querySelector('#elNodes');
        var nodeRowIns = document.querySelector('#assignTbl');
        for (var m in parent.meshes) { 
            var item = {
                mtype: parent.meshes[m].mtype,
                _id: parent.meshes[m]._id,
                name: parent.meshes[m].name,
                currentConfigName: 'None'
            };
            
            if (item.mtype == 2) {
                configAssignments.forEach((a) => {
                    if (a.asset == item._id) {
                      configSets.forEach((s) => {
                          if (s._id == a.configId) item.currentConfigName = s.name;
                          else if (a.configId == 'default') item.currentConfigName = defaultConfigName;
                      })
                    }
                });
                let tpl = `<tr class="eldataRow">
                  <td><label><input type="checkbox" name="assign[]" value="${item._id}"> ${item.name}</label></td>
                  <td>&nbsp;</td>
                  <td>${item.currentConfigName}</td>
                </tr>`;
                meshRowIns.insertAdjacentHTML('beforebegin', tpl);
            }
        }
        
        parent.nodes.forEach(function(i) {
            var item = {...i, ...{
                currentConfigName: 'None'
            }};
            if (item.mtype == 2) {
                configAssignments.forEach((a) => {
                    if (a.asset == item._id) {
                      configSets.forEach((s, i) => {
                          if (s._id == a.configId) item.currentConfigName = s.name;
                          else if (a.configId == 'default') item.currentConfigName = defaultConfigName;
                      })
                    }
                });
                item.meshName = parent.meshes[item['meshid']].name;
                let tpl = `<tr class="eldataRow">
                  <td><label><input type="checkbox" name="assign[]" value="${item._id}"> ${item.name}</label></td>
                  <td>${item.meshName}</td>
                  <td>${item.currentConfigName}</td>
                </tr>`;
                nodeRowIns.insertAdjacentHTML('beforeend', tpl);
            }
        });
      }
      
      function assignSet(clear) {
          if (clear == '_clear') {
            var setId = '_clear';
          } else {
            var setId = Q('elassignSet').value;
          }
          var cboxes = document.getElementsByName("assign[]");
          var sel = [];
          
          cboxes.forEach((n) => {
              if (n.checked) sel.push(n.value);
          });
          parent.meshserver.send({ 'action': 'plugin', 'plugin': 'eventlog', 'pluginaction': 'adminAssignConfig', 'configId': setId, 'selection': sel });
      }
      
      function checkForDefault() {
        if (configSets.length == 0) {
          saveConfig();
        }
      }
      
      function updateConfigSetsSelects(sel) {
        var e1 = Q('elassignSet');
        var e2 = Q('elconfigSet');
        var e1opts = e1.querySelectorAll('option');
        var e2opts = e2.querySelectorAll('option');
        
        e1opts.forEach((o, i) => {
          if (o.value != '') {
            e1opts[i].parentNode.removeChild(e1opts[i]);
          }
        });
        e2opts.forEach((o, i) => {
          if (o.value != '') {
            e2opts[i].parentNode.removeChild(e2opts[i]);
          }
        });
        configSets.forEach(function(i) {
          let tpl = `<option value="${i._id}">${i.name}</option>`
          if (!i.default) {
            e1.insertAdjacentHTML('beforeend', tpl);
            e2.insertAdjacentHTML('beforeend', tpl);
          }
        });
        if (sel != null && sel != 'undefined') e2.value = sel;
      }
      
      parent.pluginHandler['eventlog'].adminUpdateConfigSets = function(args, msg) {
          configSets = msg.sets;
          updateConfigSetsSelects(msg.selected);
          if (msg.saved) {
              // a new set now has its real id: without this, pressing Save again would create another copy
              if (Q('elid').value == '_new' && msg.selected) Q('elid').value = msg.selected;
              clearTimeout(elSaveTimer);
              setSaveStatus('ok', '\u2713 Saved \u201c' + (msg.name || 'configuration') + '\u201d at ' + new Date().toLocaleTimeString() + '. Endpoints pick up the change within a minute.');
          }
      }
      parent.pluginHandler['eventlog'].adminSaveFailed = function(args, msg) {
          clearTimeout(elSaveTimer);
          setSaveStatus('err', '\u2717 Not saved: ' + (msg.error || 'unknown error'));
      }
      
      parent.pluginHandler['eventlog'].adminConfigDeleted = function(args, msg) {
          configSets.forEach((s, i) => {
            if (s._id != msg.id) return;
            delete configSets[i];
          });
          let cs = document.querySelectorAll('#elconfigSet option');
          for (const i in Object.entries(cs)){
            if (cs[i].value == msg.id) cs[i].parentNode.removeChild(cs[i]);
          }
          loadConfigSet();
          updateConfigSetsSelects();
      }
      
      parent.pluginHandler['eventlog'].setsAssigned = function(args, msg) {
          configAssignments = msg.data;
          updateAssignRows();
      }
    </script>
</head>
<style>
    /* Theme: same palette, buttons, inputs and text as the device page's Event Log tab.
       Night mode is mirrored from MeshCentral's own <body class="night"> (see the script at the end). */
    body {
      --evl-ink:#1c1c1c; --evl-muted:#5a6360; --evl-line:#c9c9c9; --evl-line2:#e6e6e6; --evl-bg:#fff;
      --evl-alt:#f4f6f5; --evl-hover:#e9f0f1; --evl-sel:#dbe9eb; --evl-chip:#eef1f0; --evl-input:#fff;
      --evl-acc:#1F6F78; --evl-acc-ink:#fff; --evl-ok:#1e8a4c; --evl-bline:#c9c9c9;
      margin: 0; padding: 4px 0;
      font-family: "Trebuchet MS", Arial, Helvetica, sans-serif;
      background: var(--evl-bg); color: var(--evl-ink); color-scheme: light;
    }
    body.night {
      --evl-ink:#bbbbbb; --evl-muted:#8b9591; --evl-line:#333; --evl-line2:#222; --evl-bg:#000;
      --evl-alt:#0d1110; --evl-hover:#18201f; --evl-sel:#18302f; --evl-chip:#1a1f1e; --evl-input:#111;
      --evl-acc:#5fb3bb; --evl-acc-ink:#000; --evl-ok:#3dbf7a; --evl-bline:#4a5250;
      color-scheme: dark;
    }
    #eventLogAdmin { width: 100%; box-sizing: border-box; }
    #eventLogAdmin small, #eventLogAdmin .evlLbl { color: var(--evl-muted); }
    #eventLogAdmin code { font-family: Consolas, "DejaVu Sans Mono", monospace; font-size: 12px; background: var(--evl-chip); padding: 0 4px; border-radius: 3px; }
    #eventLogAdmin a { color: var(--evl-acc); cursor: pointer; text-decoration: underline dotted; }
    #eventLogAdmin a:hover { text-decoration-style: solid; }

    /* tabs: segmented control, like the Table / Viewer switch */
    #eventLogAdminNav { display: inline-flex; margin: 2px 0 8px 12px; border: 1px solid var(--evl-bline); border-radius: 3px; overflow: hidden; background: var(--evl-input); }
    .eventLogNavClass button { float: none; border: 0; outline: none; background: var(--evl-input); color: var(--evl-muted); padding: 4px 14px; cursor: pointer; font: inherit; transition: none; }
    .eventLogNavClass button:hover:not(.eventLogTabActive) { background: var(--evl-hover); color: var(--evl-ink); }
    .eventLogNavClass button:active:not(.eventLogTabActive) { background: var(--evl-sel); }
    .eventLogNavClass button.eventLogTabActive { background: var(--evl-acc); color: var(--evl-acc-ink); font-weight: bold; }
    .eventLogNavClass button:focus-visible { outline: 2px solid var(--evl-acc); outline-offset: -2px; }
    .eventLogPage { padding: 6px 12px; border: 0; }

    /* buttons: same as the device tab's .evlBtn; the first button of each group is the primary action */
    #eventLogAdmin button:not(#eventLogAdminNav button) { border: 1px solid var(--evl-bline); background: var(--evl-input); color: var(--evl-ink); border-radius: 3px; padding: 4px 9px; cursor: pointer; font: inherit; }
    #eventLogAdmin button:not(#eventLogAdminNav button):hover { background: var(--evl-hover); border-color: var(--evl-acc); }
    #eventLogAdmin button:not(#eventLogAdminNav button):active { background: var(--evl-sel); transform: translateY(1px); }
    #eventLogAdmin button:not(#eventLogAdminNav button):focus-visible { outline: 2px solid var(--evl-acc); outline-offset: -2px; }
    #eventLogAdmin #elAssignChoice button:first-of-type, #eventLogAdmin #elConfigBtns button:first-of-type { background: var(--evl-acc); color: var(--evl-acc-ink); border-color: var(--evl-acc); }
    #eventLogAdmin #elAssignChoice button:first-of-type:hover, #eventLogAdmin #elConfigBtns button:first-of-type:hover { background: var(--evl-acc); filter: brightness(1.08); }
    .elaRemove { margin-left: 8px; }

    /* inputs */
    #eventLogAdmin input[type=text], #eventLogAdmin input[type=number], #eventLogAdmin select {
      border: 1px solid var(--evl-line); background: var(--evl-input); color: var(--evl-ink);
      border-radius: 3px; padding: 4px 6px; font: inherit; box-sizing: border-box;
    }
    #eventLogAdmin input[type=text]:focus, #eventLogAdmin input[type=number]:focus, #eventLogAdmin select:focus { outline: 2px solid var(--evl-acc); outline-offset: -1px; }
    #eventLogAdmin input[type=checkbox] { accent-color: var(--evl-acc); }
    #eventLogAdmin option { background: var(--evl-input); color: var(--evl-ink); }
    #eventLogAdmin option:checked { background: var(--evl-acc); color: var(--evl-acc-ink); }
    .elMSel { height: 122px; width: 140px; }
    .elLongTxt { width: 100%; max-width: 640px; }

    /* tables: header and row styling like the event table */
    #eventLogAdmin table { border-collapse: collapse; }
    #assignTbl { width: 100%; }
    #assignTbl th { font-size: 12px; color: var(--evl-muted); padding: 5px 8px; border-bottom: 1px solid var(--evl-line); }
    #assignTbl td { padding: 3px 8px; border-bottom: 1px solid var(--evl-line2); }
    #assignTbl tr.eldataRow:hover td { background: var(--evl-hover); }
    #editConfig > table > tbody > tr > td { padding: 6px 10px 6px 0; vertical-align: top; border-bottom: 1px solid var(--evl-line2); }
    #editConfig > table > tbody > tr > td:first-child { color: var(--evl-ink); min-width: 220px; max-width: 320px; }
    #editConfig > table > tbody > tr > td[colspan] { background: var(--evl-alt); color: var(--evl-ink); border-top: 1px solid var(--evl-line); border-bottom: 1px solid var(--evl-line); }

    .elAlertRule { border: 1px solid var(--evl-line); background: var(--evl-alt); border-radius: 4px; padding: 6px 8px; margin-bottom: 8px; }
    .elAlertTbl td { padding: 2px 8px 2px 0; vertical-align: top; border-bottom: 0; }
    #elConfigBtns { float: right; }
    .elSaveStatus { margin-right: 8px; font-size: 13px; }
    .elSaveStatus.pending { color: var(--evl-muted); }
    .elSaveStatus.ok { color: var(--evl-ok); font-weight: bold; }
    .elSaveStatus.err { color: #C9352B; font-weight: bold; }
    body.night .elSaveStatus.err { color: #ff8a7e; }
    .elSaveStatus.warn { color: #B86F00; font-weight: bold; }
    body.night .elSaveStatus.warn { color: #f0b848; }
    #eventLogAdmin button:disabled { opacity: .55; cursor: default; }
</style>
<body>
<div id="eventLogAdmin">
  <div class=eventLogNavClass id=eventLogAdminNav>
      <button class=eventLogTabActive onclick="return eventLogTab(this, 'elAssignment');">Assignment</button>
      <button onclick="return eventLogTab(this, 'elConfigSets');">Config Sets</button>
      <!-- button onclick="return eventLogTab(this, 'elPermissions');">Permissions</button -->
  </div>
  <div id="elcontent">
    <div class="eventLogPage" id="elAssignment">
          <div id="elAssignChoice">
            <span>Assign Set:</span>&nbsp;<select name="assignSet" id="elassignSet">
              <option value="">Default</default>
              
            </select>&nbsp;
            <button onclick="return assignSet();">Assign</button>
            <button onclick="return assignSet('_clear');">Clear</button>
          </div>
          <table id="assignTbl">
          <tr id="elMeshes"><th style="text-align: left;">Mesh</th><th></th><th style="text-align: right;">Current Configuration</th></tr>

          <tr id="elNodes"><th style="text-align: left;">Node</th><th>Mesh</th><th style="text-align: right;">Current Configuration</th></tr>
      </table>
    </div>
    <div class="eventLogPage" id="elConfigSets" style="display:none;">
      <select name="configSet" id="elconfigSet" onchange="return changeConfig(this);">
        <option value="">Default</default>
      </select>
      [ <a href="#" onclick="return addNewConfigSet();">+</a> ]
      <div id="editConfig">
          <table>
            <tr><td>Name</td><td><input type="text" id="elname" name="elName" value="" class="elLongTxt"></td></tr>
            <tr><td colspan="2" style="font-weight: bold; text-align:center;">Live Config</td></tr>
            <tr><td>Logs (comma delimited)<br><small>Windows event logs, e.g. Application,System,Security</small></td><td><input type="text" id="elliveLogs" name="liveLogs" class="elLongTxt"></td></tr>
            <tr><td>Categories (Linux)<br><small>journald categories. Nothing selected = no filter. Application is program output (stdout/stderr), usually the noisiest on desktops.</small></td><td>
              <select id="elliveCategoriesMode" name="liveCategoriesMode" class="elSel"><option value="include">Include selected</option><option value="exclude" selected>Exclude selected</option></select> <br>
              <select id="elliveCategories" name="liveCategories[]" multiple class="elMSel">
                <option value="System">System</option>
                <option value="Application">Application</option>
                <option value="Kernel">Kernel</option>
                <option value="Auth">Auth</option>
                <option value="Cron">Cron</option>
                <option value="Daemon">Daemon</option>
                <option value="Audit">Audit</option>
              </select></td>
            </tr>
            <tr><td>Sources<br><small>Comma delimited source / provider names, <code>*</code> matches anything, case-insensitive. Empty = no filter. Example: <code>plasmashell, kwin*</code></small></td><td><select id="elliveSourcesMode" name="liveSourcesMode" class="elSel"><option value="include">Include selected</option><option value="exclude" selected>Exclude selected</option></select> <br><input type="text" id="elliveSources" name="liveSources" class="elLongTxt"></td></tr>
            <tr><td>Default entries per log in the Live view<br><small>Users can pick 25&ndash;500 on the device tab; this is the initial value.</small></td><td><input type="text" id="elliveNum" name="liveNum"></td></tr>
            <tr><td>Entry Types</td><td>
              <select id="elliveEntryTypes" name="liveEntryTypes[]" multiple class="elMSel">
                <option value="0">LogAlways</option>
                <option value="1">Critical</option>
                <option value="2">Error</option>
                <option value="3">Warning</option>
                <option value="4">Info</option>
                <option value="5">Verbose</option>
              </select><td>
            </tr>
            <tr><td colspan="2" style="font-weight: bold; text-align:center;">History Config</td></tr>
            <tr><td>Enabled</td><td><input type="checkbox" id="elhistoryEnabled" name="historyEnabled"></td></tr>
            <tr><td>Logs (comma delimited)<br><small>Windows event logs to collect</small></td><td><input type="text" id="elhistoryLogs" name="historyLogs" class="elLongTxt"></td></tr>
            <tr><td>Categories (Linux)<br><small>journald categories to collect. Nothing selected = no filter.</small></td><td>
              <select id="elhistoryCategoriesMode" name="historyCategoriesMode" class="elSel"><option value="include">Include selected</option><option value="exclude" selected>Exclude selected</option></select> <br>
              <select id="elhistoryCategories" name="historyCategories[]" multiple class="elMSel">
                <option value="System">System</option>
                <option value="Application">Application</option>
                <option value="Kernel">Kernel</option>
                <option value="Auth">Auth</option>
                <option value="Cron">Cron</option>
                <option value="Daemon">Daemon</option>
                <option value="Audit">Audit</option>
              </select></td>
            </tr>
            <tr><td>Entry Types</td><td>
              <select id="elhistoryEntryTypes" name="historyEntryTypes[]" multiple class="elMSel">
                <option value="0">LogAlways</option>
                <option value="1">Critical</option>
                <option value="2">Error</option>
                <option value="3">Warning</option>
                <option value="4">Info</option>
                <option value="5">Verbose</option>
              </select><td>
            </tr>
            <tr><td>Sources<br><small>Comma delimited source / provider names, <code>*</code> matches anything, case-insensitive. Empty = no filter. Example: <code>plasmashell, kwin*</code>. Applied on the server when events arrive, so it works for Windows and Linux alike.</small></td><td><select id="elhistorySourcesMode" name="historySourcesMode" class="elSel"><option value="include">Include selected</option><option value="exclude" selected>Exclude selected</option></select> <br><input type="text" id="elhistorySources" name="historySources" class="elLongTxt"></td></tr>
            <tr><td>Retention (days)<br><small>How long collected events are kept. Server-wide; taken from the Default set.</small></td><td><input type="text" id="elretentionDays" name="retentionDays" value="30"></td></tr>
            <tr><td>Alerts<br><small>Raise a MeshCentral device event when incoming events match a rule. Evaluated on the server as events arrive, before the History rules above, so an event you do not store can still alert. Events older than one hour are ignored. The alert appears in the device's Events list.</small></td><td><div id="elalertRules"></div><button onclick="return addAlertRule();">Add alert rule</button></td></tr>
          <tr><td>&nbsp;</td><td><span id="elConfigBtns"><span id="elSaveStatus" class="elSaveStatus" role="status" aria-live="polite"></span> <button id="elSaveBtn" onclick="return saveConfig();">Save</button> <button onclick="return deleteConfig();">Delete</button></span></td></tr>
          </table>
          <input type="hidden" name="configId" id="elid" value="" />
      </div>
      <script type="text/javascript">
        loadConfigSet();
        checkForDefault();
        updateAssignRows();
        updateConfigSetsSelects();
      </script>
    </div>
    
    <!-- h2>Configuration Editor</h2>
    <div id="elconfigEditor"></div-->
    
    <!-- div id="elPermissions" class="eventLogPage" style="display:none;">
      Permissions here...
    </div -->
  </div>
</div>
<script type="text/javascript">
  // follow MeshCentral's light / night theme (this page is embedded in MeshCentral's own page)
  (function () {
    function sync() {
      try { document.body.classList.toggle('night', parent.document.body.classList.contains('night')); }
      catch (e) { document.body.classList.toggle('night', !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)); }
    }
    sync();
    try { new MutationObserver(sync).observe(parent.document.body, { attributes: true, attributeFilter: ['class'] }); } catch (e) { }
  })();
</script>
</body>
</html>