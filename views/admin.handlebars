        var usedText = function(e) { var s = f.sets(e); return s.length ? 'used by ' + s.join(', ') : 'not used'; };
        var flow = Q('elAiStripFlow'); flow.textContent = '';
        var zone = mk('div', 'db-zone');
        zone.appendChild(mk('span', 'db-zl', 'Your network'));
        zone.appendChild(node('', 'Devices', 'agents send events'));
        zone.appendChild(mk('div', 'db-arr'));
        var replaces = f.outUsed.length > 0 || f.rep.length > 0;
        zone.appendChild(node('', 'MeshCentral server', replaces ? 'replaces values first' : 'sends values as they are'));
        if (f.local.length) {
          var ls = mk('div', 'db-locals');
          f.local.forEach(function(e) { ls.appendChild(node('local' + (used(e) ? '' : ' idle'), e.name || '(no name)', 'Local, ' + usedText(e))); });
          zone.appendChild(ls);
        }
        flow.appendChild(zone);
        if (f.out.length) {
          flow.appendChild(mk('div', 'db-cross' + (f.outUsed.length ? '' : ' idle')));
          var outs = mk('div', 'db-out');
          f.out.forEach(function(e) { outs.appendChild(node('cloud' + (used(e) ? '' : ' idle'), e.name || '(no name)', (elAiPlace(e) == 'cloud' ? 'Cloud, ' : 'Not checked yet, ') + usedText(e))); });
          flow.appendChild(outs);
        }
        var t = Q('elAiStripText'); t.textContent = '';
        lines.forEach(function(l) {
          var p = mk('p', l[0] == 'warn' ? 'db-warn' : (l[0] == 'quiet' ? 'quiet' : null));
          if (l[0] == 'warn') { var ic = mk('span', 'db-ic'); ic.innerHTML = EL_WARN_SVG; p.appendChild(ic); }
          var body = (l[0] == 'warn') ? mk('span') : p;
          l[1].forEach(function(x) { if (Array.isArray(x)) body.appendChild(mk('b', null, x[1])); else body.appendChild(document.createTextNode(x)); });
          if (body !== p) p.appendChild(body);
          t.appendChild(p);
        });
      }

      // ---- endpoint editor: Advanced options summary ----
      function elAiAdvSummary() {
        var box = Q('elAiCollSum_adv'); if (box == null) return;
        var tm = document.querySelector('input[name="elAiToolMode"]:checked'), parts = [];
        parts.push(({ tools: 'The model reads data with tool calls.', summary: 'The model reads a summary only.' })[tm && tm.value] || 'The model reads data automatically.');
        var lim = [['elAiMaxOut', 'max output'], ['elAiTimeout', 'timeout'], ['elAiCtx', 'context']].filter(function(x) { return String(Q(x[0]).value).trim() !== ''; });
        parts.push(lim.length ? 'Limits: ' + lim.map(function(x) { return x[1] + ' ' + elAiFmtNum(Q(x[0]).value) + (x[0] == 'elAiTimeout' ? ' s' : ''); }).join(', ') + '.' : 'Limits use the defaults.');
        var gen = [['elAiThinking', 'thinking'], ['elAiTemp', 'temperature'], ['elAiTopP', 'top-p'], ['elAiTopK', 'top-k'], ['elAiSeed', 'seed']].filter(function(x) { return !Q(x[0]).disabled && String(Q(x[0]).value).trim() !== ''; });
        parts.push(gen.length ? 'Generation: ' + gen.map(function(x) { return x[1] + ' ' + Q(x[0]).value; }).join(', ') + '.' : 'Generation uses the server’s values.');
        if (Q('elAiEpExtra').value.trim() !== '') parts.push('Model-specific instructions set.');
        parts.push(Q('elAiLinkLocal').checked ? 'Link-local addresses are allowed.' : 'Link-local addresses are blocked.');
        box.textContent = parts.join(' ');
      }

      function elLayoutInit() {
        var any = function() { elBarUpdate(); };
        document.addEventListener('input', any);
        document.addEventListener('change', function(e) {
          var t = e.target;
          if (t && t.closest && (t.closest('#elSecData') || t.id == 'elAiEnabled')) elAiStripRender();
          elBarUpdate();
        });
        Q('elAiEpForm').addEventListener('input', elAiAdvSummary);
        Q('elAiEpForm').addEventListener('change', elAiAdvSummary);
        Q('elaiEndpointId').addEventListener('change', function() { elAi.cfgChosen = Q('elaiEndpointId').value; });
        Q('elAsFilter').addEventListener('input', function(e) { e.stopPropagation(); elAsFilter(); });
        ['elAsGroups', 'elAsDevices'].forEach(function(id) { Q(id + 'All').addEventListener('change', function(e) { e.stopPropagation(); elAsSelectAll(id, Q(id + 'All').checked); }); });
        Q('elBarSave').addEventListener('click', elBarSave);
        Q('elBarDiscard').addEventListener('click', elBarDiscard);
        Q('elBarSwitch').addEventListener('click', elBarSwitch);
        elNavInit();
        elBarUpdate();
      }
    </script>
</head>
<style>
    /* Theme tokens. Night mode is mirrored from MeshCentral's own <body class="night"> (see the script at the end).
       Surfaces: page < card < inset in light mode; in night mode cards sit one tone above MeshCentral's black page.
       No shadows; borders separate. Control borders keep at least 3:1 against the card. */
    body {
      --page:#eef2f3; --surface:#ffffff; --inset:#f5f8f8; --line:#d3dcde; --control:#7f9095;
      --ink:#142024; --muted:#56676c; --accent:#17808c; --accent-ink:#ffffff; --accent-soft:#e2f1f2;
      --cloud:#9a6200; --cloud-bg:#fff4dc; --local:#2e7d4f; --local-bg:#e7f4ec;
      --danger:#b42318; --danger-bg:#fdeceb; --hover:#e7eef0;
      --r-card:8px; --r-ctl:6px; --r-chip:999px;
      --font: system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", "Helvetica Neue", Arial, sans-serif;
      --mono: ui-monospace, "Cascadia Mono", "DejaVu Sans Mono", Consolas, monospace;
      margin: 0; background: var(--page); color: var(--ink); font: 14px/1.5 var(--font); color-scheme: light;
      -webkit-text-size-adjust: 100%;
    }
    body.night {
      --page:#000000; --surface:#12181a; --inset:#0a0e0f; --line:#263236; --control:#5d6d72;
      --ink:#e4ecee; --muted:#95a6ab; --accent:#5cc0cc; --accent-ink:#00191c; --accent-soft:#0e2a2d;
      --cloud:#f0b44c; --cloud-bg:#2a2110; --local:#6fcf97; --local-bg:#0f2418;
      --danger:#f0716a; --danger-bg:#2a1311; --hover:#1a2326;
      color-scheme: dark;
    }
    #eventLogAdmin, #eventLogAdmin *, #eventLogAdmin *::before, #eventLogAdmin *::after { box-sizing: border-box; }
    [hidden] { display: none !important; }
    .elSr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    #eventLogAdmin a { color: var(--accent); }
    #eventLogAdmin :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    #eventLogAdmin code, #eventLogAdmin .mono, .mono-in { font-family: var(--mono); font-size: 0.9em; }
    :where(#eventLogAdmin) p { margin: 0; }
    .db-text > p, .bar-text > p, .tnone, .elAiStatusLine, .elAiOffer p, .elAiNote, .ph-name { margin-bottom: 0; }
    @media (prefers-reduced-motion: reduce) { #eventLogAdmin *, #eventLogAdmin *::before, #eventLogAdmin *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; } }

    /* ---- shell: side navigation + content ---- */
    #eventLogAdmin { display: grid; grid-template-columns: 220px minmax(0, 1fr); min-height: 100vh; }
    .rail { position: sticky; top: 0; align-self: start; height: 100vh; overflow: auto; padding: 18px 10px; border-right: 1px solid var(--line); }
    .rail ul { list-style: none; margin: 0; padding: 0; }
    #eventLogAdmin .rail a { display: flex; align-items: center; gap: 8px; color: var(--ink); text-decoration: none; padding: 7px 12px; border-radius: var(--r-ctl); font-size: 14px; line-height: 1.4; position: relative; }
    #eventLogAdmin .rail a:hover { background: var(--hover); }
    #eventLogAdmin .rail a:focus-visible { outline-offset: -2px; }
    #eventLogAdmin .rail a.top { font-weight: 600; font-size: 15px; margin-top: 4px; }
    #eventLogAdmin .rail ul ul a { padding-left: 24px; color: var(--muted); }
    #eventLogAdmin .rail ul ul a:hover { color: var(--ink); }
    #eventLogAdmin .rail a[aria-current] { color: var(--ink); }
    #eventLogAdmin .rail a.solo[aria-current="page"] { background: var(--accent-soft); }
    .rail a[aria-current]::before { content: ""; position: absolute; left: 0; top: 7px; bottom: 7px; width: 3px; border-radius: 2px; background: var(--accent); }
    #eventLogAdmin .rail ul ul a.spy { color: var(--ink); font-weight: 600; }
    .rail ul ul a.spy::before { left: 10px; top: 50%; bottom: auto; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--cloud); margin-left: auto; flex: none; }
    .main { min-width: 0; padding: 24px 32px 0; display: flex; flex-direction: column; min-height: 100vh; }
    .col { max-width: 1100px; width: 100%; flex: 1 0 auto; padding-bottom: 32px; }
    .navsel { display: none; }

    /* ---- page heads, cards, groups ---- */
    .ph { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 10px 20px; margin: 0 0 20px; }
    .ph h1 { font-size: 20px; font-weight: 600; line-height: 1.3; margin: 0; }
    .ph h1:focus { outline: none; }
    .ph p { margin: 4px 0 0; color: var(--muted); font-size: 13px; max-width: 76ch; }
    .ph-set { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 10px; }
    .ph-set > label { font-size: 20px; font-weight: 600; line-height: 1.3; }
    #eventLogAdmin .ph-set select { font-size: 16px; font-weight: 600; min-height: 36px; min-width: 12em; }
    .ph-name { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; margin-top: 12px; }
    .ph-name label { font-weight: 500; }
    .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-card); margin: 0 0 20px; scroll-margin-top: 16px; container-type: inline-size; }
    .card-h { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 10px 16px; padding: 16px 20px 14px; border-bottom: 1px solid var(--line); }
    .card-h h2 { font-size: 18px; font-weight: 600; line-height: 1.3; margin: 0; }
    .card-h h2:focus { outline: none; }
    .card-h p { margin: 3px 0 0; font-size: 13px; color: var(--muted); max-width: 76ch; }
    .card-acts { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .card-b { padding: 4px 20px 20px; }
    .card-b.flush { padding: 0; }
    .card-pad { padding: 0 20px 20px; }
    .grp { padding-top: 22px; }
    .grp > h3, .grp-h { font-size: 15px; font-weight: 600; margin: 0 0 2px; line-height: 1.35; }
    .grp > h3 + :not(.help) { margin-top: 10px; }
    .grp > .help + * { margin-top: 12px; }
    #eventLogAdmin fieldset.grp { border: 0; margin: 0; padding: 22px 0 0; min-width: 0; }
    #eventLogAdmin fieldset.grp > legend { float: left; width: 100%; padding: 0; margin: 0 0 2px; font-size: 15px; font-weight: 600; line-height: 1.35; }
    #eventLogAdmin fieldset.grp > legend + * { clear: both; }
    .help, .elAiHelp, #eventLogAdmin small.elAiHelp { display: block; font-size: 13px; color: var(--muted); margin: 4px 0 0; max-width: 76ch; }
    .tag, .elAiTag { display: inline-block; font-size: 12px; font-weight: 500; line-height: 18px; padding: 1px 9px; border-radius: var(--r-chip); border: 1px solid var(--line); color: var(--muted); background: transparent; white-space: nowrap; vertical-align: 2px; }
    .card-h h2 .tag { margin-left: 8px; }
    .elAiTag.cloud { color: var(--cloud); background: var(--cloud-bg); border-color: transparent; }
    .elAiTag.local { color: var(--local); background: var(--local-bg); border-color: transparent; }
    .elAiTag.unknown { color: var(--muted); }
    .elAiTag.edited { color: var(--accent); border-color: var(--accent); }
    .elAiTag.changed { color: var(--cloud); background: var(--cloud-bg); border-color: transparent; white-space: normal; }
    .elAiTag.unsaved { border-style: dashed; color: var(--ink); }

    /* ---- form controls ---- */
    #eventLogAdmin input[type=text], #eventLogAdmin input[type=number], #eventLogAdmin input[type=password], #eventLogAdmin input[type=date], #eventLogAdmin input[type=search], #eventLogAdmin select, #eventLogAdmin textarea {
      font: inherit; font-size: 14px; color: var(--ink); background: var(--inset); border: 1px solid var(--control); border-radius: var(--r-ctl); padding: 6px 10px; min-height: 34px; max-width: 100%;
    }
    :where(#eventLogAdmin) :where(input, select, textarea) { margin: 0; }
    #eventLogAdmin textarea { width: 100%; display: block; resize: vertical; line-height: 1.5; }
    #eventLogAdmin input:focus-visible, #eventLogAdmin select:focus-visible, #eventLogAdmin textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    #eventLogAdmin input::placeholder, #eventLogAdmin textarea::placeholder { color: var(--muted); opacity: 1; }
    #eventLogAdmin option, #eventLogAdmin optgroup { background: var(--surface); color: var(--ink); }
    #eventLogAdmin input[type=checkbox], #eventLogAdmin input[type=radio] { accent-color: var(--accent); width: 16px; height: 16px; margin: 0; flex: none; }
    #eventLogAdmin [aria-invalid="true"] { border-color: var(--danger) !important; outline: 1px solid var(--danger); }
    #eventLogAdmin :disabled { cursor: default; }
    #eventLogAdmin input:disabled, #eventLogAdmin select:disabled { opacity: .6; cursor: not-allowed; }
    .w-s { width: 110px; } .w-m { width: 260px; } .w-l { width: 100%; max-width: 520px; }
    .ck, .elAiChecks > label, .elAiRadio { display: flex; gap: 9px; align-items: flex-start; line-height: 1.4; cursor: pointer; }
    .ck input, .elAiChecks > label input, .elAiRadio input { margin-top: 2px !important; }
    .elAiChecks { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 9px 24px; }
    .radios { display: grid; gap: 8px; }
    #eventLogAdmin input.sw { appearance: none; -webkit-appearance: none; width: 36px; height: 20px; border-radius: var(--r-chip); background: var(--inset); border: 1px solid var(--control); position: relative; cursor: pointer; transition: background .15s; }
    #eventLogAdmin input.sw::after { content: ""; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: var(--control); transition: transform .15s, background .15s; }
    #eventLogAdmin input.sw:checked { background: var(--accent); border-color: var(--accent); }
    #eventLogAdmin input.sw:checked::after { transform: translateX(16px); background: var(--accent-ink); }
    #eventLogAdmin input.sw:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .elAiCount { font-size: 12.5px; color: var(--muted); text-align: right; margin-top: 4px; font-variant-numeric: tabular-nums; }
    .elAiCount.over { color: var(--danger); font-weight: 600; }
    .elAiGrid { display: grid; grid-template-columns: minmax(180px, 250px) minmax(0, 1fr); gap: 16px 28px; align-items: start; }
    .elAiGrid > label, .elAiGrid > .elAiLbl { font-weight: 500; padding-top: 6px; }
    .elAiGrid > .elAiLbl.cb { padding-top: 0; }
    .inl { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .elAiLimits { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; }
    .elAiLimits > label { display: inline-flex; align-items: center; gap: 8px; }
    .elAiLimits > .elAiHelp { flex-basis: 100%; margin-top: 0; }
    .elAiLimits input[type=number] { width: 12.5em; }
    .elAiGen select { min-width: 12.5em; }
    .elAiGen input[type=number], .elAiGen select { font-variant-numeric: tabular-nums; }
    .elAiGenNote { color: var(--ink) !important; }

    /* ---- buttons: low-specificity base, classes for the kinds ---- */
    :where(#eventLogAdmin) button { font: inherit; font-size: 14px; line-height: 1.3; min-height: 34px; padding: 6px 14px; border-radius: var(--r-ctl); border: 1px solid var(--control); background: var(--surface); color: var(--ink); cursor: pointer; white-space: nowrap; text-transform: none; }
    :where(#eventLogAdmin) button:hover:not(:disabled) { background: var(--hover); }
    :where(#eventLogAdmin) button:disabled { opacity: .5; cursor: default; }
    :where(#eventLogAdmin) button.elPrimary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
    :where(#eventLogAdmin) button.elPrimary:hover:not(:disabled) { background: var(--accent); filter: brightness(1.08); }
    :where(#eventLogAdmin) button.elQuiet { border-color: transparent; background: transparent; color: var(--accent); padding-left: 8px; padding-right: 8px; }
    :where(#eventLogAdmin) button.elQuiet:hover:not(:disabled) { background: var(--hover); }
    :where(#eventLogAdmin) button.elDanger, :where(#eventLogAdmin) button.elAiDangerBtn { color: var(--danger); border-color: var(--danger); background: transparent; }
    :where(#eventLogAdmin) button.elDanger:hover:not(:disabled), :where(#eventLogAdmin) button.elAiDangerBtn:hover:not(:disabled) { background: var(--danger-bg); }
    :where(#eventLogAdmin) button.elQuiet.elDangerQ { color: var(--danger); }
    .btns, .elAiBtns { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 16px; }
    a.elBtnLink { display: inline-flex; align-items: center; min-height: 34px; padding: 6px 14px; border-radius: var(--r-ctl); border: 1px solid var(--control); background: var(--surface); color: var(--ink) !important; text-decoration: none; font-size: 14px; }
    a.elBtnLink:hover { background: var(--hover); }

    /* ---- status texts, notes, warnings ---- */
    .elSaveStatus { font-size: 13px; }
    .elSaveStatus.pending { color: var(--muted); }
    .elSaveStatus.ok { color: var(--local); font-weight: 600; }
    .elSaveStatus.err { color: var(--danger); font-weight: 600; }
    .elSaveStatus.warn { color: var(--cloud); font-weight: 600; }
    .elAiNote { background: var(--inset); border-radius: var(--r-ctl); padding: 12px 14px; max-width: 900px; }
    .elAiWarn { color: var(--cloud); background: var(--cloud-bg); border-radius: var(--r-ctl); padding: 8px 12px; margin: 6px 0; max-width: 760px; font-size: 13px; }
    .elAiErrBox { color: var(--danger); background: var(--danger-bg); border-radius: var(--r-ctl); padding: 8px 12px; margin: 6px 0; max-width: 760px; font-size: 13px; }
    .elAiHint { margin: 6px 0 0; font-size: 13px; color: var(--muted); }
    .elAiHint .elAiTag { margin-right: 6px; vertical-align: 0; }
    .elAiWarnTxt { display: block; color: var(--cloud); font-size: 13px; margin: 4px 0 0; max-width: 76ch; }
    .elAiErr { color: var(--danger); font-size: 13px; font-weight: 600; margin: 4px 0 0; }
    .elAiOk { color: var(--local); }
    .elAiBad { color: var(--danger); font-weight: 600; }
    .elAiSub { color: var(--muted); font-size: 13px; font-weight: normal; overflow-wrap: anywhere; }
    .elAiUnused { color: var(--muted); font-size: 13px; }
    #eventLogAdmin #elAiEpRows button.elAiLinkBtn { background: none; border: 0; border-radius: 0; padding: 0; min-height: 0; color: var(--accent); text-decoration: underline; font-size: inherit; }
    .elAiOffer { background: var(--accent-soft); border-radius: var(--r-ctl); padding: 12px 14px; margin: 16px 0 0; max-width: 760px; }
    .elAiOffer #elAiOfferT { font-weight: 600; }
    .elAiOffer .elAiBtns { margin-top: 10px; }

    /* ---- tables ---- */
    .elScroll { overflow-x: auto; max-width: 100%; }
    .elAiTbl, .tbl { width: 100%; border-collapse: collapse; font-size: 14px; }
    .elAiTbl th, .tbl th { font-size: 13px; font-weight: 600; color: var(--muted); text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; }
    .elAiTbl td, .tbl td { padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
    .elAiTbl tbody tr:last-child td, .tbl tbody tr:last-child td { border-bottom: 0; }
    .elAiTbl th:first-child, .elAiTbl td:first-child, .tbl th:first-child, .tbl td:first-child { padding-left: 20px; }
    .elAiTbl th:last-child, .elAiTbl td:last-child, .tbl th:last-child, .tbl td:last-child { padding-right: 20px; }
    .elAiTbl .elNum { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .elAiActs { white-space: nowrap; text-align: right; }
    #elAiEpTbl td:first-child { min-width: 170px; }
    #elAiEpTbl td:first-child b { white-space: nowrap; font-weight: 600; }
    #elAiEpTbl td:nth-child(2) { min-width: 130px; }
    #elAiEpTbl td:nth-child(3) { font-family: var(--mono); font-size: 13px; overflow-wrap: anywhere; min-width: 140px; }
    #elAiEpTbl td:nth-child(5) { min-width: 150px; }
    #elAiEpTbl td:nth-child(6) { white-space: nowrap; }
    #elAiAuditTbl td:not(:last-child) { white-space: nowrap; }
    .tbl .sel { width: 36px; padding-right: 0; }
    .tbl tr.chg td { background: var(--accent-soft); }
    .tbl tr.chg td:first-child { box-shadow: inset 3px 0 0 var(--accent); }
    .inh { color: var(--muted); }
    .expl { font-weight: 600; }
    .chgtag { font-size: 12px; color: var(--accent); margin-left: 8px; font-weight: 500; }
    .toolbar { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: center; padding: 14px 20px; border-bottom: 1px solid var(--line); }
    .toolbar .grow { flex: 1 1 200px; }
    #eventLogAdmin .toolbar input[type=search] { width: 100%; max-width: 280px; }
    .tsub { font-size: 15px; font-weight: 600; padding: 18px 20px 6px; margin: 0; }
    .tsub.sep { border-top: 1px solid var(--line); margin-top: 8px; }
    .tnone { padding: 6px 20px 16px; color: var(--muted); }

    /* ---- collapsible parts: a button with chevron, title and a one-line summary ---- */
    .coll { border-top: 1px solid var(--line); margin-top: 22px; }
    .coll + .coll { margin-top: 0; }
    .coll-h { margin: 0; font-size: inherit; font-weight: inherit; }
    #eventLogAdmin button.coll-btn { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 2px 8px; width: 100%; min-height: 0; padding: 14px 0; margin: 0; border: 0; border-radius: 4px; background: none; color: var(--ink); text-align: left; white-space: normal; cursor: pointer; }
    #eventLogAdmin button.coll-btn:hover { background: none; }
    #eventLogAdmin button.coll-btn:hover .coll-t { color: var(--accent); }
    .coll-btn .elAiChev { grid-row: 1 / span 2; margin-top: 4px; transition: transform .15s; color: var(--muted); }
    .coll-btn[aria-expanded="true"] .elAiChev { transform: rotate(90deg); }
    .coll-t { font-size: 15px; font-weight: 600; line-height: 1.35; }
    .coll-s { font-size: 13px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 4px 6px; align-items: center; }
    .coll-s:empty { display: none; }
    .coll-body { padding: 0 0 18px 26px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .coll-body > .elAiBtns { margin-top: 4px; }
    .epform .coll { margin-top: 18px; }

    /* ---- inset surfaces: prompt text, preview, test results ---- */
    #eventLogAdmin textarea.elAiMono { font-family: var(--mono); font-size: 12.5px; line-height: 1.55; tab-size: 4; }
    #eventLogAdmin textarea[readonly] { border-color: var(--line); }
    #eventLogAdmin textarea.elAiTpl:not([readonly]) { border-left: 4px solid var(--cloud); }
    .elAiPartTabs { display: inline-flex; flex-wrap: wrap; gap: 2px; margin: 4px 0 0; border-bottom: 1px solid var(--line); align-self: flex-start; }
    #eventLogAdmin .elAiPartTabs button { border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: transparent; color: var(--muted); padding: 6px 12px; margin-bottom: -1px; min-height: 0; }
    #eventLogAdmin .elAiPartTabs button:hover { background: var(--hover); color: var(--ink); }
    #eventLogAdmin .elAiPartTabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--accent); font-weight: 600; }
    #eventLogAdmin .elAiPartTabs button:focus-visible { outline-offset: -2px; }
    .elAiDot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--cloud); margin-left: 6px; vertical-align: middle; }
    .elAiPanel { display: flex; flex-direction: column; gap: 6px; padding-top: 8px; }
    .elAiBadges { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; min-height: 20px; }
    #eventLogAdmin .elAiBadges button.elAiMini { font-size: 12px; line-height: 16px; min-height: 0; padding: 1px 9px; border-radius: var(--r-chip); color: var(--accent); }
    .elAiPanelFoot { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; justify-content: space-between; }
    .elAiFactory { padding-top: 6px; }
    .elAiFactory label { display: block; font-size: 13px; color: var(--muted); margin-bottom: 4px; }
    .elAiSwitch { display: inline-flex; align-items: center; gap: 9px; font-weight: 500; cursor: pointer; }
    .elAiChecksList { list-style: none; margin: 0; padding: 0; }
    .elAiChecksList:empty { display: none; }
    .elAiChecksList li { margin: 4px 0; }
    .elAiLegend summary { cursor: pointer; color: var(--accent); }
    .elAiLegend dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 4px 12px; margin: 8px 0; font-size: 13px; }
    .elAiLegend dt { margin: 0; }
    .elAiLegend dd { margin: 0; color: var(--muted); }
    #eventLogAdmin textarea.elAiPrevText { min-height: 260px; background: var(--inset); border-color: var(--line); }
    .elAiTestOut { background: var(--inset); border-radius: var(--r-ctl); padding: 12px 14px; margin: 16px 0 0; }
    .elAiTestOut ul { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 4px; font-size: 13.5px; }
    .elAiTestOut .elAiLine { display: block; }
    .elAiFilters { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
    .elAiFilters > label { display: inline-flex; align-items: center; gap: 8px; }
    /* starter questions: one numbered list per device OS; each row an input with move / remove */
    .elAiStartCols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 14px 28px; }
    .elAiStartCol h4 { margin: 0 0 6px; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
    .elAiStartCol h4 .elAiTag { vertical-align: 0; }
    .elAiStartL { margin: 0; padding: 0 0 0 1.9em; display: grid; gap: 6px; }
    .elAiStartL li { color: var(--muted); font-variant-numeric: tabular-nums; }
    .elAiStartRow > * { vertical-align: middle; }
    .elAiStartRow { white-space: nowrap; }
    #eventLogAdmin input.elAiStartIn { width: calc(100% - 114px); min-width: 120px; white-space: normal; }
    #eventLogAdmin button.elAiIconBtn { padding: 0; width: 32px; min-height: 32px; margin-left: 4px; line-height: 0; color: var(--muted); }
    #eventLogAdmin button.elAiIconBtn:hover:not(:disabled) { color: var(--ink); }
    #eventLogAdmin button.elAiIconBtn.rm:hover:not(:disabled) { color: var(--danger); border-color: var(--danger); }
    .elAiStartNone { list-style: none; margin-left: -1.9em !important; font-size: 13px; }
    .elAiHistCounts { font-variant-numeric: tabular-nums; }

    /* ---- danger zone ---- */
    .danger { border: 1px solid var(--danger); border-radius: var(--r-card); padding: 14px 16px; display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; justify-content: space-between; margin-top: 24px; scroll-margin: 40px; }
    .danger h3 { font-size: 15px; font-weight: 600; margin: 0; color: var(--danger); }
    .danger p { margin: 2px 0 0; font-size: 13px; color: var(--muted); max-width: 68ch; }
    .danger p:focus { outline: none; }
    .danger.flash { outline: 3px solid var(--danger); outline-offset: 2px; }

    /* ---- data boundary strip ---- */
    .db { background: var(--inset); border-radius: var(--r-card); padding: 18px 18px 16px; margin-top: 18px; container-type: inline-size; }
    .db > h3 { margin: 0 0 12px; font-size: 15px; font-weight: 600; }
    .db-flow { display: grid; grid-template-columns: auto 64px minmax(170px, 230px); align-items: start; justify-content: start; }
    .db-zone { position: relative; border: 2px dashed var(--local); border-radius: 10px; padding: 30px 16px 16px; display: grid; grid-template-columns: minmax(120px, 170px) 44px minmax(150px, 200px); row-gap: 16px; }
    .db-zl { position: absolute; top: 7px; left: 14px; font-size: 13px; font-weight: 600; color: var(--local); }
    .db-node { min-height: 58px; border-radius: var(--r-ctl); background: var(--surface); border: 1px solid var(--line); padding: 8px 12px; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
    .db-node b { font-weight: 600; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .db-node span { font-size: 12.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .db-node.local { border-color: var(--local); }
    .db-node.local b { color: var(--local); }
    .db-node.cloud { border: 2px solid var(--cloud); background: var(--cloud-bg); }
    .db-node.cloud b, .db-node.cloud span { color: var(--cloud); }
    .db-node.idle { opacity: .72; border-style: dashed; }
    .db-node.cloud.idle { background: var(--surface); }
    .db-arr { position: relative; height: 2px; background: var(--muted); margin-top: 28px; }
    .db-arr::after { content: ""; position: absolute; right: -1px; top: -5px; border: 6px solid transparent; border-left: 8px solid var(--muted); border-right: 0; }
    .db-locals { grid-column: 3; position: relative; display: grid; gap: 10px; }
    .db-locals::before { content: ""; position: absolute; left: 50%; top: -16px; width: 2px; height: 14px; background: var(--muted); }
    .db-cross { position: relative; height: 3px; background: var(--cloud); margin-top: 58px; margin-left: -2px; }
    .db-cross::after { content: ""; position: absolute; right: -1px; top: -6px; border: 7px solid transparent; border-left: 9px solid var(--cloud); border-right: 0; }
    .db-cross.idle { background: transparent; border-top: 2px dashed var(--control); height: 0; }
    .db-cross.idle::after { display: none; }
    .db-out { margin-top: 30px; display: grid; gap: 10px; }
    .db-text { margin-top: 16px; display: grid; gap: 6px; font-size: 14px; max-width: 92ch; }
    .db-text b { font-weight: 600; }
    .db-text .quiet { color: var(--muted); }
    .db-warn { color: var(--cloud); background: var(--cloud-bg); border-radius: var(--r-ctl); padding: 8px 12px; display: flex; gap: 10px; align-items: flex-start; }
    .db-ic { flex: none; margin-top: 2px; line-height: 0; }
    @container (max-width: 760px) {
      .db-flow { grid-template-columns: 1fr; }
      .db-zone { grid-template-columns: 1fr; row-gap: 0; padding-top: 34px; }
      .db-arr { width: 2px; height: 22px; margin: 0 0 0 28px; }
      .db-arr::after { right: auto; left: -5px; top: auto; bottom: -1px; border: 6px solid transparent; border-top: 8px solid var(--muted); border-bottom: 0; }
      .db-locals { grid-column: 1; margin-top: 22px; }
      .db-locals::before { left: 28px; top: -22px; height: 20px; }
      .db-cross { width: 3px; height: 34px; margin: -2px 0 0 28px; }
      .db-cross::after { right: auto; left: -6px; top: auto; bottom: -1px; border: 7px solid transparent; border-top: 9px solid var(--cloud); border-bottom: 0; }
      .db-cross.idle { width: 0; height: 34px; border-top: 0; border-left: 2px dashed var(--control); }
      .db-out { margin-top: 0; }
    }

    /* ---- config sets: Live view and Stored history side by side ---- */
    .cmpgrid { display: grid; grid-template-columns: minmax(150px, 210px) minmax(0, 1fr) minmax(0, 1fr); }
    .cmpgrid > div { padding: 14px 16px; border-bottom: 1px solid var(--line); min-width: 0; }
    .cmpgrid > .ch { font-size: 15px; font-weight: 600; padding-top: 16px; padding-bottom: 10px; }
    .cmpgrid > .ch span { display: block; font-size: 13px; font-weight: 400; color: var(--muted); }
    .cmpgrid > .rl { font-weight: 500; padding-left: 20px; }
    .cmpgrid > .rl small { display: block; font-weight: 400; font-size: 13px; color: var(--muted); }
    .cmpgrid > .last { border-bottom: 0; }
    .cmpgrid .col-h { border-left: 1px solid var(--line); }
    #eventLogAdmin .cmpgrid input[type=text] { width: 100%; }
    .cmpgrid .lbl-sm { display: none; font-size: 12.5px; font-weight: 600; color: var(--muted); margin-bottom: 4px; }
    .cmpgrid .sub { margin-top: 8px; }
    .cmpgrid label.amt { display: block; margin-bottom: 6px; }
    .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .chip { position: relative; display: inline-flex; }
    #eventLogAdmin .chip input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
    .chip span { font-size: 13px; padding: 3px 12px; border-radius: var(--r-chip); border: 1px solid var(--control); color: var(--ink); background: var(--surface); }
    .chip input:checked + span { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
    .chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
    .chip:hover span { border-color: var(--accent); }
    @container (max-width: 760px) {
      .cmpgrid { grid-template-columns: 1fr 1fr; }
      .cmpgrid > .rl { grid-column: 1 / -1; padding-bottom: 0; border-bottom: 0; }
      .cmpgrid > .corner { display: none; }
      .cmpgrid .col-h { border-left: 0; }
    }
    @container (max-width: 560px) {
      .cmpgrid { grid-template-columns: 1fr; }
      .cmpgrid > .ch { display: none; }
      .cmpgrid > .rl { padding-top: 16px; }
      .cmpgrid .lbl-sm { display: block; }
      .cmpgrid > div { padding-left: 16px; }
    }
    /* alert rules: one summary line each; Edit opens the fields */
    .rule { border-top: 1px solid var(--line); }
    .rule:first-child { border-top: 0; }
    .rule-h { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 14px 20px; }
    .rule-h b { font-weight: 600; }
    .rule-s { color: var(--muted); font-size: 13px; flex: 1 1 260px; }
    .rule-b { padding: 4px 20px 18px; }
    .rule-b .btns { margin-top: 16px; }

    /* ---- save bar ---- */
    .savebar { position: sticky; bottom: 0; z-index: 5; max-width: 1102px; margin: 0 -1px; display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--surface); border: 1px solid var(--accent); border-left-width: 4px; border-radius: var(--r-card) var(--r-card) 0 0; }
    .savebar.rise { animation: elRise .18s ease-out; }
    .bar-text { display: grid; gap: 4px; min-width: 0; flex: 1 1 320px; }
    .bar-text b { font-weight: 600; }
    .bar-warn { color: var(--cloud); display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; }
    .bar-status { display: flex; flex-wrap: wrap; gap: 2px 14px; }
    .bar-status:not(:has(.elSaveStatus:not(:empty))) { display: none; }
    .savebar .btns { margin: 0; }
    .saved-note { position: sticky; bottom: 12px; z-index: 5; margin: 8px 0 12px auto; width: max-content; max-width: 100%; padding: 6px 14px; border-radius: var(--r-chip); background: var(--local-bg); color: var(--local); font-size: 13.5px; font-weight: 500; }
    .saved-note.warn { background: var(--cloud-bg); color: var(--cloud); }
    .saved-note:has(+ .savebar:not([hidden])) { bottom: 92px; }
    .elAiSettingsHint { color: var(--muted); font-size: 13px; }
    @keyframes elRise { from { transform: translateY(12px); opacity: 0; } to { transform: none; opacity: 1; } }

    /* ---- narrow: the rail becomes a "Go to" select ---- */
    @media (max-width: 760px) {
      #eventLogAdmin { grid-template-columns: minmax(0, 1fr); }
      .rail { display: none; }
      .navsel { display: flex; position: sticky; top: 0; z-index: 6; gap: 10px; align-items: center; padding: 10px 16px; margin: 0 -16px 16px; background: var(--page); border-bottom: 1px solid var(--line); }
      .navsel select { flex: 1; min-width: 0; }
      .navsel label { font-weight: 600; font-size: 14px; }
      .main { padding: 0 16px; }
      .col { padding-top: 0; }
      .elAiGrid { grid-template-columns: minmax(0, 1fr); gap: 6px; }
      .elAiGrid > label, .elAiGrid > .elAiLbl { padding-top: 10px; }
      .card-h { padding: 14px 16px 12px; }
      .card-b { padding: 4px 16px 16px; }
      .card-pad { padding: 0 16px 16px; }
      .card { scroll-margin-top: 72px; }
      .coll-body { padding-left: 0; }
      .w-m { width: 100%; }
      .elAiLegend dl { grid-template-columns: minmax(0, 1fr); gap: 0; }
      .elAiLegend dd { margin-bottom: 6px; }
    }
</style>
<body>
<div id="eventLogAdmin">
  <nav class="rail" id="elRail" aria-label="Event Log settings">
    <ul>
      <li><a href="#assignment" class="top solo" data-page="assignment" data-area="assign">Assignment<span class="elSr"></span><span class="dot" aria-hidden="true" hidden></span></a></li>
      <li><a href="#configsets" class="top solo" data-page="configsets" data-area="config">Config sets<span class="elSr"></span><span class="dot" aria-hidden="true" hidden></span></a></li>
      <li id="elRailAi"><a href="#assistant" class="top" data-page="assistant">Assistant</a>
        <ul id="elRailAiSubs">
          <li><a href="#elSecEndpoints" data-page="assistant" data-sec="elSecEndpoints">Endpoints</a></li>
          <li><a href="#elSecData" data-page="assistant" data-sec="elSecData" data-area="data">Data sent to the model<span class="elSr"></span><span class="dot" aria-hidden="true" hidden></span></a></li>
          <li><a href="#elSecBehaviour" data-page="assistant" data-sec="elSecBehaviour" data-area="beh">Assistant behaviour<span class="elSr"></span><span class="dot" aria-hidden="true" hidden></span></a></li>
          <li><a href="#elSecAccess" data-page="assistant" data-sec="elSecAccess" data-area="access">Access<span class="elSr"></span><span class="dot" aria-hidden="true" hidden></span></a></li>
          <li><a href="#elSecSaved" data-page="assistant" data-sec="elSecSaved" data-area="saved">Saved results<span class="elSr"></span><span class="dot" aria-hidden="true" hidden></span></a></li>
          <li><a href="#requests" class="solo" data-page="requests" data-area="req">Requests<span class="elSr"></span><span class="dot" aria-hidden="true" hidden></span></a></li>
        </ul>
      </li>
    </ul>
  </nav>

  <div class="main" id="elMain">
    <div class="navsel"><label for="elNavSel">Go to</label>
      <select id="elNavSel">
        <option value="assignment">Assignment</option>
        <option value="configsets">Config sets</option>
        <optgroup label="Assistant" id="elNavSelAi">
          <option value="assistant|elSecEndpoints">Endpoints</option>
          <option value="assistant|elSecData">Data sent to the model</option>
          <option value="assistant|elSecBehaviour">Assistant behaviour</option>
          <option value="assistant|elSecAccess">Access</option>
          <option value="assistant|elSecSaved">Saved results</option>
          <option value="requests">Requests</option>
        </optgroup>
      </select>
    </div>

    <div class="col" id="elcontent">
    <!-- ================= Assignment ================= -->
    <div class="eventLogPage" id="elAssignment" hidden>
      <div class="ph"><div><h1>Assignment</h1><p>Which config set each device group and device uses. A device without its own set uses its group&rsquo;s set; a group without one uses Default. Bold values are set here; grey ones are inherited.</p></div></div>
      <section class="card" id="elSecAssign" aria-labelledby="elSecAssignH">
        <header class="card-h"><div><h2 id="elSecAssignH">Device groups and devices</h2><p>Select rows, pick a set and choose Assign. Changes are saved with the bar at the bottom.</p></div></header>
        <div class="card-b flush">
          <div class="toolbar" id="elAssignChoice">
            <div class="grow"><label for="elAsFilter" class="elSr">Filter by name</label><input type="search" id="elAsFilter" placeholder="Filter by name" autocomplete="off"></div>
            <label for="elassignSet">Set for selected</label>
            <select name="assignSet" id="elassignSet"><option value="">Default</option></select>
            <button type="button" id="elAsAssign" onclick="return assignSet();" disabled>Assign</button>
            <button type="button" id="elAsClear" class="elQuiet" onclick="return assignSet('_clear');" disabled>Clear own set</button>
            <span class="help" style="margin:0" id="elAsCount" aria-live="polite">Select rows to change them</span>
            <span id="elAsSay" class="elSr" role="status" aria-live="polite"></span>
          </div>
          <h3 class="tsub" id="elAsGroupsH">Device groups</h3>
          <div class="elScroll"><table class="tbl" aria-labelledby="elAsGroupsH">
            <thead><tr><th class="sel" scope="col"><input type="checkbox" id="elAsGroupsAll" aria-label="Select all device groups shown"></th><th scope="col">Device group</th><th scope="col">Config set</th></tr></thead>
            <tbody id="elAsGroups"></tbody>
          </table></div>
          <p class="tnone" id="elAsGroupsNone" hidden>No device group matches the filter.</p>
          <h3 class="tsub sep" id="elAsDevicesH">Devices</h3>
          <div class="elScroll"><table class="tbl" id="assignTbl" aria-labelledby="elAsDevicesH">
            <thead><tr><th class="sel" scope="col"><input type="checkbox" id="elAsDevicesAll" aria-label="Select all devices shown"></th><th scope="col">Device</th><th scope="col">Device group</th><th scope="col">Config set</th></tr></thead>
            <tbody id="elAsDevices"></tbody>
          </table></div>
          <p class="tnone" id="elAsDevicesNone" hidden>No device matches the filter.</p>
        </div>
      </section>
    </div>

    <!-- ================= Config sets ================= -->
    <div class="eventLogPage" id="elConfigSets" hidden>
      <div class="ph"><div>
        <div class="ph-set">
          <label for="elconfigSet">Config set</label>
          <select name="configSet" id="elconfigSet" onchange="return changeConfig(this);"><option value="">Default</option></select>
          <button type="button" id="elCfgNew" onclick="return addNewConfigSet();">New set</button>
          <button type="button" id="elCfgDel" class="elQuiet elDangerQ" onclick="return elCfgDelGoto();">Delete</button>
        </div>
        <h1 class="elSr">Config sets</h1>
        <p style="margin-top:10px">A config set decides which events are collected, which alerts fire and which model answers, for every device that uses it.</p>
        <div class="ph-name"><label for="elname">Name</label><input type="text" id="elname" name="elName" value="" class="w-m" autocomplete="off"></div>
      </div></div>
      <input type="hidden" name="configId" id="elid" value="" />

      <section class="card" id="elSecCollection" aria-labelledby="elSecCollectionH">
        <header class="card-h"><div><h2 id="elSecCollectionH">Collection</h2><p>Which events the device tab shows live and which ones the server stores. Side by side, so you can see where they differ.</p></div></header>
        <div class="card-b flush">
          <div class="cmpgrid">
            <div class="ch corner"></div>
            <div class="ch col-h" id="elColLive">Live view<span>Read from the device when someone opens the tab</span></div>
            <div class="ch col-h" id="elColHist">Stored history<span>Collected on the server as events arrive</span></div>

            <div class="rl">Collect</div>
            <div class="col-h"><span class="lbl-sm">Live view</span><span class="inh">Always on</span></div>
            <div class="col-h"><span class="lbl-sm">Stored history</span><label class="ck" for="elhistoryEnabled"><input type="checkbox" role="switch" class="sw" id="elhistoryEnabled" name="historyEnabled"><span>Store events</span></label></div>

            <div class="rl" id="elRowLogs">Windows logs<small>Comma separated, for example Application, System, Security</small></div>
            <div class="col-h"><span class="lbl-sm">Live view</span><input type="text" id="elliveLogs" name="liveLogs" aria-label="Live view: Windows logs"></div>
            <div class="col-h"><span class="lbl-sm">Stored history</span><input type="text" id="elhistoryLogs" name="historyLogs" aria-label="Stored history: Windows logs"></div>

            <div class="rl" id="elRowCats">Categories (Linux, macOS)<small>journald and the macOS unified log. Cron, Daemon and Audit exist on Linux only, Install and Crash (crash reports) on macOS only. Nothing selected means no filter. Application is program output, usually the noisiest on desktops.</small></div>
            <div class="col-h"><span class="lbl-sm">Live view</span>
              <select id="elliveCategoriesMode" name="liveCategoriesMode" aria-label="Live view: categories (Linux, macOS), include or exclude"><option value="include">Include selected</option><option value="exclude" selected>Exclude selected</option></select>
              <div class="chips" id="elliveCategories" role="group" aria-label="Live view: categories (Linux, macOS)">
                <label class="chip"><input type="checkbox" value="System"><span>System</span></label><label class="chip"><input type="checkbox" value="Application"><span>Application</span></label><label class="chip"><input type="checkbox" value="Kernel"><span>Kernel</span></label><label class="chip"><input type="checkbox" value="Auth"><span>Auth</span></label><label class="chip"><input type="checkbox" value="Cron"><span>Cron</span></label><label class="chip"><input type="checkbox" value="Daemon"><span>Daemon</span></label><label class="chip"><input type="checkbox" value="Audit"><span>Audit</span></label><label class="chip"><input type="checkbox" value="Install"><span>Install</span></label><label class="chip"><input type="checkbox" value="Crash"><span>Crash</span></label>
              </div></div>
            <div class="col-h"><span class="lbl-sm">Stored history</span>
              <select id="elhistoryCategoriesMode" name="historyCategoriesMode" aria-label="Stored history: categories (Linux, macOS), include or exclude"><option value="include">Include selected</option><option value="exclude" selected>Exclude selected</option></select>
              <div class="chips" id="elhistoryCategories" role="group" aria-label="Stored history: categories (Linux, macOS)">
                <label class="chip"><input type="checkbox" value="System"><span>System</span></label><label class="chip"><input type="checkbox" value="Application"><span>Application</span></label><label class="chip"><input type="checkbox" value="Kernel"><span>Kernel</span></label><label class="chip"><input type="checkbox" value="Auth"><span>Auth</span></label><label class="chip"><input type="checkbox" value="Cron"><span>Cron</span></label><label class="chip"><input type="checkbox" value="Daemon"><span>Daemon</span></label><label class="chip"><input type="checkbox" value="Audit"><span>Audit</span></label><label class="chip"><input type="checkbox" value="Install"><span>Install</span></label><label class="chip"><input type="checkbox" value="Crash"><span>Crash</span></label>
              </div></div>

            <div class="rl" id="elRowSrc">Sources<small>Source or provider names, comma separated, case-insensitive. <code>*</code> matches anything. Empty means no filter.</small></div>
            <div class="col-h"><span class="lbl-sm">Live view</span>
              <select id="elliveSourcesMode" name="liveSourcesMode" aria-label="Live view: sources, include or exclude"><option value="include">Include</option><option value="exclude" selected>Exclude</option></select>
              <div class="sub"><input type="text" id="elliveSources" name="liveSources" class="mono-in" placeholder="plasmashell, kwin*" aria-label="Live view: sources"></div></div>
            <div class="col-h"><span class="lbl-sm">Stored history</span>
              <select id="elhistorySourcesMode" name="historySourcesMode" aria-label="Stored history: sources, include or exclude"><option value="include">Include</option><option value="exclude" selected>Exclude</option></select>
              <div class="sub"><input type="text" id="elhistorySources" name="historySources" class="mono-in" placeholder="plasmashell, kwin*" aria-label="Stored history: sources" aria-describedby="elhistorySourcesHelp"></div>
              <p class="help" id="elhistorySourcesHelp">Applied on the server as events arrive, for Windows, Linux and macOS alike.</p></div>

            <div class="rl">Entry types<small>None selected means all. macOS has no Warning level.</small></div>
            <div class="col-h"><span class="lbl-sm">Live view</span>
              <div class="chips" id="elliveEntryTypes" role="group" aria-label="Live view: entry types" style="margin-top:0">
                <label class="chip"><input type="checkbox" value="0"><span>LogAlways</span></label><label class="chip"><input type="checkbox" value="1"><span>Critical</span></label><label class="chip"><input type="checkbox" value="2"><span>Error</span></label><label class="chip"><input type="checkbox" value="3"><span>Warning</span></label><label class="chip"><input type="checkbox" value="4"><span>Info</span></label><label class="chip"><input type="checkbox" value="5"><span>Verbose</span></label>
              </div></div>
            <div class="col-h"><span class="lbl-sm">Stored history</span>
              <div class="chips" id="elhistoryEntryTypes" role="group" aria-label="Stored history: entry types" style="margin-top:0">
                <label class="chip"><input type="checkbox" value="0"><span>LogAlways</span></label><label class="chip"><input type="checkbox" value="1"><span>Critical</span></label><label class="chip"><input type="checkbox" value="2"><span>Error</span></label><label class="chip"><input type="checkbox" value="3"><span>Warning</span></label><label class="chip"><input type="checkbox" value="4"><span>Info</span></label><label class="chip"><input type="checkbox" value="5"><span>Verbose</span></label>
              </div></div>

            <div class="rl last">Amount</div>
            <div class="col-h last"><span class="lbl-sm">Live view</span><label class="amt" for="elliveNum">Entries per log at first</label><input type="number" id="elliveNum" name="liveNum" class="w-s" min="1" step="1" aria-describedby="elliveNumHelp"><p class="help" id="elliveNumHelp">Users can pick 25&ndash;500 on the device tab.</p></div>
            <div class="col-h last"><span class="lbl-sm">Stored history</span><label class="amt" for="elretentionDays">Keep for (days)</label><input type="number" id="elretentionDays" name="retentionDays" value="30" class="w-s" min="1" step="1" aria-describedby="elretentionHelp"><p class="help" id="elretentionHelp">How long stored events are kept. Server-wide; taken from the Default set.</p></div>
          </div>
        </div>
      </section>

      <section class="card" id="elSecAlerts" aria-labelledby="elSecAlertsH">
        <header class="card-h"><div><h2 id="elSecAlertsH">Alerts</h2><p>Raise a MeshCentral device event when incoming events match a rule. Checked on the server before the Stored history filter, so an event you do not store can still alert. Events older than one hour are ignored; the alert appears in the device&rsquo;s Events list.</p></div>
          <div class="card-acts"><button type="button" id="elaAddBtn" onclick="return addAlertRule(null, true);">Add alert rule</button></div></header>
        <div class="card-b flush">
          <div id="elalertRules"></div>
          <p class="tnone" id="elalertEmpty" style="padding-top:16px">No alert rules in this set.</p>
        </div>
      </section>

      <section class="card" id="elaiEndpointRow" aria-labelledby="elaiEndpointH">
        <header class="card-h"><div><h2 id="elaiEndpointH">Assistant endpoint</h2><p id="elaiEndpointHelp">The model the Assistant uses for devices with this set. None turns the Assistant off for them.</p></div></header>
        <div class="card-b">
          <div class="elAiGrid" style="margin-top:18px">
            <label for="elaiEndpointId">Endpoint</label>
            <div><select id="elaiEndpointId" aria-describedby="elaiEndpointHelp elaiEndpointMore"><option value="">None</option></select><span id="elaiEndpointRo" hidden></span>
              <p class="help" id="elaiEndpointMore">Endpoints are managed under Assistant, Endpoints.</p></div>
          </div>
        </div>
      </section>

      <div class="danger" id="elCfgDanger" role="group" aria-labelledby="elCfgDangerH">
        <div><h3 id="elCfgDangerH">Delete config set</h3><p id="elCfgDelText" tabindex="-1"></p></div>
        <button type="button" class="elDanger" id="elCfgDelBtn" onclick="return deleteConfig();">Delete</button>
      </div>
    </div>

    <!-- ================= Assistant (full administrators only) ================= -->
    <div class="eventLogPage" id="elAssistant" hidden>
      <div class="ph"><div><h1>Assistant</h1><p>Answers questions about a device&rsquo;s events with a language model. Local or self-hosted models (Ollama, vLLM, LM Studio, llama.cpp, LocalAI) keep event logs and device data on your network; a cloud model receives what you allow under Data sent to the model.</p></div></div>
      <p id="elAiNotice" class="elAiNote" hidden></p>
      <div id="elAiBody" hidden>

        <section class="card" id="elSecEndpoints" aria-labelledby="elAiEpH">
          <header class="card-h"><div><h2 id="elAiEpH">Endpoints<span class="tag">Saved separately</span></h2><p>The model servers the Assistant talks to. Each config set picks one. Endpoints are saved one at a time in their editor.</p></div>
            <div class="card-acts"><button type="button" id="elAiAddEp" onclick="return elAiOpenForm(null);">Add endpoint</button></div></header>
          <div class="card-b flush">
            <div class="elScroll">
              <table id="elAiEpTbl" class="elAiTbl" hidden>
                <caption class="elSr">Assistant endpoints</caption>
                <thead><tr><th scope="col">Name</th><th scope="col">Server type</th><th scope="col">Model</th><th scope="col">Location</th><th scope="col">Used by</th><th scope="col">Last test</th><th scope="col"><span class="elSr">Actions</span></th></tr></thead>
                <tbody id="elAiEpRows"></tbody>
              </table>
            </div>
            <div class="card-pad">
              <p id="elAiEpEmpty" class="help" style="padding-top:16px">Loading endpoints&hellip;</p>
              <div id="elAiOffer" class="elAiOffer" role="group" aria-labelledby="elAiOfferT" hidden>
                <p id="elAiOfferT"></p>
                <p class="help">You can change this later under Config sets.</p>
                <div class="elAiBtns"><button type="button" id="elAiOfferYes" class="elPrimary" onclick="return elAiOfferUse();">Use it for Default</button> <button type="button" id="elAiOfferNo" onclick="return elAiOfferDismiss();">Not now</button> <span id="elAiOfferStatus" class="elSaveStatus" role="status" aria-live="polite"></span></div>
              </div>
              <p class="elAiStatusLine"><span id="elAiEpStatus" class="elSaveStatus" role="status" aria-live="polite"></span></p>

              <section id="elAiEpForm" class="grp epform" aria-labelledby="elAiFormH" hidden>
                <h3 id="elAiFormH">Add endpoint</h3>
                <p class="help">Saved on its own with Save endpoint; the bar for unsaved changes does not include endpoints.</p>
                <div class="elAiGrid" style="margin-top:14px">
                  <label for="elAiType">Server type</label>
                  <div><select id="elAiType" aria-describedby="elAiTypeHelp" onchange="elAiTypeChanged();">
                      <optgroup label="Self-hosted servers">
                        <option value="ollama">Ollama</option><option value="vllm">vLLM</option><option value="lmstudio">LM Studio</option>
                        <option value="llamacpp">llama.cpp</option><option value="localai">LocalAI</option>
                      </optgroup>
                      <optgroup label="Other servers and APIs">
                        <option value="custom">Other OpenAI-compatible server</option><option value="responses">OpenAI Responses API</option><option value="anthropic">Anthropic Messages API</option>
                      </optgroup>
                    </select>
                    <small id="elAiTypeHelp" class="elAiHelp">How the MeshCentral server talks to the model. Pick <i>Other OpenAI-compatible server</i> for gateways such as LiteLLM or Open WebUI.</small></div>

                  <label for="elAiName">Name</label>
                  <div><input type="text" id="elAiName" class="w-m" maxlength="100" autocomplete="off" aria-required="true"></div>

                  <label for="elAiUrl">Address</label>
                  <div><input type="text" id="elAiUrl" class="w-l mono-in" inputmode="url" spellcheck="false" autocomplete="off" aria-required="true" aria-describedby="elAiUrlHint" oninput="elAiUrlChanged(); elAiModelFacts();">
                    <div id="elAiUrlHint" aria-live="polite"></div></div>

                  <label for="elAiKey">API key</label>
                  <div><input type="password" id="elAiKey" class="w-m" autocomplete="new-password" spellcheck="false" aria-describedby="elAiKeyState elAiKeyHelp" oninput="elAiKeyChanged();">
                    <button type="button" id="elAiKeyRemove" class="elQuiet" onclick="return elAiToggleRemoveKey();" hidden>Remove key</button>
                    <small id="elAiKeyState" class="elAiHelp"></small>
                    <small id="elAiKeyHelp" class="elAiHelp">Only needed if the server asks for one. Stored encrypted on the MeshCentral server and never shown again. Enter <code>env:VAR_NAME</code> to read it from an environment variable of the MeshCentral server instead.</small></div>

                  <label for="elAiModel">Model</label>
                  <div><div class="inl"><input type="text" id="elAiModel" class="w-m mono-in" list="elAiModelList" spellcheck="false" autocomplete="off" aria-describedby="elAiModelFacts" oninput="elAiModelFacts();">
                    <datalist id="elAiModelList"></datalist>
                    <button type="button" id="elAiFetchBtn" onclick="return elAiFetchModels();">Fetch models</button>
                    <span id="elAiModelsStatus" class="elSaveStatus" role="status" aria-live="polite"></span></div>
                    <div id="elAiModelFacts" class="elAiHelp" aria-live="polite"></div></div>

                  <label for="elAiNumCtx" class="elAiOllama" hidden>Ollama context (num_ctx)</label>
                  <div class="elAiOllama" hidden><input type="number" id="elAiNumCtx" class="w-m" min="1024" max="4194304" step="1" placeholder="Not set" aria-describedby="elAiNumCtxHelp" oninput="elAiLimitHints();">
                    <small id="elAiNumCtxHelp" class="elAiHelp">Ollama&rsquo;s default context can be only 4,096 tokens, too small for event logs. The Assistant sends this size with every request. A larger context needs more memory on the Ollama server.</small></div>
                </div>

                <div class="coll">
                  <h4 class="coll-h"><button type="button" class="coll-btn" id="elAiColl_adv" aria-expanded="false" aria-controls="elAiAdvBody"><svg class="elAiChev" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="coll-t" id="elAiAdvT">Advanced options</span><span class="coll-s" id="elAiCollSum_adv"></span></button></h4>
                  <div id="elAiAdvBody" class="coll-body" data-coll="adv" hidden>
                    <div class="elAiGrid">
                      <span class="elAiLbl" id="elAiToolModeL">How the model reads data</span>
                      <div class="radios" role="radiogroup" aria-labelledby="elAiToolModeL" aria-describedby="elAiToolModeHelp">
                        <label class="elAiRadio"><input type="radio" name="elAiToolMode" value="auto" checked> Automatic</label>
                        <label class="elAiRadio"><input type="radio" name="elAiToolMode" value="tools"> Tool calls</label>
                        <label class="elAiRadio"><input type="radio" name="elAiToolMode" value="summary"> Summary only</label>
                        <small id="elAiToolModeHelp" class="elAiHelp">Tool calls: the model asks for the data it needs, step by step; this needs a model that supports tool calls. Summary only: the server prepares one summary of the device and its events and sends it with the question; this works with any model, but answers can only use what is in the summary. Automatic uses tool calls when the model supports them, otherwise summary only.</small></div>

                      <span class="elAiLbl">Limits</span>
                      <div class="elAiLimits">
                        <label>Max output tokens <input type="number" id="elAiMaxOut" min="64" max="128000" step="1" placeholder="2,048 (default)" aria-describedby="elAiCtxHelp"></label>
                        <label>Timeout (s) <input type="number" id="elAiTimeout" min="10" max="900" step="1" placeholder="120 (default)" aria-describedby="elAiCtxHelp"></label>
                        <label>Context tokens <input type="number" id="elAiCtx" min="1024" max="4194304" step="1" placeholder="Detected when tested" aria-describedby="elAiCtxHelp" oninput="elAiLimitHints();"></label>
                        <small id="elAiCtxHelp" class="elAiHelp">Leave empty to use the value shown. Max output is at most half the context. Timeout is per request to the model.</small></div>

                      <span class="elAiLbl" id="elAiGenL">Generation</span>
                      <div class="elAiLimits elAiGen" role="group" aria-labelledby="elAiGenL">
                        <label>Thinking <select id="elAiThinking" aria-describedby="elAiGenHelp elAiGenNote">
                            <option value="">Server default</option><option value="off">Off</option><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option>
                          </select></label>
                        <label>Temperature <input type="number" id="elAiTemp" min="0" max="2" step="0.05" placeholder="server default" aria-describedby="elAiGenHelp elAiGenNote"></label>
                        <label>Top-p <input type="number" id="elAiTopP" min="0" max="1" step="0.01" placeholder="server default" aria-describedby="elAiGenHelp elAiGenNote"></label>
                        <label>Top-k <input type="number" id="elAiTopK" min="1" max="1000" step="1" placeholder="server default" aria-describedby="elAiGenHelp elAiGenNote"></label>
                        <label>Seed <input type="number" id="elAiSeed" min="0" max="2147483647" step="1" placeholder="server default" aria-describedby="elAiGenHelp elAiGenNote"></label>
                        <small id="elAiGenNote" class="elAiHelp elAiGenNote" hidden></small>
                        <small id="elAiGenHelp" class="elAiHelp">Leave empty to use the server&rsquo;s default, shown in the field when the server reports it. Only the settings you fill in are sent. Test connection checks that the server accepts them.</small></div>

                      <label for="elAiEpExtra">Model-specific instructions</label>
                      <div><textarea id="elAiEpExtra" class="elAiMono" rows="3" maxlength="4000" aria-describedby="elAiEpExtraHelp elAiEpExtraCount" placeholder="For example: /no_think"></textarea>
                        <div class="elAiCount" id="elAiEpExtraCount"></div>
                        <small id="elAiEpExtraHelp" class="elAiHelp">Added for this endpoint only, e.g. switches a model needs.</small></div>

                      <span class="elAiLbl cb">Link-local addresses</span>
                      <div><label class="ck"><input type="checkbox" id="elAiLinkLocal" aria-describedby="elAiLinkLocalHelp" onchange="elAiUrlChanged();"><span>Allow link-local addresses</span></label>
                        <small id="elAiLinkLocalHelp" class="elAiHelp">Off by default. Link-local and cloud metadata addresses (169.254.x.x, fe80::) are blocked to protect this server. Turn this on only if your model server really uses such an address.</small></div>
                    </div>
                  </div>
                </div>
                <div id="elAiTestOut" class="elAiTestOut" aria-live="polite" hidden></div>
                <div class="elAiBtns">
                  <button type="button" id="elAiSaveEpBtn" class="elPrimary" onclick="return elAiSaveEndpoint();">Save endpoint</button>
                  <button type="button" id="elAiTestBtn" onclick="return elAiTest();">Test connection</button>
                  <button type="button" class="elQuiet" onclick="return elAiCloseForm();">Cancel</button>
                  <span id="elAiFormStatus" class="elSaveStatus" role="status" aria-live="polite"></span>
                </div>
              </section>
            </div>
          </div>
        </section>

        <section class="card" id="elSecData" aria-labelledby="elAiDataH">
          <header class="card-h"><div><h2 id="elAiDataH">Data sent to the model</h2><p>What the Assistant may read from a device, what is replaced, and who sees it before it leaves.</p></div></header>
          <div class="card-b" id="elAiDataBody">
            <div class="db" id="elAiStrip" role="group" aria-labelledby="elAiStripH">
              <h3 id="elAiStripH">Where the data goes</h3>
              <div class="db-flow" id="elAiStripFlow" aria-hidden="true"></div>
              <div class="db-text" id="elAiStripText" aria-live="polite"></div>
            </div>
            <fieldset class="grp"><legend>Replace before sending</legend>
              <p class="help" id="elAiRedactHelp">Always on for endpoints outside your network, whatever is ticked here; for endpoints on your network it is your choice. Replaced values are restored in the answer. Replacement is best effort.</p>
              <div id="elAiRedact" class="elAiChecks"></div>
            </fieldset>
            <fieldset class="grp"><legend>What the model may read</legend>
              <div id="elAiCats" class="elAiChecks" style="margin-top:10px"></div>
            </fieldset>
            <fieldset class="grp"><legend>Before sending to an endpoint outside your network</legend>
              <div class="radios" style="margin-top:10px">
                <label class="elAiRadio"><input type="radio" name="elAiPreview" value="every"> Show the preview every time</label>
                <label class="elAiRadio"><input type="radio" name="elAiPreview" value="once"> Show it once per user and endpoint</label>
                <label class="elAiRadio"><input type="radio" name="elAiPreview" value="never"> Do not show it</label>
              </div>
            </fieldset>
          </div>
        </section>

        <section class="card" id="elSecBehaviour" aria-labelledby="elAiBehH">
          <header class="card-h"><div><h2 id="elAiBehH">Assistant behaviour</h2><p>How the Assistant answers: your instructions, the built-in prompt and the questions it suggests.</p></div></header>
          <div class="card-b">
            <div class="grp">
              <h3><label for="elAiExtra">Additional instructions</label></h3>
              <p id="elAiExtraHelp" class="help">Added after the built-in instructions for every question. Use it for context (your environment, language, tone, preferred tools). It cannot switch off the safety rules.</p>
              <textarea id="elAiExtra" rows="3" maxlength="4000" spellcheck="true" aria-describedby="elAiExtraHelp elAiExtraCount" placeholder="For example: Our clients run Windows 11 with Microsoft Intune. Answer in German."></textarea>
              <div class="elAiCount" id="elAiExtraCount"></div>
            </div>

            <div class="coll" id="elAiPromptFs">
              <h3 class="coll-h"><button type="button" class="coll-btn" id="elAiColl_prompt" aria-expanded="false" aria-controls="elAiPromptBody"><svg class="elAiChev" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="coll-t" id="elAiPromptT">System prompt</span><span class="coll-s" id="elAiCollSum_prompt"></span></button></h3>
              <div id="elAiPromptBody" class="coll-body" data-coll="prompt" hidden>
                <p class="help" id="elAiPromptHelp" style="margin-top:0">The built-in instructions the model gets before every question: shared base instructions, then the part for the kind of question. Values in <code>&#123;&#123;&hellip;&#125;&#125;</code> are filled in for each request.</p>
                <div><label class="elAiSwitch"><input type="checkbox" role="switch" class="sw" id="elAiPromptEdit" aria-describedby="elAiPromptWarn"> Edit the system prompt</label></div>
                <p id="elAiPromptWarn" class="elAiWarn" hidden>Changes affect every answer. The trust rules protect against instructions hidden in event logs; the output blocks are what the Diagnosis, Explain and follow-up views read.</p>
                <div id="elAiPartTabs" class="elAiPartTabs" role="tablist" aria-label="System prompt parts"></div>
                <div id="elAiPartPanels"></div>
                <ul id="elAiPromptChecks" class="elAiChecksList" aria-live="polite"></ul>
                <div class="elAiBtns"><button type="button" id="elAiResetAll" disabled>Reset all to factory defaults</button></div>
                <details class="elAiLegend">
                  <summary>Placeholders</summary>
                  <p class="help">A line that holds only a placeholder is left out when the placeholder is empty. Unknown placeholders are sent as they are.</p>
                  <dl id="elAiPhList"></dl>
                </details>
              </div>
            </div>

            <div class="coll" id="elAiStartFs">
              <h3 class="coll-h"><button type="button" class="coll-btn" id="elAiColl_starters" aria-expanded="false" aria-controls="elAiStartBody"><svg class="elAiChev" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="coll-t" id="elAiStartT">Starter questions</span><span class="coll-s" id="elAiCollSum_starters"></span></button></h3>
              <div id="elAiStartBody" class="coll-body" data-coll="starters" hidden>
                <p class="help" id="elAiStartHelp" style="margin-top:0">The example questions an empty Ask panel offers, one list per device type. Devices whose system is not known get the Windows list; Android devices have no event logs and get none. Up to 12 questions of at most 200 characters each; the order here is the order of the buttons.</p>
                <div class="elAiStartCols">
                  <section class="elAiStartCol" aria-labelledby="elAiStartH_windows"><h4 id="elAiStartH_windows">Windows devices <span id="elAiStartTag_windows"></span></h4>
                    <ol id="elAiStart_windows" class="elAiStartL"></ol>
                    <div class="elAiBtns"><button type="button" id="elAiStartAdd_windows">Add a question</button><button type="button" class="elQuiet" id="elAiStartReset_windows">Reset to factory defaults</button><span class="elAiCount" id="elAiStartCount_windows" style="margin:0"></span></div>
                  </section>
                  <section class="elAiStartCol" aria-labelledby="elAiStartH_linux"><h4 id="elAiStartH_linux">Linux devices <span id="elAiStartTag_linux"></span></h4>
                    <ol id="elAiStart_linux" class="elAiStartL"></ol>
                    <div class="elAiBtns"><button type="button" id="elAiStartAdd_linux">Add a question</button><button type="button" class="elQuiet" id="elAiStartReset_linux">Reset to factory defaults</button><span class="elAiCount" id="elAiStartCount_linux" style="margin:0"></span></div>
                  </section>
                  <section class="elAiStartCol" aria-labelledby="elAiStartH_macos"><h4 id="elAiStartH_macos">macOS devices <span id="elAiStartTag_macos"></span></h4>
                    <ol id="elAiStart_macos" class="elAiStartL"></ol>
                    <div class="elAiBtns"><button type="button" id="elAiStartAdd_macos">Add a question</button><button type="button" class="elQuiet" id="elAiStartReset_macos">Reset to factory defaults</button><span class="elAiCount" id="elAiStartCount_macos" style="margin:0"></span></div>
                  </section>
                </div>
              </div>
              <span id="elAiStartSay" class="elSr" role="status" aria-live="polite"></span>
            </div>

            <div class="coll" id="elAiPrevFs">
              <h3 class="coll-h"><button type="button" class="coll-btn" id="elAiColl_preview" aria-expanded="false" aria-controls="elAiPrevBody"><svg class="elAiChev" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="coll-t" id="elAiPrevT">Full prompt preview</span><span class="coll-s" id="elAiCollSum_preview"></span></button></h3>
              <div id="elAiPrevBody" class="coll-body" data-coll="preview" hidden>
                <p class="help" id="elAiPrevHelp" style="margin-top:0">What the model receives as instructions, built from the text on this page including unsaved changes. Sample values: device SAMPLE-PC, every tool available, personal values replaced.</p>
                <div class="elAiFilters">
                  <label>Question type <select id="elAiPrevMode"><option value="ask">Ask</option><option value="explain">Explain</option><option value="diagnose">Diagnosis</option></select></label>
                  <label>Device <select id="elAiPrevOs"><option value="windows">Windows</option><option value="linux">Linux</option><option value="macos">macOS</option></select></label>
                  <label>Endpoint <select id="elAiPrevEp"><option value="">None</option></select></label>
                  <button type="button" id="elAiPrevBtn">Show the full prompt</button>
                  <span id="elAiPrevStatus" class="elSaveStatus" role="status" aria-live="polite"></span>
                </div>
                <div id="elAiPrevOut" hidden>
                  <ul id="elAiPrevWarn" class="elAiChecksList"></ul>
                  <label for="elAiPrevText" class="elSr">Full prompt</label>
                  <textarea id="elAiPrevText" class="elAiMono elAiPrevText" rows="18" readonly aria-describedby="elAiPrevMeta"></textarea>
                  <div class="elAiCount" id="elAiPrevMeta"></div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="card" id="elSecAccess" aria-labelledby="elAiAccessH">
          <header class="card-h"><div><h2 id="elAiAccessH">Access</h2><p>Who can use the Assistant and how much.</p></div></header>
          <div class="card-b">
            <p class="help" style="margin-top:16px">To use the Assistant on a device, a user needs the plugin permission <b>Event Log: Assistant</b> (My Server &rarr; Plugins &rarr; Event Log &rarr; Permissions) and the Details right on the device. The device&rsquo;s config set must select an endpoint (Config sets &rarr; Assistant endpoint).</p>
            <div class="elAiGrid" style="margin-top:16px">
              <span class="elAiLbl cb">Assistant</span>
              <div><label class="ck"><input type="checkbox" role="switch" class="sw" id="elAiEnabled"><span>Turn the Assistant on</span></label></div>
              <span class="elAiLbl cb">Answer settings</span>
              <div><label class="ck"><input type="checkbox" id="elAiChatGen" aria-describedby="elAiChatGenHelp"><span>Users can change thinking and temperature in the chat</span></label>
                <small id="elAiChatGenHelp" class="elAiHelp">Per chat, on top of the endpoint&rsquo;s generation settings, with only the thinking levels the endpoint takes. The Anthropic format takes neither.</small></div>
              <label for="elAiQuotaQ">Questions per user per day</label>
              <div><input type="number" id="elAiQuotaQ" class="w-s" min="0" max="100000" step="1" aria-describedby="elAiQuotaHelp"></div>
              <label for="elAiQuotaT">Tokens per user per day</label>
              <div><input type="number" id="elAiQuotaT" class="w-m" min="0" max="1000000000" step="1" aria-describedby="elAiQuotaHelp">
                <small id="elAiQuotaHelp" class="elAiHelp">0 means no limit.</small></div>
              <label for="elAiRounds">Max steps per answer</label>
              <div><input type="number" id="elAiRounds" class="w-s" min="1" max="50" step="1" aria-describedby="elAiRoundsHelp">
                <small id="elAiRoundsHelp" class="elAiHelp">A step is one round trip to the model; in each step it may request up to 4 data lookups (1&ndash;50).</small></div>
              <label for="elAiCalls">Tool calls per answer</label>
              <div><input type="number" id="elAiCalls" style="width:22em" min="1" max="200" step="1" aria-describedby="elAiCallsHelp">
                <small id="elAiCallsHelp" class="elAiHelp">The individual data lookups across all steps of one answer (1&ndash;200; empty: automatic).</small></div>
              <label for="elAiSentKB">Data per answer (KB)</label>
              <div><input type="number" id="elAiSentKB" style="width:28em" min="16" max="8192" step="1" aria-describedby="elAiSentKBHelp">
                <small id="elAiSentKBHelp" class="elAiHelp">New data sent to the model for one answer: the question and the lookup results (16&ndash;8192; empty: automatic).</small></div>
            </div>
          </div>
        </section>

        <section class="card" id="elSecSaved" aria-labelledby="elAiSavedH">
          <header class="card-h"><div><h2 id="elAiSavedH">Saved results</h2><p>What users find again when they come back to a device.</p></div></header>
          <div class="card-b">
            <div class="elAiGrid" style="margin-top:20px">
              <span class="elAiLbl cb">Saving</span>
              <div><label class="ck"><input type="checkbox" role="switch" class="sw" id="elAiHistOn" aria-describedby="elAiHistOnHelp"><span>Save chats, diagnoses and explanations</span></label>
                <small id="elAiHistOnHelp" class="elAiHelp">Saved per user and device, so they are still there after a reload. Each user sees only their own; a chat can be continued later. They hold what the user saw, including device data such as event messages, names and addresses in clear text, in the plugin&rsquo;s database.</small></div>
              <label for="elAiHistDays">Keep them for (days)</label>
              <div><input type="number" id="elAiHistDays" class="w-s" min="1" max="3650" step="1" aria-describedby="elAiHistDaysHelp">
                <small id="elAiHistDaysHelp" class="elAiHelp">Counted from the last change (1&ndash;3650). Older items are deleted automatically.</small></div>
              <span class="elAiLbl cb">Stored now</span>
              <div><span id="elAiHistCounts" class="elAiHistCounts" aria-live="polite">&hellip;</span></div>
            </div>
            <div class="danger" role="group" aria-labelledby="elAiHistDelH">
              <div><h3 id="elAiHistDelH">Delete all saved results</h3><p>Deletes the saved chats, diagnoses and explanations of all users on all devices. The audit log is kept.</p><p><span id="elAiHistStatus" class="elSaveStatus" role="status" aria-live="polite"></span></p></div>
              <button type="button" id="elAiHistPurge" class="elAiDangerBtn">Delete all saved results</button>
            </div>
          </div>
        </section>
      </div>
    </div>

    <!-- ================= Requests (the Assistant's audit log; loaded when the page is opened) ================= -->
    <div class="eventLogPage" id="elRequests" hidden>
      <div class="ph"><div><h1>Requests</h1><p>The audit log of every Assistant answer. Loaded when you open this page, so the settings stay quick.</p></div></div>
      <section class="card" id="elSecRequests" aria-labelledby="elAiReqH">
        <header class="card-h"><div><h2 id="elAiReqH">Requests</h2><p>Every answer is logged: who asked, about which device, which endpoint, how much was sent and how many values were replaced.</p></div>
          <div class="card-acts"><a id="elAiCsv" class="elBtnLink" href="pluginadmin.ashx?pin=eventlog&amp;ai=auditcsv" target="_blank" rel="noopener noreferrer">Export CSV</a></div></header>
        <div class="card-b">
          <div class="grp">
            <h3>Keep the log</h3>
            <div class="elAiGrid" style="margin-top:10px">
              <label for="elAiRetention">Keep entries for (days)</label>
              <div><input type="number" id="elAiRetention" class="w-s" min="1" max="3650" step="1"></div>
              <span class="elAiLbl cb">Transcripts</span>
              <div><label class="ck"><input type="checkbox" id="elAiTranscripts" aria-describedby="elAiTranscriptsHelp"><span>Also store full questions and answers</span></label>
                <small id="elAiTranscriptsHelp" class="elAiWarnTxt">They are stored as they were sent to the model, with personal values replaced, and anyone who can read the database can read them.</small></div>
            </div>
          </div>
          <div class="grp">
            <h3 id="elAiReqListH">Requests</h3>
            <div class="elAiFilters" style="margin-top:10px">
              <label>From <input type="date" id="elAiAudFrom"></label>
              <label>To <input type="date" id="elAiAudTo"></label>
              <button type="button" onclick="return elAiAuditFilter();">Show</button>
            </div>
          </div>
        </div>
        <div class="elScroll" style="border-top:1px solid var(--line)">
          <table id="elAiAuditTbl" class="elAiTbl" aria-labelledby="elAiReqListH">
            <thead><tr><th scope="col">Time</th><th scope="col">User</th><th scope="col">Device</th><th scope="col">Endpoint</th><th scope="col" class="elNum">Steps</th><th scope="col" class="elNum">Sent</th><th scope="col" class="elNum">Replaced</th><th scope="col" class="elNum">Tokens</th><th scope="col">Result</th></tr></thead>
            <tbody id="elAiAuditRows"></tbody>
          </table>
        </div>
        <div class="card-pad">
          <div class="elAiBtns">
            <button type="button" id="elAiNewer" onclick="return elAiAuditPage(-1);" disabled>Newer</button>
            <button type="button" id="elAiOlder" onclick="return elAiAuditPage(1);" disabled>Older</button>
            <span id="elAiAuditInfo" class="help" style="margin:0"></span>
            <span id="elAiAuditStatus" class="elSaveStatus" role="status" aria-live="polite"></span>
          </div>
        </div>
      </section>
    </div>
    </div>

    <p id="elSavedNote" class="saved-note" role="status" aria-live="polite" hidden></p>
    <div class="savebar" id="elSaveBar" role="region" aria-label="Unsaved changes" hidden>
      <div class="bar-text">
        <p id="elBarMsg"><b>Unsaved changes:</b> <span id="elBarList"></span></p>
        <p id="elBarWarn" class="bar-warn" role="alert" hidden><span id="elBarWarnT"></span><button type="button" id="elBarSwitch" class="elQuiet">Discard and switch</button></p>
        <p class="bar-status"><span id="elAssignStatus" class="elSaveStatus" role="status" aria-live="polite"></span><span id="elSaveStatus" class="elSaveStatus" role="status" aria-live="polite"></span><span id="elAiSetStatus" class="elSaveStatus" role="status" aria-live="polite"></span></p>
      </div>
      <div class="btns"><button type="button" id="elBarDiscard" class="elQuiet">Discard</button><button type="button" id="elBarSave" class="elPrimary">Save settings</button></div>
    </div>
  </div>
</div>
<script type="text/javascript">
  // follow MeshCentral's light / night theme (this page is embedded in MeshCentral's own page)
  (function () {
    function sync() {
      try { document.body.classList.toggle('night', parent.document.body.classList.contains('night')); }
      catch (e) { document.body.classList.toggle('night', !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)); }
    }
    sync();
    try { new MutationObserver(sync).observe(parent.document.body, { attributes: true, attributeFilter: ['class'] }); } catch (e) { }
  })();
</script>
<script type="text/javascript">
  loadConfigSet();
  checkForDefault();
  updateConfigSetsSelects();
  updateAssignRows();
  elAiInit();
  elLayoutInit();
</script>
</body>
</html>
