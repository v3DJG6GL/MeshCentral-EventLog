<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script type="text/javascript" src="scripts/common-0.0.1.js"></script>
    <script type="text/javascript">
      var configSets = {{{configSets}}};
      var configAssignments = {{{configAssignments}}};
      var aiAdmin = {{{aiAdmin}}};   // { full, available } - endpoints, settings and the audit log come over the websocket

      // ================= Config sets =================
      // The editor's fields are the config set's stored format: Save sends exactly what the old table form sent.
      var EL_SET_FIELDS = {
        liveLogs: 'Application,System', liveNum: 100, liveEntryTypes: [1,2,3], liveCategories: [], liveCategoriesMode: 'exclude',
        liveSources: '', liveSourcesMode: 'exclude', historyEnabled: true, historyLogs: 'Application,System', historyEntryTypes: [1,2,3],
        historyCategories: [], historyCategoriesMode: 'exclude', historySources: '', historySourcesMode: 'exclude', retentionDays: 30
      };
      function elSetDefaults(id, name) { var o = JSON.parse(JSON.stringify(EL_SET_FIELDS)); o.id = id; o.name = name; return o; }
      // editor state: sel = the picker's value of the set in the editor; base = the editor's values as loaded (JSON)
      var elCfg = { sel: '', base: null, pendingSwitch: null };

      function addNewConfigSet() {
        if (elCfgGuard({ kind: 'new' })) return false;
        loadConfigSet(elSetDefaults('_new', 'New Config'));
        var cfdd = Q('elconfigSet');
        cfdd.appendChild(new Option('New Config', '_new'));
        cfdd.value = '_new'; elCfg.sel = '_new';
        elBarUpdate();
        try { Q('elname').focus(); Q('elname').select(); } catch (e) { }
        return false;
      }

      function loadConfigSet(set) {
        var options = {};
        if (set == null) {
          if (configSets.length > 0) {
            configSets.forEach((s) => {
              if (s.default == true) options = s;
            });
          } else {
            options = elSetDefaults('', 'Default');
          }
        } else { // get options from config
          if (typeof set == 'object') options = set;
        }
        // a field the stored set does not have shows its default, never the value of the set shown before
        var full = {};
        Object.keys(EL_SET_FIELDS).forEach(function(k) { full[k] = EL_SET_FIELDS[k]; });
        Object.keys(options).forEach(function(k) { full[k] = options[k]; });
        options = full;
        renderAlertRules([]);
        elAiCfgSetValue('');
        for (var [k, v] of Object.entries(options)) {
          switch(k) {
            case 'alerts':
              renderAlertRules(Array.isArray(v) ? v : []);
            break;
            case 'aiEndpointId':
              elAiCfgSetValue(typeof v == 'string' ? v : '');
            break;
            case 'historyEnabled':
              Q('el'+k).checked = (v === true);
            break;
            case 'liveLogs':
            case 'historyLogs':
            case 'liveSources':
            case 'historySources':
            case 'liveCategoriesMode':
            case 'historyCategoriesMode':
            case 'liveSourcesMode':
            case 'historySourcesMode':
            case 'liveNum':
            case 'retentionDays':
            case 'name':
              Q('el'+k).value = (v == null) ? '' : v;
            break;
            case 'id':
            case '_id':
              if (options.default == true)  Q('elid').value = '';
              else Q('elid').value = v;
            break;
            case 'liveEntryTypes':
            case 'historyEntryTypes':
              v = (Array.isArray(v) ? v : []).map(el => Number(el));
              Q('el'+k).querySelectorAll('input[type=checkbox]').forEach(function(i) { i.checked = v.includes(Number(i.value)); });
            break;
            case 'liveCategories':
            case 'historyCategories':
              if (typeof v == 'string') v = v.split(',');
              v = (Array.isArray(v) ? v : []).map(el => String(el).trim().toLowerCase());
              Q('el'+k).querySelectorAll('input[type=checkbox]').forEach(function(i) { i.checked = v.includes(i.value.toLowerCase()); });
            break;
          }
        }
        elCfgLoaded();
      }
      // after a set was loaded into the editor: header texts, Delete button, the loaded state for the save bar
      function elCfgLoaded() {
        var id = Q('elid').value, name = Q('elname').value || 'this set';
        Q('elCfgDelBtn').disabled = (id === '');
        Q('elCfgDelBtn').textContent = 'Delete “' + name + '”';
        Q('elCfgDelText').textContent = (id === '')
          ? 'The Default set is used by every device without another set. It can be changed, not deleted.'
          : 'Devices and device groups that use “' + name + '” fall back to their group’s set or to Default.';
        elCfg.base = JSON.stringify(elCfgState());
        if (typeof elBarUpdate == 'function') elBarUpdate();
      }

      // ---- alert rules (stored in the config set as `alerts`) ----
      // Each rule shows one summary line; Edit opens its fields.
      var elAlertLevels = [[0, 'LogAlways'], [1, 'Critical'], [2, 'Error'], [3, 'Warning'], [4, 'Info'], [5, 'Verbose']];
      function renderAlertRules(list) {
        var box = document.getElementById('elalertRules');
        if (box == null) return;
        box.innerHTML = '';
        (list || []).forEach(function(r) { addAlertRule(r); });
        elaEmpty();
      }
      function elaEmpty() { var e = Q('elalertEmpty'); if (e) e.hidden = !!Q('elalertRules').firstChild; }
      var elaSeq = 0;
      function addAlertRule(r, open) {
        var isNew = !(r && typeof r == 'object');
        r = isNew ? {} : r;
        var box = document.getElementById('elalertRules');
        var d = document.createElement('div');
        d.className = 'elAlertRule rule';
        d.setAttribute('data-id', (typeof r.id == 'string' && r.id != '') ? r.id : ('a' + Math.random().toString(36).slice(2, 10)));
        var u = 'elaR' + (++elaSeq);
        d.innerHTML =
          '<div class="rule-h">' +
            '<label class="ck"><input type="checkbox" role="switch" class="sw elaEnabled" id="' + u + 'On"><span class="elSr">Enabled</span></label>' +
            '<b class="elaTitle"></b><span class="rule-s elaSum"></span>' +
            '<button type="button" class="elQuiet elaEdit" aria-expanded="false" aria-controls="' + u + 'Body">Edit</button>' +
          '</div>' +
          '<div class="rule-b" id="' + u + 'Body" hidden>' +
            '<div class="elAiGrid">' +
              '<label for="' + u + 'Name">Name</label><div><input type="text" class="elaName w-m" id="' + u + 'Name"></div>' +
              '<span class="elAiLbl" id="' + u + 'LvL">Entry types</span><div><div class="chips elaLevels" role="group" aria-labelledby="' + u + 'LvL" aria-describedby="' + u + 'LvH"></div><p class="help" id="' + u + 'LvH">None selected means any level.</p></div>' +
              '<label for="' + u + 'Logs">Logs</label><div><input type="text" class="elaLogs w-l" id="' + u + 'Logs" aria-describedby="' + u + 'LogsH"><p class="help" id="' + u + 'LogsH">Comma separated, <code>*</code> wildcards. Empty means any log.</p></div>' +
              '<label for="' + u + 'Src">Sources</label><div><input type="text" class="elaSources w-l mono-in" id="' + u + 'Src" aria-describedby="' + u + 'SrcH"><p class="help" id="' + u + 'SrcH">Comma separated, <code>*</code> wildcards. Empty means any source.</p></div>' +
              '<label for="' + u + 'Ids">Event IDs</label><div><input type="text" class="elaIds w-m mono-in" id="' + u + 'Ids" aria-describedby="' + u + 'IdsH"><p class="help" id="' + u + 'IdsH">For example <code>1112, 100-199</code>. Empty means any.</p></div>' +
              '<label for="' + u + 'Txt">Message contains</label><div><input type="text" class="elaText w-l" id="' + u + 'Txt" aria-describedby="' + u + 'TxtH"><p class="help" id="' + u + 'TxtH">Case-insensitive text. Empty means any.</p></div>' +
              '<span class="elAiLbl" id="' + u + 'FireL">Fire when</span><div class="inl" role="group" aria-labelledby="' + u + 'FireL"><input type="number" min="1" class="elaThreshold w-s" aria-label="Number of matching events"><span>matching events occur within</span><input type="number" min="1" class="elaWindow w-s" aria-label="Minutes"><span>minutes</span></div>' +
              '<label for="' + u + 'Cool">Cooldown</label><div class="inl"><input type="number" min="0" class="elaCooldown w-s" id="' + u + 'Cool"><span>minutes before the same rule alerts again for a device</span></div>' +
            '</div>' +
            '<div class="btns"><button type="button" class="elDanger elaRemove">Remove rule</button></div>' +
          '</div>';
        var chips = d.querySelector('.elaLevels');
        var lv = (Array.isArray(r.levels) ? r.levels : []).map(Number);
        elAlertLevels.forEach(function(l) {
          var lab = document.createElement('label'), i = document.createElement('input'), s = document.createElement('span');
          lab.className = 'chip'; i.type = 'checkbox'; i.value = l[0]; i.checked = lv.indexOf(l[0]) != -1; s.textContent = l[1];
          lab.appendChild(i); lab.appendChild(s); chips.appendChild(lab);
        });
        d.querySelector('.elaEnabled').checked = (r.enabled !== false);
        d.querySelector('.elaName').value = r.name || '';
        d.querySelector('.elaLogs').value = r.logs || '';
        d.querySelector('.elaSources').value = r.sources || '';
        d.querySelector('.elaIds').value = r.ids || '';
        d.querySelector('.elaText').value = r.text || '';
        d.querySelector('.elaThreshold').value = (Number(r.threshold) >= 1) ? Number(r.threshold) : 1;
        d.querySelector('.elaWindow').value = (Number(r.windowMin) >= 1) ? Number(r.windowMin) : 10;
        d.querySelector('.elaCooldown').value = (r.cooldownMin != null && Number(r.cooldownMin) >= 0) ? Number(r.cooldownMin) : 5;
        d.querySelector('.elaRemove').onclick = function() { box.removeChild(d); elaEmpty(); elBarUpdate(); Q('elaAddBtn').focus(); return false; };
        d.querySelector('.elaEdit').onclick = function() { elaOpen(d, d.querySelector('.rule-b').hidden); return false; };
        d.addEventListener('input', function() { elaSummary(d); });
        d.addEventListener('change', function() { elaSummary(d); });
        box.appendChild(d);
        elaSummary(d);
        elaEmpty();
        if (open) { elaOpen(d, true); try { d.querySelector('.elaName').focus(); } catch (e) { } }
        return false;
      }
      function elaOpen(d, open) {
        var b = d.querySelector('.elaEdit');
        d.querySelector('.rule-b').hidden = !open;
        b.setAttribute('aria-expanded', open ? 'true' : 'false');
        b.textContent = open ? 'Close' : 'Edit';
        d.classList.toggle('open', !!open);
      }
      // "Critical or Error, in System, IDs 7, 55. Fires at 3 within 10 min, then waits 60 min."
      function elaSummary(d) {
        var q = function(c) { return d.querySelector(c).value.trim(); };
        var name = q('.elaName') || 'Unnamed rule';
        var lv = Array.from(d.querySelectorAll('.elaLevels input:checked')).map(function(i) { return i.parentNode.textContent; });
        var bits = [lv.length ? lv.join(' or ') : 'Any level', 'in ' + (q('.elaLogs') || 'any log')];
        if (q('.elaSources')) bits.push('from ' + q('.elaSources'));
        if (q('.elaIds')) bits.push('IDs ' + q('.elaIds'));
        if (q('.elaText')) bits.push('containing “' + q('.elaText') + '”');
        d.querySelector('.elaTitle').textContent = name;
        d.querySelector('.elaSum').textContent = bits.join(', ') + '. Fires at ' + (q('.elaThreshold') || '1') + ' within ' + (q('.elaWindow') || '10') + ' min, then waits ' + (q('.elaCooldown') || '5') + ' min.' + (d.querySelector('.elaEnabled').checked ? '' : ' Off.');
        d.querySelector('.elaEnabled').setAttribute('aria-label', 'Rule “' + name + '” enabled');
        d.querySelector('.elaEdit').setAttribute('aria-label', (d.querySelector('.rule-b').hidden ? 'Edit' : 'Close') + ' rule “' + name + '”');
      }
      function readAlertRules() {
        var out = [];
        document.querySelectorAll('#elalertRules .elAlertRule').forEach(function(d) {
          var cd = Number(d.querySelector('.elaCooldown').value);
          out.push({
            id: d.getAttribute('data-id'),
            enabled: d.querySelector('.elaEnabled').checked,
            name: d.querySelector('.elaName').value.trim() || 'Unnamed rule',
            levels: Array.from(d.querySelectorAll('.elaLevels input:checked')).map(function(o) { return Number(o.value); }),
            logs: d.querySelector('.elaLogs').value.trim(),
            sources: d.querySelector('.elaSources').value.trim(),
            ids: d.querySelector('.elaIds').value.trim(),
            text: d.querySelector('.elaText').value.trim(),
            threshold: Math.max(1, Math.floor(Number(d.querySelector('.elaThreshold').value)) || 1),
            windowMin: Math.max(1, Number(d.querySelector('.elaWindow').value) || 10),
            cooldownMin: (isNaN(cd) || cd < 0) ? 5 : cd
          });
        });
        return out;
      }

      var elSaveTimer = null;
      // Status line: kind '' | 'pending' | 'ok' | 'warn' | 'err'. While pending, the button (optional btnId) is
      // disabled; an 'ok' text clears itself after 15 s.
      function setStatus(elId, kind, text, btnId) {
        var el = document.getElementById(elId);
        if (el == null) return;
        el.className = 'elSaveStatus' + (kind ? ' ' + kind : '');
        el.textContent = text || '';
        if (btnId) { var btn = document.getElementById(btnId); if (btn != null) btn.disabled = (kind == 'pending'); }
        clearTimeout(el._t);
        if (kind == 'ok') el._t = setTimeout(function() { if (el.classList.contains('ok')) { el.textContent = ''; el.className = 'elSaveStatus'; } }, 15000);
        if (el.closest && el.closest('#elSaveBar') && typeof elBarUpdate == 'function') elBarUpdate();
      }
      function setSaveStatus(kind, text) { setStatus('elSaveStatus', kind, text); }
      // the config set editor as the server stores it (the payload of adminSaveConfig)
      function elCfgState() {
        var x = {
          name: Q('elname').value,
          liveLogs: Q('elliveLogs').value,
          liveNum: Q('elliveNum').value,
          liveEntryTypes: Array.from(document.querySelectorAll('#elliveEntryTypes input:checked')).map(el => el.value),
          liveCategories: Array.from(document.querySelectorAll('#elliveCategories input:checked')).map(el => el.value),
          liveCategoriesMode: Q('elliveCategoriesMode').value,
          liveSources: Q('elliveSources').value,
          liveSourcesMode: Q('elliveSourcesMode').value,
          historyEnabled: (Q('elhistoryEnabled').checked) ? true : false,
          historyLogs: Q('elhistoryLogs').value,
          historyEntryTypes: Array.from(document.querySelectorAll('#elhistoryEntryTypes input:checked')).map(el => el.value),
          historyCategories: Array.from(document.querySelectorAll('#elhistoryCategories input:checked')).map(el => el.value),
          historyCategoriesMode: Q('elhistoryCategoriesMode').value,
          historySources: Q('elhistorySources').value,
          historySourcesMode: Q('elhistorySourcesMode').value,
          retentionDays: Math.max(1, Number(Q('elretentionDays').value) || 30),
          alerts: readAlertRules()
        };
        // only full administrators manage the Assistant; for everyone else the field is left out, so the stored value stays
        if (elAiIsOn() && Q('elaiEndpointId') != null) x.aiEndpointId = Q('elaiEndpointId').value;
        return x;
      }
      function elCfgDirty() { return Q('elid').value === '_new' || (elCfg.base != null && JSON.stringify(elCfgState()) !== elCfg.base); }
      function saveConfig() {
        var configId = Q('elid').value;
        var x = elCfgState();
        // the server answers with adminUpdateConfigSets (saved) or adminSaveFailed; the status text follows that answer
        parent.meshserver.send({ action: 'plugin', plugin: 'eventlog', pluginaction: 'adminSaveConfig', id: (configId == '') ? '_default' : configId, opts: x });
        setSaveStatus('pending', 'Saving config set “' + x.name + '”…');
        clearTimeout(elSaveTimer);
        elSaveTimer = setTimeout(function() { setSaveStatus('warn', 'Config set “' + x.name + '”: no answer from the server — the save is not confirmed. Check the connection and try again.'); }, 10000);
        updateConfigSetName(configId, x.name);
      }

      // the picker: switching away from unsaved changes is held back with a warning in the save bar
      function changeConfig(el) {
        var target = el.value;
        if (elCfgGuard({ kind: 'switch', value: target })) { el.value = elCfg.sel; return false; }
        elCfgSwitch(target);
        return false;
      }
      function elCfgSwitch(target) {
        var cs = Q('elconfigSet');
        if (target != '_new') Array.from(cs.querySelectorAll('option')).forEach(function(o) { if (o.value == '_new') o.parentNode.removeChild(o); });
        if (target == '') loadConfigSet();
        else configSets.forEach((s) => { if (s._id == target) loadConfigSet(s); });
        cs.value = target; elCfg.sel = target;
        elBarWarn(null);
      }
      // true (and a warning in the save bar) while the editor has unsaved changes
      function elCfgGuard(what) {
        if (!elCfgDirty()) return false;
        elCfg.pendingSwitch = what;
        var name = Q('elname').value || 'this set';
        elBarWarn('Config set “' + name + '” has unsaved changes. Save or discard them before you ' + (what.kind == 'new' ? 'add a new set.' : 'switch to another set.'), what.kind == 'new' ? 'Discard and add a set' : 'Discard and switch');
        return true;
      }
      function elCfgReload() {
        var id = Q('elconfigSet').value;
        if (id == '_new') { elCfgSwitch(''); return; }
        if (id == '') loadConfigSet();
        else configSets.forEach((s) => { if (s._id == id) loadConfigSet(s); });
      }

      function deleteConfig() {
        var configId = Q('elid').value;
        if (configId == '') {
          parent.setDialogMode(2, 'Cannot Delete Default', 1, null, 'The default set can only be changed, not deleted.');
          return false;
        } else if (configId == '_new') {
          elCfgSwitch('');
        } else {
          if (!confirm('Delete the config set “' + Q('elname').value + '”? Devices and device groups that use it fall back to their group’s set or to Default.')) return false;
          parent.meshserver.send({ action: 'plugin', plugin: 'eventlog', pluginaction: 'adminDeleteConfig', id: configId });
        }
        return false;
      }
      // the header's Delete: shows the danger zone at the end of the page
      function elCfgDelGoto() {
        var dz = Q('elCfgDanger');
        try { dz.scrollIntoView({ block: 'center', behavior: elReduced() ? 'auto' : 'smooth' }); } catch (e) { }
        dz.classList.add('flash');
        setTimeout(function() { dz.classList.remove('flash'); }, 1200);
        Q('elCfgDelBtn').disabled ? Q('elCfgDelText').focus() : Q('elCfgDelBtn').focus({ preventScroll: true });
        return false;
      }

      function updateConfigSetName(id, name) {
        let cs = document.querySelectorAll('#elconfigSet option');
        for (const i in Object.entries(cs)){
          if (cs[i].value == id) cs[i].text = name;
        }
      }

      // ================= Assignment =================
      // Changes are collected (pending: asset id -> config set id, 'default', or null = own set cleared) and sent with
      // the save bar. A device without its own set uses its group's set; a group without one uses Default.
      var elAs = { pending: {}, sel: {}, filter: '', saving: 0, sent: null, timer: null };
      function elAsHas(o, k) { return Object.prototype.hasOwnProperty.call(o, k); }
      function elAsSaved(asset) { var v = null; (configAssignments || []).forEach(function(a) { if (a.asset == asset) v = (a.configId === '' ? 'default' : a.configId); }); return v; }
      function elAsValue(asset) { return elAsHas(elAs.pending, asset) ? elAs.pending[asset] : elAsSaved(asset); }
      function elDefaultName() { var n = 'Default'; configSets.forEach(function(s) { if (s.default === true && s.name) n = s.name; }); return n; }
      function elSetName(cid) {
        if (cid == null) return null;
        if (cid === 'default' || cid === '') return elDefaultName();
        var n = null; configSets.forEach(function(s) { if (s._id == cid) n = s.name; });
        return n == null ? 'Deleted config set' : n;
      }
      // One assignment row, built from DOM nodes: device and group names are user-entered text and must never be parsed as HTML.
      function assignRow(id, name, groupName, meshId) {
        var tr = document.createElement('tr'); tr.className = 'eldataRow';
        tr.setAttribute('data-name', (String(name == null ? '' : name) + ' ' + String(groupName == null ? '' : groupName)).toLowerCase());
        var td0 = document.createElement('td'); td0.className = 'sel';
        var cb = document.createElement('input');
        cb.type = 'checkbox'; cb.name = 'assign[]'; cb.value = id; cb.checked = !!elAs.sel[id];
        cb.setAttribute('aria-label', 'Select ' + (name == null ? '' : name));
        cb.addEventListener('change', function() { elAs.sel[id] = cb.checked; elAsToolbar(); });
        td0.appendChild(cb); tr.appendChild(td0);
        var td1 = document.createElement('td'); td1.textContent = (name == null || name === '') ? ' ' : name; tr.appendChild(td1);
        if (meshId !== undefined) { var tdg = document.createElement('td'); tdg.textContent = (groupName == null || groupName === '') ? ' ' : groupName; tr.appendChild(tdg); }
        var td2 = document.createElement('td'), v = elAsValue(id), s = document.createElement('span');
        if (v != null) { s.className = 'expl'; s.textContent = elSetName(v); }
        else {
          var g = (meshId !== undefined) ? elAsValue(meshId) : null;
          s.className = 'inh'; s.textContent = (g != null) ? elSetName(g) + ' (from group)' : elDefaultName() + ' (inherited)';
        }
        td2.appendChild(s);
        if (elAsHas(elAs.pending, id)) {
          tr.classList.add('chg');
          var t = document.createElement('span'); t.className = 'chgtag'; t.textContent = 'Changed'; td2.appendChild(t);
        }
        tr.appendChild(td2);
        return tr;
      }
      function elAsEmptyRow(cols, text) { var tr = document.createElement('tr'), td = document.createElement('td'); td.colSpan = cols; td.className = 'inh'; td.textContent = text; tr.appendChild(td); return tr; }
      function updateAssignRows() {
        // a pending change the server now has is no longer pending
        Object.keys(elAs.pending).forEach(function(id) { if (elAs.pending[id] === elAsSaved(id)) delete elAs.pending[id]; });
        var gBody = Q('elAsGroups'), dBody = Q('elAsDevices');
        gBody.textContent = ''; dBody.textContent = '';
        var byName = function(a, b) { return String(a.name || '').localeCompare(String(b.name || '')); };
        var meshes = [];
        for (var m in parent.meshes) { if (parent.meshes[m] && parent.meshes[m].mtype == 2) meshes.push(parent.meshes[m]); }
        meshes.sort(byName).forEach(function(g) { gBody.appendChild(assignRow(g._id, g.name, '', undefined)); });
        var nodes = (parent.nodes || []).filter(function(n) { return n && n.mtype == 2; }).slice().sort(byName);
        nodes.forEach(function(n) {
          var mesh = parent.meshes[n.meshid];
          dBody.appendChild(assignRow(n._id, n.name, mesh ? mesh.name : '', n.meshid));
        });
        if (!meshes.length) gBody.appendChild(elAsEmptyRow(3, 'No device groups with agents.'));
        if (!nodes.length) dBody.appendChild(elAsEmptyRow(4, 'No devices with agents.'));
        elAsFilter();
        elAsToolbar();
        if (typeof elBarUpdate == 'function') elBarUpdate();
      }
      function elAsFilter() {
        var q = String(Q('elAsFilter').value || '').trim().toLowerCase();
        document.querySelectorAll('#elAsGroups tr.eldataRow, #elAsDevices tr.eldataRow').forEach(function(tr) {
          tr.hidden = !!q && tr.getAttribute('data-name').indexOf(q) < 0;
        });
        ['elAsGroups', 'elAsDevices'].forEach(function(id) {
          var rows = Q(id).querySelectorAll('tr.eldataRow'), shown = Array.prototype.filter.call(rows, function(r) { return !r.hidden; });
          Q(id + 'None').hidden = !(rows.length && !shown.length);
        });
        elAsToolbar();
      }
      function elAsSelected() { return Object.keys(elAs.sel).filter(function(k) { return elAs.sel[k]; }); }
      function elAsToolbar() {
        var n = elAsSelected().length;
        Q('elAsAssign').disabled = !n; Q('elAsClear').disabled = !n;
        Q('elAsCount').textContent = n ? (n + ' selected') : 'Select rows to change them';
        ['elAsGroups', 'elAsDevices'].forEach(function(id) {
          var all = Q(id + 'All'), boxes = Array.prototype.filter.call(Q(id).querySelectorAll('tr.eldataRow'), function(r) { return !r.hidden; }).map(function(r) { return r.querySelector('input'); });
          var on = boxes.filter(function(b) { return b.checked; }).length;
          all.checked = boxes.length > 0 && on === boxes.length; all.indeterminate = on > 0 && on < boxes.length; all.disabled = !boxes.length;
        });
      }
      function elAsSelectAll(id, on) {
        Array.prototype.forEach.call(Q(id).querySelectorAll('tr.eldataRow'), function(r) { if (r.hidden) return; var b = r.querySelector('input'); b.checked = on; elAs.sel[b.value] = on; });
        elAsToolbar();
