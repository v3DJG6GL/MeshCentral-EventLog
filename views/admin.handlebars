      }
      function elAiRefresh() {
        elAiSend('get', 'aiAdminGet', {}, 10000, function() { if (!elAi.loaded) { Q('elAiEpEmpty').textContent = 'Could not load the endpoints: no answer from the server.'; } });
      }
      parent.pluginHandler['eventlog'].aiAdminData = elAiHandler(function(msg) {
        // an answer to our latest aiAdminGet, or a push without reqId; an answer to an older request is ignored
        if (msg.reqId != null && elAiTake(msg) == null) return;
        elAi.endpoints = Array.isArray(msg.endpoints) ? msg.endpoints.filter(function(e) { return e && typeof e == 'object'; }) : [];
        elAi.usedBy = (msg.usedBy && typeof msg.usedBy == 'object') ? msg.usedBy : {};
        elAi.keySource = (typeof msg.keySource == 'string' && msg.keySource) ? msg.keySource : null;
        var first = !elAi.loaded;
        elAi.loaded = true;
        if (msg.factory && typeof msg.factory == 'object') {
          elAi.factory = {};
          EL_AI_PARTS.forEach(function(x) { elAi.factory[x[0]] = (typeof msg.factory[x[0]] == 'string') ? msg.factory[x[0]] : ''; });
          elAi.factoryHash = (msg.factoryHash && typeof msg.factoryHash == 'object') ? msg.factoryHash : {};
          elAi.placeholders = (msg.placeholders && typeof msg.placeholders == 'object') ? msg.placeholders : {};
          elAiBuildPrompts();
        }
        if (msg.startersFactory && typeof msg.startersFactory == 'object') {
          EL_AI_OSES.forEach(function(os) { elAi.startersFactory[os] = Array.isArray(msg.startersFactory[os]) ? msg.startersFactory[os].filter(function(x) { return typeof x == 'string'; }) : []; });
        }
        elAi.histAvailable = (msg.historyAvailable === true);
        elAi.histCounts = (msg.historyCounts && typeof msg.historyCounts == 'object') ? msg.historyCounts : null;
        elAiRenderHistCounts();
        if (msg.settings && typeof msg.settings == 'object') {
          elAi.settings = msg.settings;
          if (first || !elAi.settingsDirty) elAiRenderSettings();   // never overwrite unsaved edits
        }
        elAiRenderEndpoints();
        elAiRenderPrevEps();
        if (elAi.edit) elAiKeyState();
        if (elAi.offer) {
          if (elAi.offer.state == 'check') elAiOfferCheck();
          else if (elAi.offer.state == 'shown' && !elAi.endpoints.some(function(x) { return x.id === elAi.offer.id; })) elAiOfferHide();
        }
      });
      parent.pluginHandler['eventlog'].aiAdminSaved = elAiHandler(function(msg) {
        if (elAiTake(msg) == null) return;
        elAiUpsert(msg.endpoint);
        var name = (msg.endpoint && msg.endpoint.name) || 'endpoint';
        setStatus('elAiFormStatus', '', '', 'elAiSaveEpBtn');
        if (!Q('elAiEpForm').hidden) elAiCloseForm();
        if (msg.warning) setStatus('elAiEpStatus', 'warn', '\u2713 Saved \u201C' + name + '\u201D. ' + String(msg.warning));
        else setStatus('elAiEpStatus', 'ok', '\u2713 Saved \u201C' + name + '\u201D at ' + new Date().toLocaleTimeString() + '.');
        elAiRenderEndpoints();
        if (msg.endpoint && msg.endpoint.id) elAi.offer = { id: msg.endpoint.id, name: msg.endpoint.name || '', state: 'check' };
        elAiRefresh();   // usedBy, network and the config set list; then elAiOfferCheck
      });
      parent.pluginHandler['eventlog'].aiAdminDeleted = elAiHandler(function(msg) {
        if (elAiTake(msg) == null) return;
        var gone = elAi.endpoints.filter(function(x) { return x.id === msg.id; })[0];
        elAi.endpoints = elAi.endpoints.filter(function(x) { return x.id !== msg.id; });
        if (elAi.edit && elAi.edit.id === msg.id) elAiCloseForm();
        if (elAi.offer && elAi.offer.id === msg.id) elAiOfferHide();
        setStatus('elAiEpStatus', 'ok', '\u2713 Deleted \u201C' + ((gone && gone.name) || 'endpoint') + '\u201D.');
        elAiRenderEndpoints();
        elAiRefresh();
      });
      parent.pluginHandler['eventlog'].aiAdminSettingsSaved = elAiHandler(function(msg) {
        if (elAiTake(msg) == null) return;
        if (msg.settings && typeof msg.settings == 'object') { elAi.settings = msg.settings; elAiRenderSettings(); }
        elAi.settingsDirty = false;
        var notes = Array.isArray(msg.warnings) ? msg.warnings : [];
        if (notes.length) setStatus('elAiSetStatus', 'warn', '\u2713 Settings saved at ' + new Date().toLocaleTimeString() + '. See the notes under System prompt.', 'elAiSetBtn');
        else setStatus('elAiSetStatus', 'ok', '\u2713 Settings saved at ' + new Date().toLocaleTimeString() + '.', 'elAiSetBtn');
      });
      parent.pluginHandler['eventlog'].aiAdminPromptPreview = elAiHandler(function(msg) {
        if (elAiTake(msg) == null) return;
        var text = String(msg.text == null ? '' : msg.text);
        Q('elAiPrevText').value = text;
        Q('elAiPrevMeta').textContent = 'About ' + elAiFmtNum(Number(msg.tokens) || 0) + ' tokens, ' + elAiFmtNum(text.length) + ' characters';
        elAiRenderNotes('elAiPrevWarn', msg.warnings);
        Q('elAiPrevOut').hidden = false;
        setStatus('elAiPrevStatus', '', '', 'elAiPrevBtn');
      });
      parent.pluginHandler['eventlog'].aiAdminTestResult = elAiHandler(function(msg) {
        if (elAiTake(msg) == null || elAi.edit == null) return;
        if (msg.caps && typeof msg.caps == 'object') { elAi.edit.caps = msg.caps; elAi.edit.capsFor = elAi.edit.sentTarget && elAi.edit.sentTarget.test; }
        setStatus('elAiFormStatus', msg.ok ? 'ok' : 'err', msg.ok ? '\u2713 Test passed.' : '\u2717 Test failed; see the steps above.', 'elAiTestBtn');
        elAiRenderTest(msg);
        elAiServerNet('test', msg.network);
        elAiOllamaVisible();
        elAiModelFacts();
        if (elAi.edit.id) elAiRefresh();   // the server records the last test of a saved endpoint
      });
      parent.pluginHandler['eventlog'].aiAdminModelsResult = elAiHandler(function(msg) {
        if (elAiTake(msg) == null || elAi.edit == null) return;
        elAiServerNet('models', msg.network);
        if (!msg.ok) { setStatus('elAiModelsStatus', 'err', '\u2717 ' + String(msg.error || 'The server did not return a model list.'), 'elAiFetchBtn'); return; }
        elAi.models = (Array.isArray(msg.models) ? msg.models : []).filter(function(m) { return m && typeof m.id == 'string'; });
        elAi.modelsMeta = { genDefaults: (msg.genDefaults && typeof msg.genDefaults == 'object') ? msg.genDefaults : null, thinkingDefault: (typeof msg.thinkingDefault == 'string') ? msg.thinkingDefault : null };
        elAi.edit.modelsFor = elAi.edit.sentTarget && elAi.edit.sentTarget.models;
        var dl = Q('elAiModelList'); dl.textContent = '';
        elAi.models.forEach(function(m) { dl.appendChild(new Option(m.id, m.id)); });
        setStatus('elAiModelsStatus', 'ok', elAi.models.length ? ('\u2713 ' + elAiFmtNum(elAi.models.length) + ' models; pick one in the Model field.') : 'The server lists no models.', 'elAiFetchBtn');
        if (Q('elAiModel').value.trim() === '' && elAi.models.length == 1) Q('elAiModel').value = elAi.models[0].id;
        elAiModelFacts();
      });
      parent.pluginHandler['eventlog'].aiAdminHistoryStats = elAiHandler(function(msg) {
        if (elAiTake(msg) == null) return;
        elAi.histCounts = (msg.counts && typeof msg.counts == 'object') ? msg.counts : null;
        elAiRenderHistCounts();
      });
      parent.pluginHandler['eventlog'].aiAdminHistoryPurged = elAiHandler(function(msg) {
        if (elAiTake(msg) == null) return;
        elAi.histCounts = (msg.counts && typeof msg.counts == 'object') ? msg.counts : { chat: 0, diagnosis: 0, explain: 0, total: 0 };
        var n = Number(msg.removed) || 0;
        setStatus('elAiHistStatus', 'ok', '\u2713 Deleted ' + elAiFmtNum(n) + ' saved ' + (n == 1 ? 'result' : 'results') + '.', 'elAiHistPurge');
        elAiRenderHistCounts();
      });
      parent.pluginHandler['eventlog'].aiAdminAuditRows = elAiHandler(function(msg) {
        if (elAiTake(msg) == null) return;
        setStatus('elAiAuditStatus', '', '');
        elAiRenderAudit(msg.rows, msg.total);
      });
      parent.pluginHandler['eventlog'].aiAdminError = elAiHandler(function(msg) {
        var kind = elAiTake(msg);
        if (kind == null) return;
        var text = '\u2717 ' + String(msg.error || 'The server refused the request.');
        switch (kind) {
          case 'saveEp': setStatus('elAiFormStatus', 'err', text, 'elAiSaveEpBtn'); break;
          case 'delete': setStatus('elAiEpStatus', 'err', text); break;
          case 'settings': setStatus('elAiSetStatus', 'err', text, 'elAiSetBtn'); break;
          case 'test': setStatus('elAiFormStatus', 'err', text, 'elAiTestBtn'); break;
          case 'models': setStatus('elAiModelsStatus', 'err', text, 'elAiFetchBtn'); break;
          case 'audit': setStatus('elAiAuditStatus', 'err', text); elAiAuditButtons(); break;
          case 'preview': setStatus('elAiPrevStatus', 'err', text, 'elAiPrevBtn'); break;
          case 'purge': setStatus('elAiHistStatus', 'err', text, 'elAiHistPurge'); elAiRenderHistCounts(); break;
          case 'histStats': Q('elAiHistCounts').textContent = text; break;
          default: setStatus('elAiEpStatus', 'err', text); if (!elAi.loaded) Q('elAiEpEmpty').textContent = 'Could not load the endpoints.';
        }
      });

      function elAiInit() {
        var notice = Q('elAiNotice'), body = Q('elAiBody');
        if (notice == null || body == null) return;
        elAiRenderCfgSelect();
        if (!aiAdmin || !aiAdmin.full) { notice.textContent = 'Only full administrators can manage the Assistant.'; notice.hidden = false; return; }
        if (!aiAdmin.available) { notice.textContent = 'The Assistant is not available on this server.'; notice.hidden = false; return; }
        body.hidden = false;
        elAiBuildChecks('elAiRedact', EL_AI_REDACT, 'elAiR_');
        elAiBuildChecks('elAiCats', EL_AI_CATS, 'elAiC_');
        Q('elAiRedact').setAttribute('aria-describedby', 'elAiRedactHelp');
        var mark = function() { elAi.settingsDirty = true; };
        Q('elAiSettings').addEventListener('input', mark);
        Q('elAiSettings').addEventListener('change', mark);
        Q('elAiRounds').addEventListener('input', elAiCapPlaceholders);
        Q('elAiEpExtra').addEventListener('input', function() { elAiCount('elAiEpExtraCount', Q('elAiEpExtra').value.length, EL_AI_EXTRA_MAX); });
        EL_AI_OSES.forEach(function(os) {
          Q('elAiStartAdd_' + os).addEventListener('click', function() { elAiStartAdd(os); });
          Q('elAiStartReset_' + os).addEventListener('click', function() { elAiStartReset(os); });
          elAiStartRender(os);
        });
        Q('elAiHistPurge').addEventListener('click', elAiHistPurge);
        elAiRefresh();
        elAiLoadAudit();
      }
    </script>
</head>
<style>
    /* Theme: same palette, buttons, inputs and text as the device page's Event Log tab.
       Night mode is mirrored from MeshCentral's own <body class="night"> (see the script at the end). */
    body {
      --evl-ink:#1c1c1c; --evl-muted:#5a6360; --evl-line:#c9c9c9; --evl-line2:#e6e6e6; --evl-bg:#fff;
      --evl-alt:#f4f6f5; --evl-hover:#e9f0f1; --evl-sel:#dbe9eb; --evl-chip:#eef1f0; --evl-input:#fff;
      --evl-acc:#1F6F78; --evl-acc-ink:#fff; --evl-ok:#1e8a4c; --evl-bline:#c9c9c9;
      margin: 0; padding: 4px 0;
      font-family: "Trebuchet MS", Arial, Helvetica, sans-serif;
      background: var(--evl-bg); color: var(--evl-ink); color-scheme: light;
    }
    body.night {
      --evl-ink:#bbbbbb; --evl-muted:#8b9591; --evl-line:#333; --evl-line2:#222; --evl-bg:#000;
      --evl-alt:#0d1110; --evl-hover:#18201f; --evl-sel:#18302f; --evl-chip:#1a1f1e; --evl-input:#111;
      --evl-acc:#5fb3bb; --evl-acc-ink:#000; --evl-ok:#3dbf7a; --evl-bline:#4a5250;
      color-scheme: dark;
    }
    #eventLogAdmin { width: 100%; box-sizing: border-box; }
    #eventLogAdmin small, #eventLogAdmin .evlLbl { color: var(--evl-muted); }
    #eventLogAdmin code { font-family: Consolas, "DejaVu Sans Mono", monospace; font-size: 12px; background: var(--evl-chip); padding: 0 4px; border-radius: 3px; }
    #eventLogAdmin a { color: var(--evl-acc); cursor: pointer; text-decoration: underline dotted; }
    #eventLogAdmin a:hover { text-decoration-style: solid; }

    /* tabs: segmented control, like the Table / Viewer switch */
    #eventLogAdminNav { display: inline-flex; margin: 2px 0 8px 12px; border: 1px solid var(--evl-bline); border-radius: 3px; overflow: hidden; background: var(--evl-input); }
    .eventLogNavClass button { float: none; border: 0; outline: none; background: var(--evl-input); color: var(--evl-muted); padding: 4px 14px; cursor: pointer; font: inherit; transition: none; }
    .eventLogNavClass button:hover:not(.eventLogTabActive) { background: var(--evl-hover); color: var(--evl-ink); }
    .eventLogNavClass button:active:not(.eventLogTabActive) { background: var(--evl-sel); }
    .eventLogNavClass button.eventLogTabActive { background: var(--evl-acc); color: var(--evl-acc-ink); font-weight: bold; }
    .eventLogNavClass button:focus-visible { outline: 2px solid var(--evl-acc); outline-offset: -2px; }
    .eventLogPage { padding: 6px 12px; border: 0; }

    /* buttons: same as the device tab's .evlBtn; the first button of each group is the primary action */
    #eventLogAdmin button:not(#eventLogAdminNav button) { border: 1px solid var(--evl-bline); background: var(--evl-input); color: var(--evl-ink); border-radius: 3px; padding: 4px 9px; cursor: pointer; font: inherit; }
    #eventLogAdmin button:not(#eventLogAdminNav button):hover { background: var(--evl-hover); border-color: var(--evl-acc); }
    #eventLogAdmin button:not(#eventLogAdminNav button):active { background: var(--evl-sel); transform: translateY(1px); }
    #eventLogAdmin button:not(#eventLogAdminNav button):focus-visible { outline: 2px solid var(--evl-acc); outline-offset: -2px; }
    #eventLogAdmin #elAssignChoice button:first-of-type, #eventLogAdmin #elConfigBtns button:first-of-type { background: var(--evl-acc); color: var(--evl-acc-ink); border-color: var(--evl-acc); }
    #eventLogAdmin #elAssignChoice button:first-of-type:hover, #eventLogAdmin #elConfigBtns button:first-of-type:hover { background: var(--evl-acc); filter: brightness(1.08); }
    .elaRemove { margin-left: 8px; }

    /* inputs */
    #eventLogAdmin input[type=text], #eventLogAdmin input[type=number], #eventLogAdmin select {
      border: 1px solid var(--evl-line); background: var(--evl-input); color: var(--evl-ink);
      border-radius: 3px; padding: 4px 6px; font: inherit; box-sizing: border-box;
    }
    #eventLogAdmin input[type=text]:focus, #eventLogAdmin input[type=number]:focus, #eventLogAdmin select:focus { outline: 2px solid var(--evl-acc); outline-offset: -1px; }
    #eventLogAdmin input[type=checkbox] { accent-color: var(--evl-acc); }
    #eventLogAdmin option { background: var(--evl-input); color: var(--evl-ink); }
    #eventLogAdmin option:checked { background: var(--evl-acc); color: var(--evl-acc-ink); }
    .elMSel { height: 122px; width: 140px; }
    .elLongTxt { width: 100%; max-width: 640px; }

    /* tables: header and row styling like the event table */
    #eventLogAdmin table { border-collapse: collapse; }
    #assignTbl { width: 100%; }
    #assignTbl th { font-size: 12px; color: var(--evl-muted); padding: 5px 8px; border-bottom: 1px solid var(--evl-line); }
    #assignTbl td { padding: 3px 8px; border-bottom: 1px solid var(--evl-line2); }
    #assignTbl tr.eldataRow:hover td { background: var(--evl-hover); }
    #editConfig > table > tbody > tr > td { padding: 6px 10px 6px 0; vertical-align: top; border-bottom: 1px solid var(--evl-line2); }
    #editConfig > table > tbody > tr > td:first-child { color: var(--evl-ink); min-width: 220px; max-width: 320px; }
    #editConfig > table > tbody > tr > td[colspan] { background: var(--evl-alt); color: var(--evl-ink); border-top: 1px solid var(--evl-line); border-bottom: 1px solid var(--evl-line); }

    .elAlertRule { border: 1px solid var(--evl-line); background: var(--evl-alt); border-radius: 4px; padding: 6px 8px; margin-bottom: 8px; }
    .elAlertTbl td { padding: 2px 8px 2px 0; vertical-align: top; border-bottom: 0; }
    #elConfigBtns { float: right; }
    .elSaveStatus { margin-right: 8px; font-size: 13px; }
    .elSaveStatus.pending { color: var(--evl-muted); }
    .elSaveStatus.ok { color: var(--evl-ok); font-weight: bold; }
    .elSaveStatus.err { color: #C9352B; font-weight: bold; }
    body.night .elSaveStatus.err { color: #ff8a7e; }
    .elSaveStatus.warn { color: #B86F00; font-weight: bold; }
    body.night .elSaveStatus.warn { color: #f0b848; }
    #eventLogAdmin button:disabled { opacity: .55; cursor: default; }

    /* ---- Assistant tab ---- */
    body { --evl-warn-bg:#fff6e0; --evl-warn-line:#e0b04a; --evl-warn-ink:#6b4a00; --evl-err:#C9352B; --evl-err-bg:#fdeceb; --evl-cloud:#B86F00; }
    body.night { --evl-warn-bg:#2a2108; --evl-warn-line:#8a6a1e; --evl-warn-ink:#f0c870; --evl-err:#ff8a7e; --evl-err-bg:#2c1210; --evl-cloud:#f0b848; }
    [hidden] { display: none !important; }
    .elSr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    #elAssistant { max-width: 1100px; }
    .elAiSec { margin: 0 0 18px 0; }
    .elAiSec h3 { font-size: 15px; margin: 14px 0 6px 0; padding-bottom: 4px; border-bottom: 1px solid var(--evl-line); }
    .elAiHelp, #eventLogAdmin small.elAiHelp { color: var(--evl-muted); font-size: 12px; display: block; margin: 3px 0; max-width: 760px; }
    .elAiNote { border: 1px solid var(--evl-line); border-left: 4px solid var(--evl-acc); background: var(--evl-alt); border-radius: 3px; padding: 8px 10px; margin: 4px 0 10px 0; max-width: 900px; }
    .elAiWarn { border: 1px solid var(--evl-warn-line); border-left-width: 4px; background: var(--evl-warn-bg); color: var(--evl-warn-ink); border-radius: 3px; padding: 6px 9px; margin: 5px 0; max-width: 640px; font-size: 13px; }
    .elAiErrBox { border: 1px solid var(--evl-err); border-left-width: 4px; background: var(--evl-err-bg); color: var(--evl-err); border-radius: 3px; padding: 6px 9px; margin: 5px 0; max-width: 640px; font-size: 13px; }
    .elAiHint { margin: 5px 0; font-size: 13px; color: var(--evl-muted); }
    .elAiWarnTxt { display: block; color: var(--evl-warn-ink); font-size: 12px; margin: 3px 0; max-width: 760px; }
    .elAiErr { color: var(--evl-err); font-size: 12px; font-weight: bold; margin: 3px 0; }
    #eventLogAdmin [aria-invalid="true"] { border-color: var(--evl-err) !important; outline: 1px solid var(--evl-err); }
    .elAiOk { color: var(--evl-ok); font-weight: bold; }
    .elAiBad { color: var(--evl-err); font-weight: bold; }
    .elAiSub { color: var(--evl-muted); font-size: 12px; font-weight: normal; overflow-wrap: anywhere; }
    .elAiTag { display: inline-block; border-radius: 9px; padding: 0 8px; font-size: 12px; line-height: 18px; border: 1px solid var(--evl-line); background: var(--evl-chip); white-space: nowrap; }
    .elAiTag.local { border-color: var(--evl-ok); color: var(--evl-ok); }
    .elAiTag.cloud { border-color: var(--evl-cloud); color: var(--evl-cloud); }
    .elAiTag.unknown { color: var(--evl-muted); }
    .elAiScroll { overflow-x: auto; max-width: 100%; }
    .elAiTbl { width: 100%; }
    .elAiTbl th { font-size: 12px; color: var(--evl-muted); padding: 5px 8px; border-bottom: 1px solid var(--evl-line); text-align: left; font-weight: normal; white-space: nowrap; }
    .elAiTbl td { padding: 4px 8px; border-bottom: 1px solid var(--evl-line2); vertical-align: top; }
    .elAiTbl tbody tr:hover td { background: var(--evl-hover); }
    .elAiTbl .elNum { text-align: right; white-space: nowrap; }
    .elAiActs { white-space: nowrap; text-align: right; }
    .elAiBtns { margin: 8px 0; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    /* same :not() as the generic button rules above, so these win on specificity */
    #eventLogAdmin button.elPrimary:not(#eventLogAdminNav button) { background: var(--evl-acc); color: var(--evl-acc-ink); border-color: var(--evl-acc); }
    #eventLogAdmin button.elPrimary:not(#eventLogAdminNav button):hover, #eventLogAdmin button.elPrimary:not(#eventLogAdminNav button):active { background: var(--evl-acc); color: var(--evl-acc-ink); border-color: var(--evl-acc); filter: brightness(1.08); }
    .elAiForm { border: 1px solid var(--evl-line); background: var(--evl-alt); border-radius: 4px; padding: 4px 12px 6px 12px; }
    .elAiGrid { display: grid; grid-template-columns: minmax(160px, 230px) minmax(0, 1fr); gap: 8px 14px; align-items: start; }
    .elAiGrid > label, .elAiGrid > .elAiLbl { padding-top: 5px; color: var(--evl-ink); }
    .elAiGrid > div > label { display: inline-block; }
    .elAiRadio { display: block; margin: 2px 0; }
    .elAiLimits label { display: inline-block; margin: 0 14px 4px 0; }
    .elAiLimits input[type=number] { width: 12.5em; max-width: 100%; margin-left: 4px; }
    .elAiGen select { margin-left: 4px; min-width: 12.5em; max-width: 100%; }
    .elAiGen input[type=number], .elAiGen select { font-variant-numeric: tabular-nums; }
    .elAiGen :disabled { opacity: .55; cursor: not-allowed; }
    .elAiGenNote { color: var(--evl-ink); }
    .elAiOffer { border: 1px solid var(--evl-acc); border-left-width: 4px; background: var(--evl-alt); border-radius: 3px; padding: 8px 12px 2px 12px; margin: 8px 0; max-width: 760px; }
    .elAiOffer p { margin: 0 0 4px 0; }
    .elAiOffer #elAiOfferT { font-weight: bold; }
    .elAiUnused { color: var(--evl-muted); font-size: 12px; }
    /* beats the page-wide button rule (#eventLogAdmin button:not(...)) */
    #eventLogAdmin #elAiEpRows button.elAiLinkBtn, #eventLogAdmin #elAiEpRows button.elAiLinkBtn:hover, #eventLogAdmin #elAiEpRows button.elAiLinkBtn:active { background: none; border: 0; border-radius: 0; padding: 0; color: var(--evl-acc); text-decoration: underline; cursor: pointer; font: inherit; transform: none; }
    .elAiTestOut .elAiLine { display: block; }
    .elMidTxt { width: 100%; max-width: 360px; }
    .elAiChecks { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 3px 16px; }
    .elAiFs { border: 1px solid var(--evl-line2); border-radius: 4px; padding: 6px 10px 8px 10px; margin: 0 0 10px 0; max-width: 900px; }
    .elAiFs legend { padding: 0 4px; font-weight: bold; }
    .elAiTestOut { border: 1px solid var(--evl-line); background: var(--evl-bg); border-radius: 3px; padding: 6px 10px; margin: 10px 0 0 0; max-width: 760px; }
    .elAiTestOut ul { list-style: none; margin: 4px 0; padding: 0; }
    .elAiTestOut li { margin: 3px 0; }
    .elAiFilters { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; margin: 4px 0 8px 0; }
    .elAiSaveBar { border-top: 1px solid var(--evl-line); padding-top: 8px; }
    #eventLogAdmin input[type=password], #eventLogAdmin input[type=date] {
      border: 1px solid var(--evl-line); background: var(--evl-input); color: var(--evl-ink);
      border-radius: 3px; padding: 4px 6px; font: inherit; box-sizing: border-box;
    }
    #eventLogAdmin input[type=password]:focus, #eventLogAdmin input[type=date]:focus { outline: 2px solid var(--evl-acc); outline-offset: -1px; }
    #eventLogAdmin input[type=radio] { accent-color: var(--evl-acc); }
    #eventLogAdmin input[type=checkbox]:focus-visible, #eventLogAdmin input[type=radio]:focus-visible { outline: 2px solid var(--evl-acc); outline-offset: 1px; }
    #elAiKeyRemove { margin-top: 4px; }

    /* ---- Assistant behaviour: prompt templates ----
       Locked text reads as a printed sheet (muted paper, dashed edge); unlocked text is an input with a warning-coloured
       rule on the left, so the edit state is visible at a glance on every part. */
    #eventLogAdmin textarea {
      border: 1px solid var(--evl-line); background: var(--evl-input); color: var(--evl-ink);
      border-radius: 3px; padding: 6px 8px; font: inherit; box-sizing: border-box; width: 100%; max-width: 900px; resize: vertical;
    }
    #eventLogAdmin textarea:focus { outline: 2px solid var(--evl-acc); outline-offset: -1px; }
    #eventLogAdmin textarea.elAiMono { font-family: Consolas, "DejaVu Sans Mono", monospace; font-size: 12px; line-height: 1.5; tab-size: 4; }
    #eventLogAdmin textarea[readonly] { background: var(--evl-alt); border-style: dashed; color: var(--evl-ink); }
    #eventLogAdmin textarea.elAiTpl:not([readonly]) { border-left: 4px solid var(--evl-warn-line); padding-left: 8px; }
    .elAiBeh { display: flex; flex-direction: column; gap: 4px; }
    .elAiBeh code { white-space: nowrap; }
    #eventLogAdmin .elAiBadges button.elAiMini:not(#eventLogAdminNav button) { font-size: 12px; line-height: 16px; padding: 0 8px; border-radius: 9px; color: var(--evl-acc); }
    .elAiCount { color: var(--evl-muted); font-size: 12px; max-width: 900px; text-align: right; font-variant-numeric: tabular-nums; }
    .elAiCount.over { color: var(--evl-err); font-weight: bold; }
    .elAiSwitch { display: inline-flex; align-items: center; gap: 6px; font-weight: bold; cursor: pointer; }
    .elAiPartTabs { display: inline-flex; flex-wrap: wrap; align-self: flex-start; border: 1px solid var(--evl-bline); border-radius: 3px; overflow: hidden; background: var(--evl-input); margin: 4px 0 0 0; }
    #eventLogAdmin .elAiPartTabs button:not(#eventLogAdminNav button) { border: 0; border-radius: 0; border-right: 1px solid var(--evl-line2); background: var(--evl-input); color: var(--evl-muted); padding: 4px 12px; }
    #eventLogAdmin .elAiPartTabs button:not(#eventLogAdminNav button):last-child { border-right: 0; }
    #eventLogAdmin .elAiPartTabs button:not(#eventLogAdminNav button):hover { background: var(--evl-hover); color: var(--evl-ink); }
    #eventLogAdmin .elAiPartTabs button[aria-selected="true"]:not(#eventLogAdminNav button) { background: var(--evl-acc); color: var(--evl-acc-ink); font-weight: bold; }
    .elAiDot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--evl-warn-line); margin-left: 6px; vertical-align: middle; }
    .elAiPartTabs button[aria-selected="true"] .elAiDot { background: var(--evl-acc-ink); }
    .elAiPanel { display: flex; flex-direction: column; gap: 4px; padding-top: 6px; }
    .elAiBadges { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; min-height: 20px; }
    .elAiTag.edited { border-color: var(--evl-acc); color: var(--evl-acc); }
    .elAiTag.changed { border-color: var(--evl-warn-line); background: var(--evl-warn-bg); color: var(--evl-warn-ink); white-space: normal; }
    .elAiTag.unsaved { border-style: dashed; color: var(--evl-ink); }
    .elAiPanelFoot { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; justify-content: space-between; max-width: 900px; }
    .elAiFactory { border-top: 1px solid var(--evl-line2); padding-top: 6px; margin-top: 2px; }
    .elAiFactory > span { display: block; font-size: 12px; color: var(--evl-muted); margin-bottom: 3px; }
    /* starter questions: two numbered lists (the number is the button order), each row an input with move/remove */
    .elAiStartCols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 470px), 1fr)); gap: 6px 22px; max-width: 900px; }
    #elAiStartFs { min-width: 0; }   /* a fieldset is at least as wide as its content by default */
    .elAiStartCol h4 { margin: 6px 0 4px 0; font-size: 13px; display: flex; align-items: center; gap: 8px; }
    .elAiStartCol h4 .elAiTag { font-weight: normal; }
    .elAiStartL { margin: 0; padding: 0 0 0 1.9em; }
    .elAiStartL li { margin: 0 0 4px 0; color: var(--evl-muted); font-variant-numeric: tabular-nums; }
    .elAiStartRow > * { vertical-align: middle; }
    .elAiStartRow { white-space: nowrap; }
    #eventLogAdmin input.elAiStartIn { width: calc(100% - 92px); min-width: 120px; color: var(--evl-ink); white-space: normal; }
    #eventLogAdmin button.elAiIconBtn:not(#eventLogAdminNav button) { padding: 3px 5px; margin-left: 3px; line-height: 0; color: var(--evl-muted); }
    #eventLogAdmin button.elAiIconBtn:not(#eventLogAdminNav button):hover:not(:disabled) { color: var(--evl-ink); }
    #eventLogAdmin button.elAiIconBtn.rm:not(#eventLogAdminNav button):hover:not(:disabled) { color: var(--evl-err); border-color: var(--evl-err); }
    .elAiStartNone { list-style: none; margin-left: -1.9em !important; font-size: 12px; }
    .elAiHistCounts { display: inline-block; padding-top: 5px; font-variant-numeric: tabular-nums; }
    #eventLogAdmin button.elAiDangerBtn:not(#eventLogAdminNav button) { color: var(--evl-err); border-color: var(--evl-err); }
    #eventLogAdmin button.elAiDangerBtn:not(#eventLogAdminNav button):hover:not(:disabled) { background: var(--evl-err-bg); border-color: var(--evl-err); }
    .elAiChecksList { list-style: none; margin: 0; padding: 0; max-width: 900px; }
    .elAiChecksList:empty { display: none; }
    .elAiChecksList li { margin: 4px 0; }
    .elAiChecksList li.elAiWarn { max-width: 900px; }
    .elAiLegend { max-width: 900px; margin-top: 4px; }
    .elAiLegend summary { cursor: pointer; color: var(--evl-acc); }
    .elAiLegend summary:focus-visible { outline: 2px solid var(--evl-acc); outline-offset: 1px; }
    .elAiLegend dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 3px 12px; margin: 6px 0; font-size: 13px; }
    .elAiLegend dt { margin: 0; }
    .elAiLegend dd { margin: 0; color: var(--evl-muted); }
    .elAiPrevText { min-height: 220px; }
    @media (max-width: 640px) {
      .elAiLegend dl { grid-template-columns: minmax(0, 1fr); gap: 0; }
      .elAiLegend dd { margin-bottom: 6px; }
      .elAiPartTabs { display: flex; }
      #eventLogAdmin .elAiPartTabs button:not(#eventLogAdminNav button) { flex: 1 1 auto; }
    }
    @media (max-width: 640px) {
      .elAiGrid { grid-template-columns: minmax(0, 1fr); gap: 2px 0; }
      .elAiGrid > label, .elAiGrid > .elAiLbl { padding-top: 8px; font-weight: bold; }
      .elLongTxt, .elMidTxt { max-width: 100%; }
    }
</style>
<body>
<div id="eventLogAdmin">
  <div class=eventLogNavClass id=eventLogAdminNav>
      <button class=eventLogTabActive onclick="return eventLogTab(this, 'elAssignment');">Assignment</button>
      <button onclick="return eventLogTab(this, 'elConfigSets');">Config Sets</button>
      <button onclick="return eventLogTab(this, 'elAssistant');">Assistant</button>
      <!-- button onclick="return eventLogTab(this, 'elPermissions');">Permissions</button -->
  </div>
  <div id="elcontent">
    <div class="eventLogPage" id="elAssignment">
          <div id="elAssignChoice">
            <span>Assign Set:</span>&nbsp;<select name="assignSet" id="elassignSet">
              <option value="">Default</default>
              
            </select>&nbsp;
            <button onclick="return assignSet();">Assign</button>
            <button onclick="return assignSet('_clear');">Clear</button>
          </div>
          <table id="assignTbl">
          <tr id="elMeshes"><th style="text-align: left;">Mesh</th><th></th><th style="text-align: right;">Current Configuration</th></tr>

          <tr id="elNodes"><th style="text-align: left;">Node</th><th>Mesh</th><th style="text-align: right;">Current Configuration</th></tr>
      </table>
    </div>
    <div class="eventLogPage" id="elConfigSets" style="display:none;">
      <select name="configSet" id="elconfigSet" onchange="return changeConfig(this);">
        <option value="">Default</default>
      </select>
      [ <a href="#" onclick="return addNewConfigSet();">+</a> ]
      <div id="editConfig">
          <table>
            <tr><td>Name</td><td><input type="text" id="elname" name="elName" value="" class="elLongTxt"></td></tr>
            <tr><td colspan="2" style="font-weight: bold; text-align:center;">Live Config</td></tr>
            <tr><td>Logs (comma delimited)<br><small>Windows event logs, e.g. Application,System,Security</small></td><td><input type="text" id="elliveLogs" name="liveLogs" class="elLongTxt"></td></tr>
            <tr><td>Categories (Linux)<br><small>journald categories. Nothing selected = no filter. Application is program output (stdout/stderr), usually the noisiest on desktops.</small></td><td>
              <select id="elliveCategoriesMode" name="liveCategoriesMode" class="elSel"><option value="include">Include selected</option><option value="exclude" selected>Exclude selected</option></select> <br>
              <select id="elliveCategories" name="liveCategories[]" multiple class="elMSel">
                <option value="System">System</option>
                <option value="Application">Application</option>
                <option value="Kernel">Kernel</option>
                <option value="Auth">Auth</option>
                <option value="Cron">Cron</option>
                <option value="Daemon">Daemon</option>
                <option value="Audit">Audit</option>
              </select></td>
            </tr>
            <tr><td>Sources<br><small>Comma delimited source / provider names, <code>*</code> matches anything, case-insensitive. Empty = no filter. Example: <code>plasmashell, kwin*</code></small></td><td><select id="elliveSourcesMode" name="liveSourcesMode" class="elSel"><option value="include">Include selected</option><option value="exclude" selected>Exclude selected</option></select> <br><input type="text" id="elliveSources" name="liveSources" class="elLongTxt"></td></tr>
            <tr><td>Default entries per log in the Live view<br><small>Users can pick 25&ndash;500 on the device tab; this is the initial value.</small></td><td><input type="text" id="elliveNum" name="liveNum"></td></tr>
            <tr><td>Entry Types</td><td>
              <select id="elliveEntryTypes" name="liveEntryTypes[]" multiple class="elMSel">
                <option value="0">LogAlways</option>
                <option value="1">Critical</option>
                <option value="2">Error</option>
                <option value="3">Warning</option>
                <option value="4">Info</option>
                <option value="5">Verbose</option>
              </select><td>
            </tr>
            <tr><td colspan="2" style="font-weight: bold; text-align:center;">History Config</td></tr>
            <tr><td>Enabled</td><td><input type="checkbox" id="elhistoryEnabled" name="historyEnabled"></td></tr>
            <tr><td>Logs (comma delimited)<br><small>Windows event logs to collect</small></td><td><input type="text" id="elhistoryLogs" name="historyLogs" class="elLongTxt"></td></tr>
            <tr><td>Categories (Linux)<br><small>journald categories to collect. Nothing selected = no filter.</small></td><td>
              <select id="elhistoryCategoriesMode" name="historyCategoriesMode" class="elSel"><option value="include">Include selected</option><option value="exclude" selected>Exclude selected</option></select> <br>
              <select id="elhistoryCategories" name="historyCategories[]" multiple class="elMSel">
                <option value="System">System</option>
                <option value="Application">Application</option>
                <option value="Kernel">Kernel</option>
                <option value="Auth">Auth</option>
                <option value="Cron">Cron</option>
                <option value="Daemon">Daemon</option>
                <option value="Audit">Audit</option>
              </select></td>
            </tr>
            <tr><td>Entry Types</td><td>
              <select id="elhistoryEntryTypes" name="historyEntryTypes[]" multiple class="elMSel">
                <option value="0">LogAlways</option>
                <option value="1">Critical</option>
                <option value="2">Error</option>
                <option value="3">Warning</option>
                <option value="4">Info</option>
                <option value="5">Verbose</option>
              </select><td>
            </tr>
            <tr><td>Sources<br><small>Comma delimited source / provider names, <code>*</code> matches anything, case-insensitive. Empty = no filter. Example: <code>plasmashell, kwin*</code>. Applied on the server when events arrive, so it works for Windows and Linux alike.</small></td><td><select id="elhistorySourcesMode" name="historySourcesMode" class="elSel"><option value="include">Include selected</option><option value="exclude" selected>Exclude selected</option></select> <br><input type="text" id="elhistorySources" name="historySources" class="elLongTxt"></td></tr>
            <tr><td>Retention (days)<br><small>How long collected events are kept. Server-wide; taken from the Default set.</small></td><td><input type="text" id="elretentionDays" name="retentionDays" value="30"></td></tr>
            <tr id="elaiEndpointRow"><td><label for="elaiEndpointId">Assistant endpoint</label><br><small id="elaiEndpointHelp">The model the Assistant uses for devices with this set. None turns the Assistant off for them. Endpoints are managed on the Assistant tab.</small></td><td><select id="elaiEndpointId" aria-describedby="elaiEndpointHelp"><option value="">None</option></select><span id="elaiEndpointRo" hidden></span></td></tr>
            <tr><td>Alerts<br><small>Raise a MeshCentral device event when incoming events match a rule. Evaluated on the server as events arrive, before the History rules above, so an event you do not store can still alert. Events older than one hour are ignored. The alert appears in the device's Events list.</small></td><td><div id="elalertRules"></div><button onclick="return addAlertRule();">Add alert rule</button></td></tr>
          <tr><td>&nbsp;</td><td><span id="elConfigBtns"><span id="elSaveStatus" class="elSaveStatus" role="status" aria-live="polite"></span> <button id="elSaveBtn" onclick="return saveConfig();">Save</button> <button onclick="return deleteConfig();">Delete</button></span></td></tr>
          </table>
          <input type="hidden" name="configId" id="elid" value="" />
      </div>
      <script type="text/javascript">
        loadConfigSet();
        checkForDefault();
        updateAssignRows();
        updateConfigSetsSelects();
      </script>
    </div>
    <div class="eventLogPage" id="elAssistant" style="display:none;">
      <p id="elAiNotice" class="elAiNote" hidden></p>
      <div id="elAiBody" hidden>
        <p class="elAiNote" role="note"><b>Local or self-hosted models are recommended</b> (for example Ollama, vLLM, LM Studio, llama.cpp or LocalAI): event logs and device data then stay on your network. A cloud model receives the data you allow under <i>Data sent to the model</i> below.</p>

        <section class="elAiSec" aria-labelledby="elAiEpH">
          <h3 id="elAiEpH">Endpoints</h3>
          <p class="elAiHelp">An endpoint is a model server the Assistant talks to. A config set selects one endpoint for its devices (Config Sets tab).</p>
          <div class="elAiScroll">
            <table id="elAiEpTbl" class="elAiTbl" hidden>
              <caption class="elSr">Assistant endpoints</caption>
              <thead><tr><th scope="col">Name</th><th scope="col">Server type</th><th scope="col">Model</th><th scope="col">Location</th><th scope="col">Used by</th><th scope="col">Last test</th><th scope="col"><span class="elSr">Actions</span></th></tr></thead>
              <tbody id="elAiEpRows"></tbody>
            </table>
          </div>
          <p id="elAiEpEmpty" class="elAiHelp">Loading endpoints&hellip;</p>
          <div id="elAiOffer" class="elAiOffer" role="group" aria-labelledby="elAiOfferT" hidden>
            <p id="elAiOfferT"></p>
            <p class="elAiHelp">You can change this later under Config Sets.</p>
            <div class="elAiBtns"><button id="elAiOfferYes" class="elPrimary" onclick="return elAiOfferUse();">Use it for Default</button> <button id="elAiOfferNo" onclick="return elAiOfferDismiss();">Not now</button> <span id="elAiOfferStatus" class="elSaveStatus" role="status" aria-live="polite"></span></div>
          </div>
          <div class="elAiBtns"><button id="elAiAddEp" class="elPrimary" onclick="return elAiOpenForm(null);">Add endpoint</button> <span id="elAiEpStatus" class="elSaveStatus" role="status" aria-live="polite"></span></div>
        </section>

        <section id="elAiEpForm" class="elAiSec elAiForm" aria-labelledby="elAiFormH" hidden>
          <h3 id="elAiFormH">Add endpoint</h3>
          <div class="elAiGrid">
            <label for="elAiType">Server type</label>
            <div><select id="elAiType" aria-describedby="elAiTypeHelp" onchange="elAiTypeChanged();">
                <optgroup label="Self-hosted servers">
                  <option value="ollama">Ollama</option><option value="vllm">vLLM</option><option value="lmstudio">LM Studio</option>
                  <option value="llamacpp">llama.cpp</option><option value="localai">LocalAI</option>
                </optgroup>
                <optgroup label="Other servers and APIs">
                  <option value="custom">Other OpenAI-compatible server</option><option value="responses">OpenAI Responses API</option><option value="anthropic">Anthropic Messages API</option>
                </optgroup>
              </select>
              <small id="elAiTypeHelp" class="elAiHelp">How the MeshCentral server talks to the model. Self-hosted servers come first; pick <i>Other OpenAI-compatible server</i> for gateways such as LiteLLM or Open WebUI.</small></div>

            <label for="elAiName">Name</label>
            <div><input type="text" id="elAiName" class="elLongTxt" maxlength="100" autocomplete="off" aria-required="true"></div>

            <label for="elAiUrl">Address</label>
            <div><input type="text" id="elAiUrl" class="elLongTxt" inputmode="url" spellcheck="false" autocomplete="off" aria-required="true" aria-describedby="elAiUrlHint" oninput="elAiUrlChanged(); elAiModelFacts();">
              <div id="elAiUrlHint" aria-live="polite"></div></div>

            <label for="elAiKey">API key</label>
            <div><input type="password" id="elAiKey" class="elLongTxt" autocomplete="new-password" spellcheck="false" aria-describedby="elAiKeyState elAiKeyHelp" oninput="elAiKeyChanged();">
              <button id="elAiKeyRemove" onclick="return elAiToggleRemoveKey();" hidden>Remove key</button>
              <small id="elAiKeyState" class="elAiHelp"></small>
              <small id="elAiKeyHelp" class="elAiHelp">Only needed if the server asks for one. Stored encrypted on the MeshCentral server and never shown again. Enter <code>env:VAR_NAME</code> to read it from an environment variable of the MeshCentral server instead.</small></div>

            <label for="elAiModel">Model</label>
            <div><input type="text" id="elAiModel" class="elMidTxt" list="elAiModelList" spellcheck="false" autocomplete="off" aria-describedby="elAiModelFacts" oninput="elAiModelFacts();">
              <datalist id="elAiModelList"></datalist>
              <button id="elAiFetchBtn" onclick="return elAiFetchModels();">Fetch models</button>
              <span id="elAiModelsStatus" class="elSaveStatus" role="status" aria-live="polite"></span>
              <div id="elAiModelFacts" class="elAiHelp" aria-live="polite"></div></div>

            <label for="elAiNumCtx" class="elAiOllama" hidden>Ollama context (num_ctx)</label>
            <div class="elAiOllama" hidden><input type="number" id="elAiNumCtx" min="1024" max="4194304" step="1" placeholder="Not set" aria-describedby="elAiNumCtxHelp" oninput="elAiLimitHints();">
              <small id="elAiNumCtxHelp" class="elAiHelp">Ollama's default context can be only 4,096 tokens, too small for event logs. The Assistant sends this size with every request. A larger context needs more memory on the Ollama server.</small></div>

            <span class="elAiLbl" id="elAiToolModeL">How the model reads data</span>
            <div role="radiogroup" aria-labelledby="elAiToolModeL" aria-describedby="elAiToolModeHelp">
              <label class="elAiRadio"><input type="radio" name="elAiToolMode" value="auto" checked> Automatic</label>
              <label class="elAiRadio"><input type="radio" name="elAiToolMode" value="tools"> Tool calls</label>
              <label class="elAiRadio"><input type="radio" name="elAiToolMode" value="summary"> Summary only</label>
              <small id="elAiToolModeHelp" class="elAiHelp">Tool calls: the model asks for the data it needs, step by step; this needs a model that supports tool calls. Summary only: the server prepares one summary of the device and its events and sends it with the question; this works with any model, but answers can only use what is in the summary. Automatic uses tool calls when the model supports them, otherwise summary only.</small></div>

            <span class="elAiLbl">Limits</span>
            <div class="elAiLimits">
              <label>Max output tokens <input type="number" id="elAiMaxOut" min="64" max="128000" step="1" placeholder="2,048 (default)" aria-describedby="elAiCtxHelp"></label>
              <label>Timeout (s) <input type="number" id="elAiTimeout" min="10" max="900" step="1" placeholder="120 (default)" aria-describedby="elAiCtxHelp"></label>
              <label>Context tokens <input type="number" id="elAiCtx" min="1024" max="4194304" step="1" placeholder="Detected when tested" aria-describedby="elAiCtxHelp" oninput="elAiLimitHints();"></label>
              <small id="elAiCtxHelp" class="elAiHelp">Leave empty to use the value shown. Max output is at most half the context. Timeout is per request to the model.</small></div>

            <span class="elAiLbl" id="elAiGenL">Generation</span>
            <div class="elAiLimits elAiGen" role="group" aria-labelledby="elAiGenL">
              <label>Thinking <select id="elAiThinking" aria-describedby="elAiGenHelp elAiGenNote">
                  <option value="">Server default</option><option value="off">Off</option><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option>
                </select></label>
              <label>Temperature <input type="number" id="elAiTemp" min="0" max="2" step="0.05" placeholder="server default" aria-describedby="elAiGenHelp elAiGenNote"></label>
              <label>Top-p <input type="number" id="elAiTopP" min="0" max="1" step="0.01" placeholder="server default" aria-describedby="elAiGenHelp elAiGenNote"></label>
              <label>Top-k <input type="number" id="elAiTopK" min="1" max="1000" step="1" placeholder="server default" aria-describedby="elAiGenHelp elAiGenNote"></label>
              <label>Seed <input type="number" id="elAiSeed" min="0" max="2147483647" step="1" placeholder="server default" aria-describedby="elAiGenHelp elAiGenNote"></label>
              <small id="elAiGenNote" class="elAiHelp elAiGenNote" hidden></small>
              <small id="elAiGenHelp" class="elAiHelp">Leave empty to use the server's default, shown in the field when the server reports it. Only the settings you fill in are sent. Test connection checks that the server accepts them.</small></div>

            <label for="elAiEpExtra">Model-specific instructions</label>
            <div><textarea id="elAiEpExtra" class="elAiMono" rows="3" maxlength="4000" aria-describedby="elAiEpExtraHelp elAiEpExtraCount" placeholder="For example: /no_think"></textarea>
              <div class="elAiCount" id="elAiEpExtraCount"></div>
              <small id="elAiEpExtraHelp" class="elAiHelp">Added for this endpoint only, e.g. switches a model needs.</small></div>

            <span class="elAiLbl">Advanced</span>
            <div><label><input type="checkbox" id="elAiLinkLocal" aria-describedby="elAiLinkLocalHelp" onchange="elAiUrlChanged();"> Allow link-local addresses</label>
              <small id="elAiLinkLocalHelp" class="elAiHelp">Off by default. Link-local and cloud metadata addresses (169.254.x.x, fe80::) are blocked to protect this server. Turn this on only if your model server really uses such an address.</small></div>
          </div>
          <div id="elAiTestOut" class="elAiTestOut" aria-live="polite" hidden></div>
          <div class="elAiBtns">
            <button id="elAiSaveEpBtn" class="elPrimary" onclick="return elAiSaveEndpoint();">Save endpoint</button>
            <button id="elAiTestBtn" onclick="return elAiTest();">Test connection</button>
            <button onclick="return elAiCloseForm();">Cancel</button>
            <span id="elAiFormStatus" class="elSaveStatus" role="status" aria-live="polite"></span>
          </div>
        </section>

        <div id="elAiSettings">
        <section class="elAiSec" aria-labelledby="elAiDataH">
          <h3 id="elAiDataH">Data sent to the model</h3>
          <fieldset class="elAiFs"><legend>Replace before sending</legend>
            <p class="elAiHelp" id="elAiRedactHelp">Always on for endpoints outside your network; for local endpoints it is your choice. Replaced values are restored in the answer. Replacement is best effort.</p>
            <div id="elAiRedact" class="elAiChecks"></div>
          </fieldset>
          <fieldset class="elAiFs"><legend>What the model may read</legend>
            <div id="elAiCats" class="elAiChecks"></div>
          </fieldset>
          <fieldset class="elAiFs"><legend>Before sending to an endpoint outside your network</legend>
            <label class="elAiRadio"><input type="radio" name="elAiPreview" value="every"> Show the preview every time</label>
            <label class="elAiRadio"><input type="radio" name="elAiPreview" value="once"> Show it once per user and endpoint</label>
            <label class="elAiRadio"><input type="radio" name="elAiPreview" value="never"> Do not show it</label>
          </fieldset>
        </section>

        <section class="elAiSec" aria-labelledby="elAiBehH">
          <h3 id="elAiBehH">Assistant behaviour</h3>
          <fieldset class="elAiFs elAiBeh"><legend><label for="elAiExtra">Additional instructions</label></legend>
            <small id="elAiExtraHelp" class="elAiHelp">Added after the built-in instructions for every question. Use it for context (your environment, language, tone, preferred tools). It cannot switch off the safety rules.</small>
            <textarea id="elAiExtra" rows="4" maxlength="4000" spellcheck="true" aria-describedby="elAiExtraHelp elAiExtraCount" placeholder="For example: Our clients run Windows 11 with Microsoft Intune. Answer in German."></textarea>
            <div class="elAiCount" id="elAiExtraCount"></div>
          </fieldset>

          <fieldset class="elAiFs elAiBeh" id="elAiPromptFs"><legend>System prompt</legend>
            <p class="elAiHelp" id="elAiPromptHelp">The built-in instructions the model gets before every question: shared base instructions, then the part for the kind of question. Values in <code>&#123;&#123;&hellip;&#125;&#125;</code> are filled in for each request.</p>
            <div class="elAiBtns">
              <label class="elAiSwitch"><input type="checkbox" role="switch" id="elAiPromptEdit" aria-describedby="elAiPromptWarn"> Edit the system prompt</label>
            </div>
            <p id="elAiPromptWarn" class="elAiWarn" hidden>Changes affect every answer. The trust rules protect against instructions hidden in event logs; the output blocks are what the Diagnosis, Explain and follow-up views read.</p>
            <div id="elAiPartTabs" class="elAiPartTabs" role="tablist" aria-label="System prompt parts"></div>
            <div id="elAiPartPanels"></div>
            <ul id="elAiPromptChecks" class="elAiChecksList" aria-live="polite"></ul>
            <div class="elAiBtns"><button id="elAiResetAll" disabled>Reset all to factory defaults</button></div>
            <details class="elAiLegend">
              <summary>Placeholders</summary>
              <p class="elAiHelp">A line that holds only a placeholder is left out when the placeholder is empty. Unknown placeholders are sent as they are.</p>
              <dl id="elAiPhList"></dl>
            </details>
          </fieldset>

          <fieldset class="elAiFs elAiBeh" id="elAiStartFs"><legend>Starter questions</legend>
            <p class="elAiHelp" id="elAiStartHelp">The example questions an empty Ask panel offers, one list per device type. Devices whose system is not known get the Windows list. Up to 12 questions of at most 200 characters each; the order here is the order of the buttons.</p>
            <div class="elAiStartCols">
              <section class="elAiStartCol" aria-labelledby="elAiStartH_windows"><h4 id="elAiStartH_windows">Windows devices <span id="elAiStartTag_windows"></span></h4>
                <ol id="elAiStart_windows" class="elAiStartL"></ol>
                <div class="elAiBtns"><button type="button" id="elAiStartAdd_windows">Add a question</button><button type="button" id="elAiStartReset_windows">Reset to factory defaults</button><span class="elAiCount" id="elAiStartCount_windows"></span></div>
              </section>
              <section class="elAiStartCol" aria-labelledby="elAiStartH_linux"><h4 id="elAiStartH_linux">Linux devices <span id="elAiStartTag_linux"></span></h4>
                <ol id="elAiStart_linux" class="elAiStartL"></ol>
                <div class="elAiBtns"><button type="button" id="elAiStartAdd_linux">Add a question</button><button type="button" id="elAiStartReset_linux">Reset to factory defaults</button><span class="elAiCount" id="elAiStartCount_linux"></span></div>
              </section>
            </div>
            <span id="elAiStartSay" class="elSr" role="status" aria-live="polite"></span>
          </fieldset>

          <fieldset class="elAiFs elAiBeh"><legend>Full prompt</legend>
            <p class="elAiHelp" id="elAiPrevHelp">What the model receives as instructions, built from the text on this page including unsaved changes. Sample values: device SAMPLE-PC, every tool available, personal values replaced.</p>
            <div class="elAiFilters">
              <label>Question type <select id="elAiPrevMode"><option value="ask">Ask</option><option value="explain">Explain</option><option value="diagnose">Diagnosis</option></select></label>
              <label>Device <select id="elAiPrevOs"><option value="windows">Windows</option><option value="linux">Linux</option></select></label>
              <label>Endpoint <select id="elAiPrevEp"><option value="">None</option></select></label>
              <button id="elAiPrevBtn">Show the full prompt</button>
              <span id="elAiPrevStatus" class="elSaveStatus" role="status" aria-live="polite"></span>
            </div>
            <div id="elAiPrevOut" hidden>
              <ul id="elAiPrevWarn" class="elAiChecksList"></ul>
              <label for="elAiPrevText" class="elSr">Full prompt</label>
              <textarea id="elAiPrevText" class="elAiMono elAiPrevText" rows="18" readonly aria-describedby="elAiPrevMeta"></textarea>
              <div class="elAiCount" id="elAiPrevMeta"></div>
            </div>
          </fieldset>
        </section>

        <section class="elAiSec" aria-labelledby="elAiAccessH">
          <h3 id="elAiAccessH">Access</h3>
          <p class="elAiHelp">To use the Assistant on a device, a user needs the plugin permission <b>Event Log: Assistant</b> (My Server &rarr; Plugins &rarr; Event Log &rarr; Permissions) and the Details right on the device. The device's config set must select an endpoint (Config Sets tab &rarr; Assistant endpoint).</p>
          <div class="elAiGrid">
            <span class="elAiLbl">Assistant</span>
            <div><label><input type="checkbox" id="elAiEnabled"> Turn the Assistant on</label></div>
            <label for="elAiQuotaQ">Questions per user per day</label>
            <div><input type="number" id="elAiQuotaQ" min="0" max="100000" step="1" aria-describedby="elAiQuotaHelp"></div>
            <label for="elAiQuotaT">Tokens per user per day</label>
            <div><input type="number" id="elAiQuotaT" min="0" max="1000000000" step="1" aria-describedby="elAiQuotaHelp">
              <small id="elAiQuotaHelp" class="elAiHelp">0 means no limit.</small></div>
            <label for="elAiRounds">Max steps per answer</label>
            <div><input type="number" id="elAiRounds" min="1" max="50" step="1" aria-describedby="elAiRoundsHelp">
              <small id="elAiRoundsHelp" class="elAiHelp">A step is one round trip to the model; in each step it may request up to 4 data lookups (1&ndash;50).</small></div>
            <label for="elAiCalls">Tool calls per answer</label>
            <div><input type="number" id="elAiCalls" min="1" max="200" step="1" aria-describedby="elAiCallsHelp">
              <small id="elAiCallsHelp" class="elAiHelp">The individual data lookups across all steps of one answer (1&ndash;200; empty: automatic).</small></div>
            <label for="elAiSentKB">Data per answer (KB)</label>
            <div><input type="number" id="elAiSentKB" min="16" max="8192" step="1" aria-describedby="elAiSentKBHelp">
              <small id="elAiSentKBHelp" class="elAiHelp">New data sent to the model for one answer: the question and the lookup results (16&ndash;8192; empty: automatic).</small></div>
          </div>
        </section>

        <section class="elAiSec" aria-labelledby="elAiSavedH">
          <h3 id="elAiSavedH">Saved results</h3>
          <p class="elAiHelp">Ask chats, the last diagnosis and explanations are saved per user and device, so they are still there after a reload. Each user sees only their own; a chat can be continued later. They hold what the user saw, including device data such as event messages, names and addresses in clear text, in the plugin's database.</p>
          <div class="elAiGrid">
            <span class="elAiLbl">Saving</span>
            <div><label><input type="checkbox" id="elAiHistOn"> Save chats, diagnoses and explanations</label></div>
            <label for="elAiHistDays">Keep chats, diagnoses and explanations for (days)</label>
            <div><input type="number" id="elAiHistDays" min="1" max="3650" step="1" aria-describedby="elAiHistDaysHelp">
              <small id="elAiHistDaysHelp" class="elAiHelp">Counted from the last change (1&ndash;3650). Older items are deleted automatically.</small></div>
            <span class="elAiLbl">Stored now</span>
            <div><span id="elAiHistCounts" class="elAiHistCounts" aria-live="polite">&hellip;</span>
              <div class="elAiBtns"><button type="button" id="elAiHistPurge" class="elAiDangerBtn">Delete all saved results</button> <span id="elAiHistStatus" class="elSaveStatus" role="status" aria-live="polite"></span></div>
              <small class="elAiHelp">Deletes the saved chats, diagnoses and explanations of all users on all devices. The audit log is kept.</small></div>
          </div>
        </section>

        <section class="elAiSec" aria-labelledby="elAiAuditH">
          <h3 id="elAiAuditH">Audit log</h3>
          <p class="elAiHelp">Every answer is logged: who asked, about which device, which endpoint, how much was sent and how many values were replaced.</p>
          <div class="elAiGrid">
            <label for="elAiRetention">Keep entries for (days)</label>
            <div><input type="number" id="elAiRetention" min="1" max="3650" step="1"></div>
            <span class="elAiLbl">Transcripts</span>
            <div><label><input type="checkbox" id="elAiTranscripts" aria-describedby="elAiTranscriptsHelp"> Also store full questions and answers</label>
              <small id="elAiTranscriptsHelp" class="elAiWarnTxt">They are stored as they were sent to the model, with personal values replaced, and anyone who can read the database can read them.</small></div>
          </div>
        </section>
        </div>
        <div class="elAiBtns elAiSaveBar"><button id="elAiSetBtn" class="elPrimary" onclick="return elAiSaveSettings();">Save settings</button> <span id="elAiSetStatus" class="elSaveStatus" role="status" aria-live="polite"></span></div>

        <section class="elAiSec" aria-labelledby="elAiReqH">
          <h3 id="elAiReqH">Requests</h3>
          <div class="elAiFilters">
            <label>From <input type="date" id="elAiAudFrom"></label>
            <label>To <input type="date" id="elAiAudTo"></label>
            <button onclick="return elAiAuditFilter();">Show</button>
            <a id="elAiCsv" href="pluginadmin.ashx?pin=eventlog&amp;ai=auditcsv" target="_blank" rel="noopener noreferrer">Export CSV</a>
          </div>
          <div class="elAiScroll">
            <table id="elAiAuditTbl" class="elAiTbl">
              <caption class="elSr">Assistant requests</caption>
              <thead><tr><th scope="col">Time</th><th scope="col">User</th><th scope="col">Device</th><th scope="col">Endpoint</th><th scope="col" class="elNum">Steps</th><th scope="col" class="elNum">Sent</th><th scope="col" class="elNum">Replaced</th><th scope="col" class="elNum">Tokens</th><th scope="col">Result</th></tr></thead>
              <tbody id="elAiAuditRows"></tbody>
            </table>
          </div>
          <div class="elAiBtns">
            <button id="elAiNewer" onclick="return elAiAuditPage(-1);" disabled>Newer</button>
            <button id="elAiOlder" onclick="return elAiAuditPage(1);" disabled>Older</button>
            <span id="elAiAuditInfo" class="elAiHelp"></span>
            <span id="elAiAuditStatus" class="elSaveStatus" role="status" aria-live="polite"></span>
          </div>
        </section>
      </div>
    </div>
    
    <!-- h2>Configuration Editor</h2>
    <div id="elconfigEditor"></div-->
    
    <!-- div id="elPermissions" class="eventLogPage" style="display:none;">
      Permissions here...
    </div -->
  </div>
</div>
<script type="text/javascript">elAiInit();</script>
<script type="text/javascript">
  // follow MeshCentral's light / night theme (this page is embedded in MeshCentral's own page)
  (function () {
    function sync() {
      try { document.body.classList.toggle('night', parent.document.body.classList.contains('night')); }
      catch (e) { document.body.classList.toggle('night', !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)); }
    }
    sync();
    try { new MutationObserver(sync).observe(parent.document.body, { attributes: true, attributeFilter: ['class'] }); } catch (e) { }
  })();
</script>
</body>
</html>